+
+function dlopen(aFileName:PAnsiChar;aFlags:TpvInt32):TpvPointer; cdecl; external PasVulkanCrashReportLibDL name 'dlopen';
+function dlsym(aHandle:TpvPointer;aName:PAnsiChar):TpvPointer; cdecl; external PasVulkanCrashReportLibDL name 'dlsym';
 
