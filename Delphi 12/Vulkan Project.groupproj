<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{FE136DA0-0C05-4F5F-8910-14F2CD2D4243}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="..\Samples\SimpleTest\SimpleTest.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="SimpleTest">
        <MSBuild Projects="..\Samples\SimpleTest\SimpleTest.dproj"/>
    </Target>
    <Target Name="SimpleTest:Clean">
        <MSBuild Projects="..\Samples\SimpleTest\SimpleTest.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SimpleTest:Make">
        <MSBuild Projects="..\Samples\SimpleTest\SimpleTest.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="SimpleTest"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="SimpleTest:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="SimpleTest:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
    <ItemGroup Condition="'$(BuildGroup)'=='Vulkan Test Debug Build'">
        <BuildGroupProject Include="..\Samples\SimpleTest\SimpleTest.dproj">
            <ProjectGuid>{9547A1FF-1889-4BF6-BFE4-520037EDBDC7}</ProjectGuid>
            <Configurations>Debug</Configurations>
            <Platforms>Win32</Platforms>
            <Enabled>False</Enabled>
        </BuildGroupProject>
    </ItemGroup>
    <ItemGroup Condition="'$(BuildGroup)'=='Vulkan Test Build Group'">
        <BuildGroupProject Include="..\Samples\SimpleTest\SimpleTest.dproj">
            <ProjectGuid>{9547A1FF-1889-4BF6-BFE4-520037EDBDC7}</ProjectGuid>
            <Configurations>Debug</Configurations>
            <Platforms>Win32</Platforms>
            <Enabled>False</Enabled>
        </BuildGroupProject>
    </ItemGroup>
</Project>
