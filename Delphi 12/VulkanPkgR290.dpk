package VulkanPkgR290;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Datavis Vulkan runtime package'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl;

contains
  Vulkan in 'Vulkan.pas',
  PasVulkan.Types in 'PasVulkan.Types.pas',
  PasVulkan.Math in 'PasVulkan.Math.pas',
  PasVulkan.Math.Double in 'PasVulkan.Math.Double.pas',
  PasVulkan.Collections in 'PasVulkan.Collections.pas',
  PasVulkan.Utils in 'PasVulkan.Utils.pas',
  PasVulkan.CrashReport in 'PasVulkan.CrashReport.pas',
  PasVulkan.SymbolTable in 'PasVulkan.SymbolTable.pas',
  PasVulkan.Streams in 'PasVulkan.Streams.pas',
  PasVulkan.CPU.Info in 'PasVulkan.CPU.Info.pas',
  PasVulkan.HighResolutionTimer in 'PasVulkan.HighResolutionTimer.pas',
  PasVulkan.Compression.Deflate in 'PasVulkan.Compression.Deflate.pas',
  PasVulkan.Image.BMP in 'PasVulkan.Image.BMP.pas',
  PasVulkan.Image.JPEG in 'PasVulkan.Image.JPEG.pas',
  PasVulkan.Image.PNG in 'PasVulkan.Image.PNG.pas',
  PasVulkan.Image.QOI in 'PasVulkan.Image.QOI.pas',
  PasVulkan.Image.TGA in 'PasVulkan.Image.TGA.pas',
  PasVulkan.Image.Utils in 'PasVulkan.Image.Utils.pas',
  PasVulkan.NVIDIA.AfterMath in 'PasVulkan.NVIDIA.AfterMath.pas',
  PasVulkan.Framework in 'PasVulkan.Framework.pas',
  PasMP in 'PasMP.pas',
  PasJSON in 'PasJSON.pas',
  PUCU in 'PUCU.pas',
  PasDblStrUtils in 'PasDblStrUtils.pas',
  Vulkan_Components in '..\RunTime_Src\Vulkan_Components.pas',
  Vulkan_Components_Lookups in '..\RunTime_Src\Vulkan_Components_Lookups.pas',
  Vulkan_Components_Descriptors in '..\RunTime_Src\Vulkan_Components_Descriptors.pas',
  Vulkan_Assert in '..\RunTime_Src\Vulkan_Assert.pas',
  Vulkan_WorldAxes in '..\RunTime_Src\Vulkan_WorldAxes.pas',
  Vulkan_Components_Scene_Renderer in '..\RunTime_Src\Vulkan_Components_Scene_Renderer.pas',
  Vulkan_PixelInfo in '..\RunTime_Src\Vulkan_PixelInfo.pas',
  Vulkan_Components_Camera in '..\RunTime_Src\Vulkan_Components_Camera.pas',
  Vulkan_HUD in '..\RunTime_Src\Vulkan_HUD.pas',
  Vulkan_Components_DataStore in '..\RunTime_Src\Vulkan_Components_DataStore.pas',
  Vulkan_Components_Nodes in '..\RunTime_Src\Vulkan_Components_Nodes.pas',
  Vulkan_Components_PointerValidation in '..\RunTime_Src\Vulkan_Components_PointerValidation.pas',
  Vulkan_CriticalSection in '..\RunTime_Src\Vulkan_CriticalSection.pas',
  Vulkan_Components_ShaderCompiler in '..\RunTime_Src\Vulkan_Components_ShaderCompiler.pas',
  Vulkan_Components_Compute in '..\RunTime_Src\Vulkan_Components_Compute.pas',
  Vulkan_SceneLoaders in '..\RunTime_Src\Vulkan_SceneLoaders.pas',
  Vulkan_Components_Light in '..\RunTime_Src\Vulkan_Components_Light.pas',
  Vulkan_Components_TextureInspector in '..\RunTime_Src\Vulkan_Components_TextureInspector.pas';

end.



