/* Component palette icons - compiled into the package by
     {$R '..\Design_Src\VulkanPkg_DesignIcons.res' '..\Design_Src\VulkanPkg_DesignIcons.rc'}
   in the .dpk.  The IDE finds a component's icon by a BITMAP resource named
   after its class in upper case; 24x24, lower-left pixel = transparent. */

TVGINSTANCE              BITMAP "TVGINSTANCE.bmp"
TVGPHYSICALDEVICE        BITMAP "TVGPHYSICALDEVICE.bmp"
TVGLINKER                BITMAP "TVGLINKER.bmp"
DATAVIS                  BITMAP "Datavis.bmp"
