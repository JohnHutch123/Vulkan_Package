unit Vulkan_Components_ShaderBuilder;

interface


Uses

  {$IFDEF FASTMM5}
  FastMM5,
  {$ENDIF}
  System.SysUtils,
  System.IOUtils,
  System.Generics.Collections,   //MUST STAY HERE
  System.Generics.Defaults,
  System.Classes,                //MUST STAY HERE
  System.Math,
  System.SyncObjs,
  {$IFDEF TIMINGON}
  System.Diagnostics,
  {$ENDIF}
  typinfo,
  Vulkan,
  PasVulkan.Types,
  PasVulkan.Math,
  PasVulkan.Collections,
  PasVulkan.Framework,
  Vulkan_Assert,
  Vulkan_Components_Lookups,
  Vulkan_Components,
  Vulkan_Components_Descriptors;

TYpe

//???????????????????????????????????????????????????????????????????????????????
//  TvgShaderBuilder � INTERFACE SECTION
//  Add these declarations inside the "type" block of Vulkan_Components.pas,
//  after the existing TvgRenderEngine forward declaration and before the
//  TvgInstance class body.
//
//  The builder lives in the same unit so it has direct access to all
//  protected fields (fGraphicPipes, fVertShader, fResourceUse, etc.) without
//  needing accessor properties.  The comment tag [FULL/INFRA/MAIN] on each
//  helper matches the confidence table established in the design session.
//???????????????????????????????????????????????????????????????????????????????

  // ?? Forward declaration (add to the existing forward-decl block) ?????????
  TvgShaderBuilder = Class;

  // ?? Compiler callback type ????????????????????????????????????????????????
  // Wire this to glslangValidator or shaderc to compile on the fly.
  // aGLSL   : complete GLSL source text
  // aStage  : 'vert' | 'geom' | 'frag'
  // aSpvOut : desired .spv path (taken from ShaderOutputPath + pipeline name)
  // Return True on success; False causes CompileAll to return False.
  TvgShaderCompileCallback = function(const aGLSL, aStage, aSpvOut: String): Boolean of object;

  // ?? Per-stage output record ???????????????????????????????????????????????
  TvgShaderStageResult = record
    GLSL        : String;   // full GLSL source
    SpvPath     : String;   // where CompileAll will write the .spv
    IsGenerated : Boolean;  // False when the stage is not in UseShaders
  end;

  TvgShaderBuildResult = record
    Vert : TvgShaderStageResult;
    Geom : TvgShaderStageResult;
    Frag : TvgShaderStageResult;
  end;

  //???????????????????????????????????????????????????????????????????????????
  TvgShaderBuilder = Class(TvgBaseComponent)
  //
  //  Links to:  TvgGraphicPipeline  (required � drives everything)
  //             TvgRenderEngine     (optional � auto-resolved via Pipeline.Renderer)
  //             TvgSubPass          (optional � auto-resolved via Pipeline.SubPass)
  //             TvgBaseScene        (optional � reserved for future scene-level queries)
  //             TvgBaseObjectStore  (optional � reserved for per-store overrides)
  //
  //  Typical use:
  //    Builder.Pipeline := MyGraphicPipeline;
  //    Result := Builder.BuildAll;
  //    Builder.SaveSources(Result);   // writes .vert/.geom/.frag text files
  //    Builder.CompileAll(Result);    // calls OnCompile for each active stage
  //
  //???????????????????????????????????????????????????????????????????????????
  Private
    // ?? linked components ??????????????????????????????????????????????????
    fPipeline    : TvgGraphicPipeline;
    fScene       : TvgBaseScene;
    fObjectStore : TvgBaseObjectStore;   // non-owning reference

    // ?? settings ???????????????????????????????????????????????????????????
    fOutputPath      : String;    // folder for .vert/.geom/.frag/.spv files
    fIncludeComments : Boolean;   // embed section comments in GLSL output
    fOnCompile       : TvgShaderCompileCallback;

    fLastVertexOutCount  : Integer;   // set by BuildVertexShader, checked by BuildAll
    fLastFragmentInCount : Integer;   // set by BuildFragmentShader, checked by BuildAll

    // ?? property setters ???????????????????????????????????????????????????
    procedure SetPipeline   (const Value: TvgGraphicPipeline);
    procedure SetScene      (const Value: TvgBaseScene);
    procedure SetObjectStore(const Value: TvgBaseObjectStore);
    procedure SetOutputPath (const Value: String);

  Protected
    procedure Notification(AComponent: TComponent; Operation: TOperation); override;
    Function SetDisabled:Boolean; override;
    Function SetEnabled:Boolean; override;

    //?????????????????????????????????????????????????????????????????????????
    //  Internal section builders � called by the three public Build methods
    //?????????????????????????????????????????????????????????????????????????

    // [FULL]  #version + required extensions
    function  SB_Header(aUseDouble, aGeomStage, aDescriptorIndexing: Boolean): String;

    // [FULL]  layout(constant_id=N) const <type> NAME = default;
    //         Reads directly from a TvgShaderModule.SpecialConst collection.
    function  SB_SpecialisationConstants(aModule: TvgShaderModule): String;

    // [FULL]  SET 0 � GlobalUBO (viewProject matrix) + optional ObjectID image
    //         Controlled by RU_GLOBAL in GP.ResourceUse and Renderer.SelectON.
    function  SB_GlobalSet(aRE: TvgBaseRenderEngine;
                           const aStageTag: String): String;
    function  SB_DescriptorSet(aDS: TvgDescriptorSet; aSetIndex: TvkUint32;
                               const aStageTag, aTitle: String): String;

    // [INFRA] SET 1 � GraphicPipeRes descriptors
    //         Delegates to TvgDescriptor.GetShaderDescriptorStringTemplate_*.
    //         TvgDescriptor_Texture ? FULL.  UBO/SSBO ? stub until overridden.
    //         aStageTag: 'Vertex' | 'Geometry' | 'Fragment'
    function  SB_PipeSet(aGP: TvgGraphicPipeline; aSetIndex: TvkUint32;
                         const aStageTag: String): String;

    // [FULL]  layout(location=N) in <glsltype> <name>;
    //         One line per TvgVertexAttributeDesc using GetShaderHeadTemplate.
    function  SB_VertexInputs(aGP: TvgGraphicPipeline): String;

    // [INFRA] layout(location=N) out <type> <name>;
    //         Skips position (? gl_Position).  Uses AttType semantics.
    function  SB_VertexOutputs(aGP: TvgGraphicPipeline;
                                out aOutCount: Integer): String;

    // [INFRA] Matching layout(location=N) in for the fragment stage.
    function  SB_FragmentInputs(aGP: TvgGraphicPipeline; out aInCount: Integer): String;

    // [FULL]  layout(location=N) out vec4 outColor[N]
    //         + layout(location=M) out uvec2 outObjectID  when ObjectIDON.
    function  SB_FragmentOutputs(aGP: TvgGraphicPipeline;
                                  aSP: TvgSubPass): String;

    // [FULL]  layout(triangles/points/lines) in/out  � from InputAssembly.Topology
    function  SB_GeomLayout(aGP: TvgGraphicPipeline): String;

    // [INFRA] Geometry interpolant interface:
    //         layout(loc=N) in  T nameIn[];
    //         layout(loc=N) out T name;
    function  SB_GeomInterface(aGP: TvgGraphicPipeline): String;

    function  ModuleUsesDouble(aModule: TvgShaderModule): Boolean;
    function  ModuleHasSpecialConstant(aModule: TvgShaderModule;
                                       const aName: String): Boolean;
    function  RequiresDescriptorIndexing(aGP: TvgGraphicPipeline): Boolean;
    function  GlobalUsesDouble(aGP: TvgGraphicPipeline): Boolean;
    function  ViewProjectionExpression(aGP: TvgGraphicPipeline): String;
    function  ObjectStoreSetIndex(aGP: TvgGraphicPipeline): TvkUint32;
    function  ModelSetIndex(aGP: TvgGraphicPipeline): TvkUint32;
    function  SB_ModelSet(aGP: TvgGraphicPipeline;
                          const aStageTag: String): String;

    //?????????????????????????????????????????????????????????????????????????
    //  main() builders
    //?????????????????????????????????????????????????????????????????????????

    // [MAIN]  Compilable skeleton; writes gl_Position, passes interpolants,
    //         handles POINT_SIZE_ON and USE_DOUBLE branches.
    function  SB_VertexMain(aGP: TvgGraphicPipeline): String;

    // [MAIN]  Compilable placeholder; samples first texture if present,
    //         writes outObjectID branch when ObjectIDON.
    function  SB_FragmentMain(aGP: TvgGraphicPipeline; aSP: TvgSubPass): String;

    // [FULL]  Complete pass-through derived entirely from topology + attributes.
    function  SB_GeometryMain(aGP: TvgGraphicPipeline): String;

    //?????????????????????????????????????????????????????????????????????????
    //  Low-level type-mapping helpers (all deterministic)
    //?????????????????????????????????????????????????????????????????????????
    function  VkFmtToGLSL(aFmt: TVkFormat): String;
    function  SpecTypeToGLSL(aST: TvgSpecialisationType): String;
    function  TopologyGeomIn(aT: TvgPrimitiveTopology): String;
    function  TopologyGeomOut(aT: TvgPrimitiveTopology): String;
    function  TopologyMaxVerts(aT: TvgPrimitiveTopology): Integer;
    function  AttIsPosition(aAT: TvgAttributeType): Boolean;
    function  AttIsVertexOnly(aAT: TvgAttributeType): Boolean;
    function  AttGLSLType(aAT: TvgAttributeType; aFmt: TVkFormat): String;
    function  AttInterpolationQualifier(aFmt: TVkFormat): String;
    function  AttInterpolantName(aAT: TvgAttributeType; aLoc: Integer): String;

    // Formatting helpers
    function  Cmt(const aText: String): String;  // emits "// aText\n" or ''
    function  Sep(const aTitle: String): String; // emits section separator or ''

    // Resolve working pipeline (falls back to fPipeline)
    function  ResolvedGP(aGP: TvgGraphicPipeline): TvgGraphicPipeline;
    function  ResolvedSP(aGP: TvgGraphicPipeline; aSP: TvgSubPass): TvgSubPass;
    function  ResolvedObjectStore(aGP: TvgGraphicPipeline): TvgBaseObjectStore;

  Public
    constructor Create(AOwner: TComponent); override;
    destructor  Destroy; override;

    //?????????????????????????????????????????????????????????????????????????
    //  Primary API
    //?????????????????????????????????????????????????????????????????????????

    // Build all active stages in one call.
    // Pass nil to use the assigned Pipeline / SubPass.
    function BuildAll(aGP: TvgGraphicPipeline = nil;
                      aSP: TvgSubPass         = nil): TvgShaderBuildResult;

    // Individual stage builders.
    function BuildVertexShader  (aGP: TvgGraphicPipeline = nil): String;
    function BuildGeometryShader(aGP: TvgGraphicPipeline = nil): String;
    function BuildFragmentShader(aGP: TvgGraphicPipeline = nil;
                                 aSP: TvgSubPass         = nil): String;

    // Write .vert / .geom / .frag text files into OutputPath.
    procedure SaveSources(const aResult: TvgShaderBuildResult);

    // Write sources then invoke OnCompile for each active stage.
    // Returns True only when all active stages succeeded.
    function  CompileAll(aGP: TvgGraphicPipeline = nil;
                         aSP: TvgSubPass         = nil): Boolean;

  Published
    // Required � the pipeline whose state is the source of truth.
    property Pipeline    : TvgGraphicPipeline read fPipeline    write SetPipeline;

    // Optional � for future scene-level queries (camera, lights, etc.)
    property Scene       : TvgBaseScene       read fScene       write SetScene;

    // Optional � for per-store attribute overrides (future extension)
    property ObjectStore : TvgBaseObjectStore read fObjectStore write SetObjectStore
                           stored False;

    // Folder where .vert/.geom/.frag/.spv files are written.
    // Defaults to the global ShaderFolderPath variable.
    property OutputPath  : String read fOutputPath  write SetOutputPath;

    // When True (default), GLSL output contains // section comments.
    property IncludeComments : Boolean read fIncludeComments write fIncludeComments
                               default True;

    // Attach glslangValidator / shaderc wrapper here for on-the-fly compilation.
    property OnCompile   : TvgShaderCompileCallback read fOnCompile write fOnCompile;

  End;


implementation


//???????????????????????????????????????????????????????????????????????????????
//  TvgShaderBuilder � IMPLEMENTATION SECTION
//  Paste the entire block below into the implementation section of
//  Vulkan_Components.pas, after the existing TvgBaseObjectStore implementation.
//???????????????????????????????????????????????????????????????????????????????

{ TvgShaderBuilder }

//???????????????????????????????????????????????????????????????????????????????
//  Lifecycle
//???????????????????????????????????????????????????????????????????????????????

constructor TvgShaderBuilder.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  fIncludeComments := True;
  fOutputPath      := ShaderFolderPath;  // global var from Vulkan_Components
end;

destructor TvgShaderBuilder.Destroy;
begin
  // FreeNotification handles nil-out via Notification
  inherited Destroy;
end;

function TvgShaderBuilder.ModuleUsesDouble(aModule: TvgShaderModule): Boolean;
begin
  Result := ModuleHasSpecialConstant(aModule, 'USE_DOUBLE');
end;

function TvgShaderBuilder.ModuleHasSpecialConstant(aModule: TvgShaderModule;
  const aName: String): Boolean;
var
  I: Integer;
begin
  Result := False;
  if not Assigned(aModule) then exit;
  for I := 0 to aModule.SpecialConst.Count - 1 do
    if Assigned(aModule.SpecialConst.Items[I]) and
       SameText(aModule.SpecialConst.Items[I].Name, aName) then
    begin
      Result := True;
      exit;
    end;
end;

Function TvgShaderBuilder.SetDisabled:Boolean;
begin
  Result := Inherited;
end;

Function TvgShaderBuilder.SetEnabled:Boolean;
begin
  Result := Inherited;
end;

procedure TvgShaderBuilder.Notification(AComponent: TComponent;
                                         Operation: TOperation);
begin
  inherited Notification(AComponent, Operation);
  if Operation = opRemove then
  begin
    if AComponent = fPipeline then fPipeline := nil;

    if Assigned(fScene) and (fScene is TComponent) and
       (TComponent(fScene) = AComponent) then fScene := nil;

    if Assigned(fObjectStore) and (fObjectStore is TComponent) and
       (TComponent(fObjectStore) = AComponent) then fObjectStore := nil;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  Property setters
//???????????????????????????????????????????????????????????????????????????????

procedure TvgShaderBuilder.SetPipeline(const Value: TvgGraphicPipeline);
begin
  if fPipeline = Value then exit;
  if Assigned(fPipeline) then fPipeline.RemoveFreeNotification(Self);
  fPipeline := Value;
  if Assigned(fPipeline) then fPipeline.FreeNotification(Self);
end;

procedure TvgShaderBuilder.SetScene(const Value: TvgBaseScene);
begin
  if fScene = Value then exit;
  if Assigned(fScene) and (fScene is TComponent) then
    TComponent(fScene).RemoveFreeNotification(Self);
  fScene := Value;
  if Assigned(fScene) and (fScene is TComponent) then
    TComponent(fScene).FreeNotification(Self);
end;

procedure TvgShaderBuilder.SetObjectStore(const Value: TvgBaseObjectStore);
begin
  // ObjectStore is not a TComponent � just hold the reference
 // fObjectStore := Value;
  if fObjectStore = Value then exit;
  if Assigned(fObjectStore) and (fObjectStore is TComponent) then
    TComponent(fObjectStore).RemoveFreeNotification(Self);
  fObjectStore := Value;
  if Assigned(fObjectStore) and (fObjectStore is TComponent) then
    TComponent(fObjectStore).FreeNotification(Self);
end;

procedure TvgShaderBuilder.SetOutputPath(const Value: String);
begin
  fOutputPath := Value;
end;

function TvgShaderBuilder.RequiresDescriptorIndexing(aGP: TvgGraphicPipeline): Boolean;
var
 OS: TvgBaseObjectStore;
begin
 Result := False;
 if not Assigned(aGP) then exit;

 if Assigned(aGP.Renderer) and Assigned(aGP.Renderer.GlobalRes) and
    aGP.Renderer.GlobalRes.UsesDescriptorIndexing then
   Exit(True);

 OS := ResolvedObjectStore(aGP);
 if Assigned(OS) then
 begin
   if Assigned(OS.ObjectStoreRes) and
      OS.ObjectStoreRes.UsesDescriptorIndexing then
     Exit(True);
   if (RU_MODEL in OS.ResourceUse) and Assigned(OS.ObjectModelRes) then
     Result := OS.ObjectModelRes.UsesDescriptorIndexing;
 end;
end;
//???????????????????????????????????????????????????????????????????????????????
//  Resolve helpers
//???????????????????????????????????????????????????????????????????????????????

function TvgShaderBuilder.ResolvedGP(aGP: TvgGraphicPipeline): TvgGraphicPipeline;
begin
  if Assigned(aGP) then Result := aGP else Result := fPipeline;
end;

function TvgShaderBuilder.ResolvedSP(aGP: TvgGraphicPipeline;
                                      aSP: TvgSubPass): TvgSubPass;
begin
  if Assigned(aSP) then
    Result := aSP
  else if Assigned(aGP) then
    Result := aGP.SubPass
  else
    Result := nil;
end;

function TvgShaderBuilder.ResolvedObjectStore(
  aGP: TvgGraphicPipeline): TvgBaseObjectStore;
begin
  if Assigned(aGP) and Assigned(aGP.ObjectStore) then
    Result := aGP.ObjectStore
  else
    Result := fObjectStore;
end;

function TvgShaderBuilder.ObjectStoreSetIndex(
  aGP: TvgGraphicPipeline): TvkUint32;
begin
  Result := 0;
  if Assigned(aGP) and Assigned(aGP.Renderer) and
     Assigned(aGP.Renderer.GlobalRes) and
     (aGP.Renderer.GlobalRes.Descriptors.Count > 0) then
    Result := 1;
end;

function TvgShaderBuilder.ModelSetIndex(
  aGP: TvgGraphicPipeline): TvkUint32;
var
  OS: TvgBaseObjectStore;
begin
  Result := ObjectStoreSetIndex(aGP);
  OS := ResolvedObjectStore(aGP);
  if Assigned(OS) and Assigned(OS.ObjectStoreRes) and
     (OS.ObjectStoreRes.Descriptors.Count > 0) then
    Inc(Result);
end;

function TvgShaderBuilder.SB_ModelSet(aGP: TvgGraphicPipeline;
  const aStageTag: String): String;
var
  OS: TvgBaseObjectStore;
begin
  Result := '';
  OS := ResolvedObjectStore(aGP);
  if not Assigned(OS) or not (RU_MODEL in OS.ResourceUse) then
    Exit;

  Result := SB_DescriptorSet(OS.ObjectModelRes, ModelSetIndex(aGP),
    aStageTag, 'Per-object model resources');
end;

function TvgShaderBuilder.GlobalUsesDouble(
  aGP: TvgGraphicPipeline): Boolean;
var
  I: Integer;
  DI: TvgDescriptorItem;
begin
  Result := False;
  if not Assigned(aGP) or not Assigned(aGP.Renderer) or
     not Assigned(aGP.Renderer.GlobalRes) then
    Exit;

  for I := 0 to aGP.Renderer.GlobalRes.Descriptors.Count - 1 do
  begin
    DI := aGP.Renderer.GlobalRes.Descriptors.Items[I];
    if Assigned(DI) and Assigned(DI.Descriptor) and
       (DI.Descriptor.ResourceType = RT_VIEWPROJECTMAT) and
       (DI.Descriptor is TvgDescriptorArray_UBO_4x4MatrixD) then
      Exit(True);
  end;
end;

function TvgShaderBuilder.ViewProjectionExpression(
  aGP: TvgGraphicPipeline): String;
var
  I: Integer;
  DI: TvgDescriptorItem;
begin
  Result := '';
  if not Assigned(aGP) or not Assigned(aGP.Renderer) or
     not Assigned(aGP.Renderer.GlobalRes) then
    Exit;

  for I := 0 to aGP.Renderer.GlobalRes.Descriptors.Count - 1 do
  begin
    DI := aGP.Renderer.GlobalRes.Descriptors.Items[I];
    if Assigned(DI) and Assigned(DI.Descriptor) and
       (DI.Descriptor.ResourceType = RT_VIEWPROJECTMAT) then
    begin
      Result := DI.Name + '.value';
      Exit;
    end;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  Formatting helpers
//???????????????????????????????????????????????????????????????????????????????

function TvgShaderBuilder.Cmt(const aText: String): String;
begin
  if fIncludeComments then Result := '// ' + aText + sLineBreak
  else                     Result := '';
end;

function TvgShaderBuilder.Sep(const aTitle: String): String;
begin
  if fIncludeComments then
    Result := sLineBreak + '// --- ' + aTitle + ' ---' + sLineBreak
  else
    Result := sLineBreak;
end;

//???????????????????????????????????????????????????????????????????????????????
//  TYPE-MAPPING HELPERS
//???????????????????????????????????????????????????????????????????????????????

//???????????????????????????????????????????????????????????????????????????????
//  VkFormat ? GLSL type string
//  Covers every format realistically used for vertex attributes.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.VkFmtToGLSL(aFmt: TVkFormat): String;
begin
  case aFmt of
    // 32-bit float (most common vertex attributes)
    VK_FORMAT_R32_SFLOAT          : Result := 'float';
    VK_FORMAT_R32G32_SFLOAT       : Result := 'vec2';
    VK_FORMAT_R32G32B32_SFLOAT    : Result := 'vec3';
    VK_FORMAT_R32G32B32A32_SFLOAT : Result := 'vec4';
    // 64-bit double (requires GL_EXT_shader_explicit_arithmetic_types_float64)
    VK_FORMAT_R64_SFLOAT          : Result := 'double';
    VK_FORMAT_R64G64_SFLOAT       : Result := 'dvec2';
    VK_FORMAT_R64G64B64_SFLOAT    : Result := 'dvec3';
    VK_FORMAT_R64G64B64A64_SFLOAT : Result := 'dvec4';
    // 16-bit half (promoted in shader to float/vec)
    VK_FORMAT_R16_SFLOAT          : Result := 'float';
    VK_FORMAT_R16G16_SFLOAT       : Result := 'vec2';
    VK_FORMAT_R16G16B16_SFLOAT    : Result := 'vec3';
    VK_FORMAT_R16G16B16A16_SFLOAT : Result := 'vec4';
    // 32-bit signed int
    VK_FORMAT_R32_SINT            : Result := 'int';
    VK_FORMAT_R32G32_SINT         : Result := 'ivec2';
    VK_FORMAT_R32G32B32_SINT      : Result := 'ivec3';
    VK_FORMAT_R32G32B32A32_SINT   : Result := 'ivec4';
    // 32-bit unsigned int
    VK_FORMAT_R32_UINT            : Result := 'uint';
    VK_FORMAT_R32G32_UINT         : Result := 'uvec2';
    VK_FORMAT_R32G32B32_UINT      : Result := 'uvec3';
    VK_FORMAT_R32G32B32A32_UINT   : Result := 'uvec4';
    // 8-bit normalised colour (expanded to vec4 in shader)
    VK_FORMAT_R8G8B8A8_UNORM,
    VK_FORMAT_B8G8R8A8_UNORM      : Result := 'vec4';
  else
    raise EArgumentException.CreateFmt(
      'TvgShaderBuilder does not support vertex format %d', [Ord(aFmt)]);
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  TvgSpecialisationType ? GLSL type keyword
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SpecTypeToGLSL(aST: TvgSpecialisationType): String;
begin
  case aST of
    TS_BOOLEAN : Result := 'bool';
    TS_INTEGER : Result := 'int';
    TS_SINGLE  : Result := 'float';
  else
    Result := 'int /*FIXME SpecType*/';
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  TvgPrimitiveTopology ? geometry shader keywords
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.TopologyGeomIn(aT: TvgPrimitiveTopology): String;
begin
  case aT of
    POINT_LIST                    : Result := 'points';
    LINE_LIST, LINE_STRIP         : Result := 'lines';
  else {TRIANGLE_LIST, STRIP etc} Result := 'triangles';
  end;
end;

function TvgShaderBuilder.TopologyGeomOut(aT: TvgPrimitiveTopology): String;
begin
  case aT of
    POINT_LIST                    : Result := 'points';
    LINE_LIST, LINE_STRIP         : Result := 'line_strip';
  else                              Result := 'triangle_strip';
  end;
end;

function TvgShaderBuilder.TopologyMaxVerts(aT: TvgPrimitiveTopology): Integer;
begin
  case aT of
    POINT_LIST                    : Result := 1;
    LINE_LIST, LINE_STRIP         : Result := 2;
  else                              Result := 3;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  TvgAttributeType helpers
//
//  TvgAttributeType is declared in Vulkan_Components_Lookups which is not
//  uploaded here.  The integer ordinals below use the standard enum ordering
//  that matches the CI_xxx constant assignments seen in BuildAGraphicPipeline.
//  Replace every Ord(aAT) comparison with the named constant once available:
//     Ord 0 ? AT_POSITION   (feeds gl_Position, NOT an interpolant)
//     Ord 1 ? AT_NORMAL
//     Ord 2 ? AT_COLOR
//     Ord 3 ? AT_TEXCOORD
//     Ord 4 ? AT_TANGENT
//     Ord 5 ? AT_BITANGENT
//     Ord 6 ? AT_INSTANCE
//     Ord 7 ? AT_OBJECTID
//???????????????????????????????????????????????????????????????????????????????

function TvgShaderBuilder.AttIsPosition(aAT: TvgAttributeType): Boolean;
begin
  Result := (aAT = AT_POSITION);
end;

function TvgShaderBuilder.AttIsVertexOnly(aAT: TvgAttributeType): Boolean;
begin
  Result := aAT in [AT_POSITION, AT_MATRIX, AT_TRANSFORM];
end;

function TvgShaderBuilder.AttGLSLType(aAT: TvgAttributeType;
                                       aFmt: TVkFormat): String;
begin
  Result := VkFmtToGLSL(aFmt);
end;

function TvgShaderBuilder.AttInterpolationQualifier(aFmt: TVkFormat): String;
begin
  case aFmt of
    VK_FORMAT_R32_SINT,
    VK_FORMAT_R32G32_SINT,
    VK_FORMAT_R32G32B32_SINT,
    VK_FORMAT_R32G32B32A32_SINT,
    VK_FORMAT_R32_UINT,
    VK_FORMAT_R32G32_UINT,
    VK_FORMAT_R32G32B32_UINT,
    VK_FORMAT_R32G32B32A32_UINT:
      Result := 'flat ';
  else
    Result := '';
  end;
end;

// Generates a descriptive interpolant variable name from semantic
function TvgShaderBuilder.AttInterpolantName(aAT: TvgAttributeType;
                                              aLoc: Integer): String;
var
  BaseName: String;
begin
  case aAT of
    AT_COLOR:     BaseName := 'fragColor';
    AT_TEXTURE:   BaseName := 'fragTexCoord';
    AT_NORMAL:    BaseName := 'fragNormal';
    AT_TANGENT:   BaseName := 'fragTangent';
    AT_BITANGENT: BaseName := 'fragBitangent';
    AT_VECTOR:    BaseName := 'fragVector';
    AT_MATINDEX:  BaseName := 'fragMaterialIndex';
    AT_OBJID:     BaseName := 'fragObjectID';
    AT_INDEX:     BaseName := 'fragIndex';
  else  BaseName := 'fragAttr';
  end;
  // aLoc is the running interpolant-location counter � unique per non-position
  // attribute and identical across SB_VertexOutputs/SB_FragmentInputs/
  // SB_GeomInterface/SB_VertexMain/SB_GeometryMain � so suffixing guarantees
  // distinct identifiers even with two attributes of the same semantic type
  // (e.g. two TEXCOORD channels), and doubles as a readable location tag.
  Result := Format('%s%d', [BaseName, aLoc]);
end;

//???????????????????????????????????????????????????????????????????????????????
//  SECTION BUILDERS
//???????????????????????????????????????????????????????????????????????????????

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  #version and extension block
//???????????????????????????????????????????????????????????????????????????????

function TvgShaderBuilder.SB_Header(aUseDouble, aGeomStage,
                                     aDescriptorIndexing: Boolean): String;
var
  SB: TStringBuilder;
begin
  SB := TStringBuilder.Create;
  try
    SB.AppendLine('#version 450');
    SB.AppendLine('#extension GL_ARB_separate_shader_objects : enable');

    if aDescriptorIndexing then
      SB.AppendLine('#extension GL_EXT_nonuniform_qualifier : enable');

    if aUseDouble then
    begin
      SB.AppendLine('#extension GL_EXT_shader_explicit_arithmetic_types_float64 : enable');
      SB.AppendLine('#extension GL_ARB_gpu_shader_fp64 : enable');
    end;

    if aGeomStage then
      SB.AppendLine('#extension GL_ARB_geometry_shader4 : enable');

    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  Specialisation constants from a TvgShaderModule
//  Reads: ConstantID, SpecType (? GLSL type), SpecTValue (? default literal),
//         Name (? GLSL identifier).
//  The SpecialConst collection is already populated by BuildAGraphicPipeline.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_SpecialisationConstants(aModule: TvgShaderModule): String;
var
  SB       : TStringBuilder;
  I        : Integer;
  SC       : TvgShaderSpecialisationItem;
  GLSLType : String;
  Default  : String;
begin
  Result := '';
  if not Assigned(aModule) then exit;
  if aModule.SpecialConst.Count = 0 then exit;

  SB := TStringBuilder.Create;
  try
    SB.Append(Sep('Specialisation constants'));

    for I := 0 to aModule.SpecialConst.Count - 1 do
    begin
      SC := aModule.SpecialConst.Items[I];
      if not Assigned(SC) then continue;

      GLSLType := SpecTypeToGLSL(SC.SpecType);

      // Convert the stored Pascal string to a valid GLSL literal
      case SC.SpecType of
        TS_BOOLEAN :
          if SameText(SC.SpecTValue, 'True') or SameText(SC.SpecTValue, 'T') then
            Default := 'true'
          else
            Default := 'false';
        TS_INTEGER : Default := SC.SpecTValue;
        TS_SINGLE  :
          begin
            Default := SC.SpecTValue;
            // GLSL requires a decimal point for float literals
            if Pos('.', Default) = 0 then Default := Default + '.0';
          end;
      else
        Default := SC.SpecTValue;
      end;

      SB.AppendLine(Format('layout(constant_id = %d) const %s %s = %s;',
                           [SC.ConstantID, GLSLType, SC.Name, Default]));
    end;

    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  SET 0 � global resources
//
//  Binding 0 : GlobalUBO  (viewProject mat4) � always when RU_GLOBAL
//  Binding 1 : objectIDImage (rg32ui storage) � only when Renderer.SelectON
//
//  The actual set index is 0 because BindPipelineDescriptors binds GlobalRes
//  first (SN starts at 0) and GraphicPipeRes second.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_GlobalSet(aRE: TvgBaseRenderEngine;
  const aStageTag: String): String;
begin
  Result := '';
  if not Assigned(aRE) or not Assigned(aRE.GlobalRes) then
    Exit;

  Result := SB_DescriptorSet(aRE.GlobalRes, 0, aStageTag,
    'Global resources');
end;

function TvgShaderBuilder.SB_DescriptorSet(aDS: TvgDescriptorSet;
  aSetIndex: TvkUint32; const aStageTag, aTitle: String): String;
var
  SB: TStringBuilder;
  DI: TvgDescriptorItem;
  D: TvgDescriptorArray;
  Line: String;
  I: Integer;
  StageFlag: TVkShaderStageFlags;
begin
  Result := '';
  if not Assigned(aDS) or (aDS.Descriptors.Count = 0) then
    Exit;

  if SameText(aStageTag, 'Vertex') then
    StageFlag := TVkShaderStageFlags(VK_SHADER_STAGE_VERTEX_BIT)
  else if SameText(aStageTag, 'Geometry') then
    StageFlag := TVkShaderStageFlags(VK_SHADER_STAGE_GEOMETRY_BIT)
  else
    StageFlag := TVkShaderStageFlags(VK_SHADER_STAGE_FRAGMENT_BIT);

  SB := TStringBuilder.Create;
  try
    SB.Append(Sep(Format('SET %d - %s', [aSetIndex, aTitle])));

    for I := 0 to aDS.Descriptors.Count - 1 do
    begin
      DI := aDS.Descriptors.Items[I];
      if not Assigned(DI) or not Assigned(DI.Descriptor) then
        Continue;

      D := DI.Descriptor;
      if (D.StageFlags <> 0) and ((D.StageFlags and StageFlag) = 0) then
        Continue;

      if SameText(aTitle, 'Global resources') and
         SameText(DI.Name, GlobalObjectIDDescriptor) and
         (D is TvgDescriptorArray_StorageImage) then
      begin
        SB.Append(Cmt('Storage Image for storage of ObjectID'));
        SB.Append(Cmt(Format('Global descriptor SET = %d and Binding = %d',
          [aSetIndex, D.Binding])));
      end;

      if SameText(aStageTag, 'Vertex') then
        Line := D.GetShaderDescriptorStringTemplate_Vertex(aSetIndex, D.Binding)
      else if SameText(aStageTag, 'Geometry') then
        Line := D.GetShaderDescriptorStringTemplate_Geometry(aSetIndex, D.Binding)
      else
        Line := D.GetShaderDescriptorStringTemplate_Fragment(aSetIndex, D.Binding);

      if Line = '' then
        raise EArgumentException.CreateFmt(
          '%s cannot generate a %s shader declaration',
          [D.ClassName, aStageTag]);

      if Pos('%s', Line) > 0 then
        Line := StringReplace(Line, '%s', DI.Name, [rfReplaceAll]);

      SB.Append(TrimRight(Line));
      SB.AppendLine('');
    end;

    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [INFRA]  SET 1 � GraphicPipeRes descriptor bindings
//
//  Iterates GP.GraphicPipeRes.Descriptors and calls each TvgDescriptor's
//  GetShaderDescriptorStringTemplate_<Stage>(set, binding) virtual.
//
//  TvgDescriptor_Texture   ? FULL (returns "layout(set=S,binding=B) uniform
//                              sampler2D %s" which we format with DI.Name)
//  TvgDescriptor_UBO       ? stub '' until override adds GetShaderDescriptor*
//  TvgDescriptor_SSBO      ? stub '' until override adds GetShaderDescriptor*
//  TvgDescriptor_StorageImage ? stub '' until override
//
//  For every stub we emit a commented skeleton with the correct set/binding
//  numbers so the developer can fill it in immediately.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_PipeSet(aGP: TvgGraphicPipeline;
                                      aSetIndex: TvkUint32;
                                      const aStageTag: String): String;
var
  DS: TvgDescriptorSet;
  OS: TvgBaseObjectStore;
begin
  Result := '';
  if not Assigned(aGP) then exit;
  OS := ResolvedObjectStore(aGP);
  if not Assigned(OS) then
    Exit;

  DS := OS.ObjectStoreRes;
  Result := SB_DescriptorSet(DS, aSetIndex, aStageTag,
    'Object-store resources');
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  Vertex attribute input declarations
//  Uses TvgVertexAttributeDesc.GetShaderHeadTemplate which already produces
//  the correct "layout(location = N) in <type> <name>" string.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_VertexInputs(aGP: TvgGraphicPipeline): String;
var
  SB: TStringBuilder;
  I: Integer;
  A: TvgVertexAttributeDesc;
  OS: TvgBaseObjectStore;
  StoreHeader: String;
  MatrixDeclared: Boolean;
begin
  Result := '';
  if not Assigned(aGP) then exit;
  if aGP.VertexInput.Attributes.Count = 0 then exit;

  SB := TStringBuilder.Create;
  try
    SB.Append(Sep('Per-vertex inputs'));

    OS := ResolvedObjectStore(aGP);
    if Assigned(OS) then
      StoreHeader := OS.WriteGLSLHeader
    else
      StoreHeader := '';

    if StoreHeader <> '' then
    begin
      SB.Append(StoreHeader);
      SB.AppendLine('');
      Result := SB.ToString;
      Exit;
    end;

    MatrixDeclared := False;
    for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
    begin
      A := aGP.VertexInput.Attributes.Items[I];
      if not Assigned(A) then continue;

      if A.AttType = AT_MATRIX then
      begin
        if not MatrixDeclared then
        begin
          SB.AppendLine(Format('layout(location = %d) in mat4 %s;',
            [A.Location, A.Name]));
          MatrixDeclared := True;
        end;
        Continue;
      end;

      SB.AppendLine(Format('layout(location = %d) in %s %s;',
        [A.Location, VkFmtToGLSL(TVkFormat(Ord(A.AttFormat))), A.Name]));
    end;

    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [INFRA]  Vertex output interpolants
//  Position attributes are skipped (they write to gl_Position in main).
//  aOutCount receives the number of out variables emitted so that
//  SB_FragmentInputs and SB_GeomInterface can produce matching declarations.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_VertexOutputs(aGP: TvgGraphicPipeline;
                                             out aOutCount: Integer): String;
var
  SB      : TStringBuilder;
  I       : Integer;
  A       : TvgVertexAttributeDesc;
  GLSLTyp : String;
  VarName : String;
  Loc     : Integer;
begin
  Result   := '';
  aOutCount := 0;
  if not Assigned(aGP) then exit;

  SB  := TStringBuilder.Create;
  Loc := 0;
  try
    SB.Append(Sep('Vertex ? fragment interpolants (out)'));

    for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
    begin
      A := aGP.VertexInput.Attributes.Items[I];
      if not Assigned(A) then continue;
      if AttIsVertexOnly(A.AttType) then continue;

      GLSLTyp := AttGLSLType(A.AttType, TVkFormat(Ord(A.AttFormat)));
      VarName  := AttInterpolantName(A.AttType, Loc);

      SB.AppendLine(Format('layout(location = %d) %sout %s %s;',
                           [Loc,
                            AttInterpolationQualifier(TVkFormat(Ord(A.AttFormat))),
                            GLSLTyp, VarName]));
      Inc(Loc);
    end;

    if Loc = 0 then
    begin
      SB.Append(Cmt('No interpolants derived from attributes.'));
      SB.Append(Cmt('Add layout(location=N) out declarations here if needed.'));
    end;

    aOutCount := Loc;
    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [INFRA]  Fragment inputs � exact mirror of vertex outputs
//???????????????????????????????????????????????????????????????????????????????

function TvgShaderBuilder.SB_FragmentInputs(aGP: TvgGraphicPipeline;
                                             out aInCount: Integer): String;
var
  SB      : TStringBuilder;
  I       : Integer;
  A       : TvgVertexAttributeDesc;
  GLSLTyp : String;
  VarName : String;
  Loc     : Integer;
begin
  Result   := '';
  aInCount := 0;
  if not Assigned(aGP) then exit;

  SB  := TStringBuilder.Create;
  Loc := 0;
  try
    SB.Append(Sep('Fragment inputs (interpolated from vertex stage)'));

    for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
    begin
      A := aGP.VertexInput.Attributes.Items[I];
      if not Assigned(A) then continue;
      if AttIsVertexOnly(A.AttType) then continue;

      GLSLTyp := AttGLSLType(A.AttType, TVkFormat(Ord(A.AttFormat)));
      VarName  := AttInterpolantName(A.AttType, Loc);

      SB.AppendLine(Format('layout(location = %d) %sin %s %s;',
                           [Loc,
                            AttInterpolationQualifier(TVkFormat(Ord(A.AttFormat))),
                            GLSLTyp, VarName]));
      Inc(Loc);
    end;

    if Loc = 0 then
      SB.Append(Cmt('No interpolated inputs. Add layout(location=N) in here.'));

    aInCount := Loc;
    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  Fragment color outputs
//  Number of vec4 outputs = SP.ColorAttachments.Count + SP.ResolveAttachment.Count
//  ObjectID is written to the global storage image from main().
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_FragmentOutputs(aGP: TvgGraphicPipeline;
                                               aSP: TvgSubPass): String;
var
  SB       : TStringBuilder;
  ColCount : Integer;
  Loc      : Integer;
  I        : Integer;
begin
  SB := TStringBuilder.Create;
  try
    SB.Append(Sep('Fragment outputs'));

    // Count color outputs from SubPass attachment collections
    ColCount := 1;  // safe minimum � one output always exists

    if Assigned(aSP) then
    begin
      ColCount := aSP.ColorAttachments.Count;
      // Resolve attachments are resolved automatically by the driver during
      // the subpass � the fragment shader never writes to them directly, so
      // they must NOT add extra output locations.
      if ColCount < 1 then ColCount := 1;
    end;

    Loc := 0;
    for I := 0 to ColCount - 1 do
    begin
      if I = 0 then
        SB.AppendLine(Format('layout(location = %d) out vec4 outColor;', [Loc]))
      else
        SB.AppendLine(Format('layout(location = %d) out vec4 outColor%d;', [Loc, I]));
      Inc(Loc);
    end;

    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  Geometry shader primitive-type declarations
//  Fully derived from InputAssembly.Topology.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_GeomLayout(aGP: TvgGraphicPipeline): String;
var
  SB   : TStringBuilder;
  Topo : TvgPrimitiveTopology;
begin
  Result := '';
  if not Assigned(aGP) then exit;

  SB   := TStringBuilder.Create;
  Topo := aGP.InputAssembly.Topology;
  try
    SB.Append(Sep('Geometry shader primitive declarations (derived from topology)'));
    SB.AppendLine(Format('layout(%s) in;', [TopologyGeomIn(Topo)]));
    SB.AppendLine(Format('layout(%s, max_vertices = %d) out;',
                         [TopologyGeomOut(Topo), TopologyMaxVerts(Topo)]));
    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [INFRA]  Geometry shader interpolant interface
//  Inputs from vertex are arrays: layout(loc=N) in T nameIn[];
//  Outputs to fragment are scalars: layout(loc=N) out T name;
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_GeomInterface(aGP: TvgGraphicPipeline): String;
var
  SB      : TStringBuilder;
  I       : Integer;
  A       : TvgVertexAttributeDesc;
  Typ     : String;
  Nam     : String;
  Loc     : Integer;
begin
  Result := '';
  if not Assigned(aGP) then exit;

  SB  := TStringBuilder.Create;
  Loc := 0;
  try
    SB.Append(Sep('Interpolant interface (in[] from vertex, out to fragment)'));

    for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
    begin
      A := aGP.VertexInput.Attributes.Items[I];
      if not Assigned(A) then continue;
      if AttIsVertexOnly(A.AttType) then continue;

      Typ := AttGLSLType(A.AttType, TVkFormat(Ord(A.AttFormat)));
      Nam := AttInterpolantName(A.AttType, Loc);

      SB.AppendLine(Format('layout(location = %d) %sin %s %sIn[];',
                           [Loc,
                            AttInterpolationQualifier(TVkFormat(Ord(A.AttFormat))),
                            Typ, Nam]));
      SB.AppendLine(Format('layout(location = %d) %sout %s %s;',
                           [Loc,
                            AttInterpolationQualifier(TVkFormat(Ord(A.AttFormat))),
                            Typ, Nam]));
      Inc(Loc);
    end;

    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  main() BUILDERS
//???????????????????????????????????????????????????????????????????????????????

//???????????????????????????????????????????????????????????????????????????????
//  [MAIN]  Vertex main()
//
//  Deterministic parts (generated from state):
//    � gl_Position = globalUBO.viewProject * vec4(<position_attr>, 1.0)
//    � Pass-through assignments for every non-position interpolant
//    � gl_PointSize branch guarded by the POINT_SIZE_ON spec constant
//    � USE_DOUBLE branch with dvec4 cast
//
//  Stub parts (require application logic):
//    � The model-space transform (currently identity / viewProject only)
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_VertexMain(aGP: TvgGraphicPipeline): String;
var
  SB       : TStringBuilder;
  I        : Integer;
  A        : TvgVertexAttributeDesc;
  PosName  : String;
  VarName  : String;
  Loc      : Integer;
  UsePoints: Boolean;
  OS       : TvgBaseObjectStore;
  PositionExpr: String;
  ViewProjectExpr: String;
  PositionFound: Boolean;
begin
  SB        := TStringBuilder.Create;
  PosName   := 'inPosition'; // fallback if no AT_POSITION attribute found
  UsePoints := False;
  PositionFound := False;
  Loc       := 0;

  if Assigned(aGP) then
  begin

    UsePoints := (aGP.InputAssembly.Topology = POINT_LIST);
    // Detect USE_DOUBLE from spec constants

    // Find the position attribute name
    for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
    begin
      A := aGP.VertexInput.Attributes.Items[I];
      if Assigned(A) and AttIsPosition(A.AttType) then
      begin
        PosName := A.Name;
        PositionFound := True;
        break;
      end;
    end;
  end;

  try
    if not PositionFound then
      raise EArgumentException.Create(
        'TvgShaderBuilder requires one AT_POSITION vertex attribute');

    OS := ResolvedObjectStore(aGP);
    if Assigned(OS) then
      PositionExpr := OS.GetShaderVertexPositionExpression(PosName)
    else
      PositionExpr := 'vec4(' + PosName + ', 1.0)';
    ViewProjectExpr := ViewProjectionExpression(aGP);

    SB.AppendLine('void main()');
    SB.AppendLine('{');

    if ViewProjectExpr <> '' then
    begin
      if GlobalUsesDouble(aGP) then
        SB.AppendLine('    gl_Position = vec4(' + ViewProjectExpr +
          ' * dvec4(' + PositionExpr + '));')
      else
        SB.AppendLine('    gl_Position = ' + ViewProjectExpr +
          ' * ' + PositionExpr + ';');
    end
    else
      SB.AppendLine('    gl_Position = ' + PositionExpr + ';');

    //?? interpolant pass-through ?????????????????????????????????????????????
    if Assigned(aGP) and (aGP.VertexInput.Attributes.Count > 0) then
    begin
      SB.AppendLine('');
      SB.Append('    ' + Cmt('Pass-through interpolants'));

      for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
      begin
        A := aGP.VertexInput.Attributes.Items[I];
        if not Assigned(A) then continue;
        if AttIsVertexOnly(A.AttType) then continue;

        VarName := AttInterpolantName(A.AttType, Loc);
        SB.AppendLine(Format('    %s = %s;', [VarName, A.Name]));
        Inc(Loc);
      end;
    end;

    //?? point size ???????????????????????????????????????????????????????????
    if UsePoints then
    begin
      SB.AppendLine('');
      if ModuleHasSpecialConstant(aGP.VertexS, 'POINT_SIZE_ON') then
      begin
        SB.AppendLine('    if (POINT_SIZE_ON)');
        SB.AppendLine('        gl_PointSize = 4.0;');
      end
      else
        SB.AppendLine('    gl_PointSize = 4.0;');
    end;

    SB.AppendLine('}');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [MAIN]  Fragment main()
//
//  Deterministic parts:
//    � Texture sample when a TvgDescriptor_Texture is present in GraphicPipeRes
//    � Multi-render-target zero-fill for extra color outputs
//    � ObjectID write branch when GP.ObjectIDON
//
//  Stub parts:
//    � Actual lighting / shading calculation
//
//  Outputs magenta (1,0,1,1) as a visible "not implemented" signal when
//  no texture is present.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_FragmentMain(aGP: TvgGraphicPipeline;
                                          aSP: TvgSubPass): String;
var
  SB          : TStringBuilder;
  I           : Integer;
  DI          : TvgDescriptorItem;
  SamplerName : String;
  ColCount    : Integer;
  HasTexture  : Boolean;
  TexCoordName: String;
  ColorName   : String;
  ObjectIDName: String;
  ObjectIDBufferName: String;
  Loc         : Integer;
  A           : TvgVertexAttributeDesc;
  OS          : TvgBaseObjectStore;
  ColorExpression: String;
begin
  SB          := TStringBuilder.Create;
  SamplerName := '';
  HasTexture  := False;
  TexCoordName := '';
  ColorName := '';
  ObjectIDName := '';
  ObjectIDBufferName := '';
  OS := ResolvedObjectStore(aGP);

  if Assigned(aGP) and Assigned(aGP.Renderer) and
     Assigned(aGP.Renderer.GlobalRes) then
    for I := 0 to aGP.Renderer.GlobalRes.Descriptors.Count - 1 do
    begin
      DI := aGP.Renderer.GlobalRes.Descriptors.Items[I];
      if Assigned(DI) and
         SameText(DI.Name, GlobalObjectIDDescriptor) and
         (DI.Descriptor is TvgDescriptorArray_StorageImage) and
         ((DI.Descriptor.StageFlags = 0) or
          ((DI.Descriptor.StageFlags and
            TVkShaderStageFlags(VK_SHADER_STAGE_FRAGMENT_BIT)) <> 0)) then
      begin
        ObjectIDBufferName := DI.Name;
        Break;
      end;
    end;

  if Assigned(OS) and (RU_OBJECTSTORE in OS.ResourceUse) and
     Assigned(OS.ObjectStoreRes) and
     (OS.ObjectStoreRes.Descriptors.Count > 0) then
  begin
    for I := 0 to OS.ObjectStoreRes.Descriptors.Count - 1 do
    begin
      DI := OS.ObjectStoreRes.Descriptors.Items[I];
      if Assigned(DI) and
         (DI.Descriptor is TvgDescriptorArray_Texture) and
         ((DI.Descriptor.StageFlags = 0) or
          ((DI.Descriptor.StageFlags and
            TVkShaderStageFlags(VK_SHADER_STAGE_FRAGMENT_BIT)) <> 0)) then
      begin
        SamplerName := DI.Name;
        if DI.Descriptor.BindingMode <> vgdbmSingle then
          SamplerName := SamplerName + '[0]';
        HasTexture  := True;
        break;
      end;
    end;
  end;

  ColCount := 1;
  if Assigned(aSP) then
  begin
    ColCount := aSP.ColorAttachments.Count;
    if ColCount < 1 then ColCount := 1;
  end;

  Loc := 0;
  if Assigned(aGP) then
    for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
    begin
      A := aGP.VertexInput.Attributes.Items[I];
      if not Assigned(A) or AttIsVertexOnly(A.AttType) then
        Continue;

      if (A.AttType = AT_TEXTURE) and (TexCoordName = '') then
        TexCoordName := AttInterpolantName(A.AttType, Loc);
      if (A.AttType = AT_COLOR) and (ColorName = '') then
        ColorName := AttInterpolantName(A.AttType, Loc);
      if (A.AttType = AT_OBJID) and (ObjectIDName = '') then
        ObjectIDName := AttInterpolantName(A.AttType, Loc);
      Inc(Loc);
    end;

  if Assigned(OS) then
    ColorExpression := OS.GetShaderFragmentColorExpression(
      SamplerName, TexCoordName, ColorName)
  else if HasTexture and (TexCoordName <> '') then
    ColorExpression := 'texture(' + SamplerName + ', ' + TexCoordName + ')'
  else if ColorName <> '' then
    ColorExpression := ColorName
  else
    ColorExpression := 'vec4(1.0)';

  try
    SB.AppendLine('void main()');
    SB.AppendLine('{');

    //?? primary color output ??????????????????????????????????????????????????
    SB.AppendLine('    outColor = ' + ColorExpression + ';');

    //?? additional MRT outputs ?????????????????????????????????????????????????
    if ColCount > 1 then
    begin
      SB.AppendLine('');
      SB.AppendLine('    // TODO: fill additional G-Buffer render targets');
      for I := 1 to ColCount - 1 do
        SB.AppendLine(Format('    outColor%d = vec4(0.0);', [I]));
    end;

    //?? ObjectID output ????????????????????????????????????????????????????????
    if Assigned(aGP) and aGP.SelectON then
    begin
      if ObjectIDBufferName = '' then
        raise EInvalidOperation.Create(
          'ObjectID output requires the global storage image descriptor "' +
          GlobalObjectIDDescriptor + '"');

      SB.AppendLine('');
      if ModuleHasSpecialConstant(aGP.FragmentS, 'USE_OBJECTID') then
      begin
        SB.AppendLine('    if (USE_OBJECTID) {');
        if ObjectIDName <> '' then
          SB.AppendLine('        uvec4 ObjID = uvec4(' +
            ObjectIDName + '.xy, 0u, 0u);')
        else
          SB.AppendLine('        uvec4 ObjID = uvec4(0u);');
        SB.AppendLine('        ivec2 coord = ivec2(gl_FragCoord.xy);');
        SB.AppendLine('        imageStore(' + ObjectIDBufferName +
          ', coord, ObjID);');
        SB.AppendLine('    }');
      end
      else
      begin
        if ObjectIDName <> '' then
          SB.AppendLine('    uvec4 ObjID = uvec4(' +
            ObjectIDName + '.xy, 0u, 0u);')
        else
          SB.AppendLine('    uvec4 ObjID = uvec4(0u);');
        SB.AppendLine('    ivec2 coord = ivec2(gl_FragCoord.xy);');
        SB.AppendLine('    imageStore(' + ObjectIDBufferName +
          ', coord, ObjID);');
      end;
    end;

    SB.AppendLine('}');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  Geometry main() � complete pass-through
//
//  This is the only main() that requires zero application-specific logic.
//  The topology drives the vertex count, and every interpolant is forwarded
//  from the vertex-stage arrays to the fragment-stage scalars.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_GeometryMain(aGP: TvgGraphicPipeline): String;
var
  SB       : TStringBuilder;
  I        : Integer;
  A        : TvgVertexAttributeDesc;
  VarName  : String;
  MaxV     : Integer;
  Loc      : Integer;
begin
  SB   := TStringBuilder.Create;
  MaxV := 3;
  Loc  := 0;

  if Assigned(aGP) then
    MaxV := TopologyMaxVerts(aGP.InputAssembly.Topology);

  try
    SB.AppendLine('void main()');
    SB.AppendLine('{');
    SB.AppendLine(Format('    for (int i = 0; i < %d; i++)', [MaxV]));
    SB.AppendLine('    {');
    SB.AppendLine('        gl_Position = gl_in[i].gl_Position;');
    if Assigned(aGP) and
       (TopologyGeomOut(aGP.InputAssembly.Topology) = 'points') then
      SB.AppendLine('        gl_PointSize = gl_in[i].gl_PointSize;');

    // Forward each interpolant from input array to output scalar
    if Assigned(aGP) then
    begin
      for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
      begin
        A := aGP.VertexInput.Attributes.Items[I];
        if not Assigned(A) then continue;
        if AttIsVertexOnly(A.AttType) then continue;

        VarName := AttInterpolantName(A.AttType, Loc);
        SB.AppendLine(Format('        %s = %sIn[i];',
                             [VarName, VarName]));
        Inc(Loc);
      end;
    end;

    SB.AppendLine('        EmitVertex();');
    SB.AppendLine('    }');
    SB.AppendLine('    EndPrimitive();');
    SB.AppendLine('}');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  PRIMARY PUBLIC BUILD METHODS
//???????????????????????????????????????????????????????????????????????????????

//???????????????????????????????????????????????????????????????????????????????
//  BuildVertexShader
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.BuildVertexShader(aGP: TvgGraphicPipeline): String;
var
  SB       : TStringBuilder;
  GP       : TvgGraphicPipeline;
  UseDouble: Boolean;
  OutCount    : Integer;
begin
  GP := ResolvedGP(aGP);

  if not Assigned(GP) then
  begin
    Result := '// ERROR: TvgShaderBuilder.Pipeline is not assigned' + sLineBreak;
    exit;
  end;

  if not (PS_VERTEX in GP.UseShaders) then
  begin
    Result := '';
    exit;
  end;

  // Detect USE_DOUBLE spec constant in the vertex module
  UseDouble := ModuleUsesDouble(GP.VertexS) or GP.DoubleOn or
               GlobalUsesDouble(GP);

  SB := TStringBuilder.Create;
  try

    SB.Append(Cmt('------------------------------------------------------'));
    SB.Append(Cmt('VERTEX SHADER - generated by TvgShaderBuilder'));
    SB.Append(Cmt('Pipeline : ' + GP.Name));
    SB.Append(Cmt('------------------------------------------------------'));

    SB.AppendLine('');

    SB.Append(SB_Header(UseDouble, False, RequiresDescriptorIndexing(GP)));
    SB.Append(SB_SpecialisationConstants(GP.VertexS));         // [FULL]
    SB.Append(SB_GlobalSet(GP.Renderer, 'Vertex'));
    SB.Append(SB_PipeSet(GP, ObjectStoreSetIndex(GP), 'Vertex'));
    SB.Append(SB_ModelSet(GP, 'Vertex'));
    SB.Append(SB_VertexInputs(GP));                            // [FULL]
    SB.Append(SB_VertexOutputs(GP, OutCount));                    // [INFRA]
    fLastVertexOutCount := OutCount;
    SB.AppendLine('');
    SB.Append(SB_VertexMain(GP));                              // [MAIN]

    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  BuildGeometryShader
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.BuildGeometryShader(aGP: TvgGraphicPipeline): String;
var
  SB : TStringBuilder;
  GP : TvgGraphicPipeline;
begin
  GP := ResolvedGP(aGP);

  if not Assigned(GP) then
  begin
    Result := '// ERROR: TvgShaderBuilder.Pipeline is not assigned' + sLineBreak;
    exit;
  end;

  if not (PS_GEOMETRY in GP.UseShaders) then
  begin
    Result := '';
    exit;
  end;

  SB := TStringBuilder.Create;
  try

    SB.Append(Cmt('------------------------------------------------------'));
    SB.Append(Cmt('GEOMETRY SHADER - generated by TvgShaderBuilder'));
    SB.Append(Cmt('Pipeline : ' + GP.Name));
    SB.Append(Cmt('------------------------------------------------------'));

    SB.AppendLine('');

    SB.Append(SB_Header(GlobalUsesDouble(GP), True,
      RequiresDescriptorIndexing(GP)));
    SB.Append(SB_SpecialisationConstants(GP.GeometryS));       // [FULL]
    SB.Append(SB_GeomLayout(GP));                              // [FULL]
    SB.Append(SB_GlobalSet(GP.Renderer, 'Geometry'));
    SB.Append(SB_PipeSet(GP, ObjectStoreSetIndex(GP), 'Geometry'));
    SB.Append(SB_ModelSet(GP, 'Geometry'));
    SB.Append(SB_GeomInterface(GP));                           // [INFRA]
    SB.AppendLine('');
    SB.Append(SB_GeometryMain(GP));                            // [FULL]

    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  BuildFragmentShader
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.BuildFragmentShader(aGP: TvgGraphicPipeline;
                                               aSP: TvgSubPass): String;
var
  SB : TStringBuilder;
  GP : TvgGraphicPipeline;
  SP : TvgSubPass;
  InCount:Integer;
begin
  GP := ResolvedGP(aGP);
  SP := ResolvedSP(GP, aSP);

  if not Assigned(GP) then
  begin
    Result := '// ERROR: TvgShaderBuilder.Pipeline is not assigned' + sLineBreak;
    exit;
  end;

  if not (PS_FRAGMENT in GP.UseShaders) then
  begin
    Result := '';
    exit;
  end;

  SB := TStringBuilder.Create;
  try

      SB.Append(Cmt('------------------------------------------------------'));
    SB.Append(Cmt('FRAGMENT SHADER - generated by TvgShaderBuilder'));
    SB.Append(Cmt('Pipeline : ' + GP.Name));
    SB.Append(Cmt('------------------------------------------------------'));

    SB.AppendLine('');

    SB.Append(SB_Header(GlobalUsesDouble(GP), False,
      RequiresDescriptorIndexing(GP)));
    SB.Append(SB_SpecialisationConstants(GP.FragmentS));       // [FULL]
    if GP.SelectON then
    begin
      SB.Append(Cmt('ObjectID image writes must occur only after depth tests pass'));
      SB.AppendLine('layout(early_fragment_tests) in;');
      SB.AppendLine('');
    end;
    SB.Append(SB_GlobalSet(GP.Renderer, 'Fragment'));
    SB.Append(SB_PipeSet(GP, ObjectStoreSetIndex(GP), 'Fragment'));
    SB.Append(SB_ModelSet(GP, 'Fragment'));
    SB.Append(SB_FragmentInputs(GP,InCount));                  // [INFRA]
    fLastFragmentInCount := InCount;
    SB.Append(SB_FragmentOutputs(GP, SP));                     // [FULL]
    SB.AppendLine('');
    SB.Append(SB_FragmentMain(GP, SP));                        // [MAIN]

    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  BuildAll
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.BuildAll(aGP: TvgGraphicPipeline;
                                    aSP: TvgSubPass): TvgShaderBuildResult;
var
  GP       : TvgGraphicPipeline;
  SP       : TvgSubPass;
  BaseName : String;
  OutPath  : String;
begin
  GP := ResolvedGP(aGP);
  SP := ResolvedSP(GP, aSP);

  BaseName := '';
  if Assigned(GP) then BaseName := GP.Name;

  OutPath := fOutputPath;
  if OutPath = '' then OutPath := ShaderFolderPath;

// Vertex
  Result.Vert.GLSL        := BuildVertexShader(GP);
  Result.Vert.IsGenerated := Result.Vert.GLSL <> '';
  Result.Vert.SpvPath     := TPath.Combine(OutPath, BaseName + '_vert.spv');

  // Geometry
  Result.Geom.GLSL        := BuildGeometryShader(GP);
  Result.Geom.IsGenerated := Result.Geom.GLSL <> '';
  Result.Geom.SpvPath     := TPath.Combine(OutPath, BaseName + '_geom.spv');

  // Fragment
  Result.Frag.GLSL        := BuildFragmentShader(GP, SP);
  Result.Frag.IsGenerated := Result.Frag.GLSL <> '';
  Result.Frag.SpvPath     := TPath.Combine(OutPath, BaseName + '_frag.spv');

  // Sanity check: interpolant counts must agree between stages
  if Result.Vert.IsGenerated and Result.Frag.IsGenerated and
     (fLastVertexOutCount <> fLastFragmentInCount) then
    CustomAssert(False, Format('TvgShaderBuilder: vertex output count (%d) does not match ' +
      'fragment input count (%d) for pipeline "%s"',
      [fLastVertexOutCount, fLastFragmentInCount, BaseName]));
 end;

//???????????????????????????????????????????????????????????????????????????????
//  SaveSources  �  write .vert / .geom / .frag text files
//???????????????????????????????????????????????????????????????????????????????
procedure TvgShaderBuilder.SaveSources(const aResult: TvgShaderBuildResult);

  procedure WriteOne(const aStage: TvgShaderStageResult; const aExt: String);
  var
    Path: String;
  begin
    if not aStage.IsGenerated then exit;
    Path := ChangeFileExt(aStage.SpvPath, aExt);
    TFile.WriteAllText(Path, aStage.GLSL, TEncoding.UTF8);
  end;

var
  Dir: String;
begin
  Dir := fOutputPath;
  if Dir = '' then Dir := ShaderFolderPath;
  if not TDirectory.Exists(Dir) then
    TDirectory.CreateDirectory(Dir);

  WriteOne(aResult.Vert, '.vert');
  WriteOne(aResult.Geom, '.geom');
  WriteOne(aResult.Frag, '.frag');
end;

//???????????????????????????????????????????????????????????????????????????????
//  CompileAll  �  save sources then call OnCompile for every active stage
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.CompileAll(aGP: TvgGraphicPipeline;
                                      aSP: TvgSubPass): Boolean;
var
  R    : TvgShaderBuildResult;
  AllOK: Boolean;

  function TryStage(const aSP: TvgShaderStageResult; const aStageId: String): Boolean;
  begin
    Result := True;
    if not aSP.IsGenerated then exit;
    if not Assigned(fOnCompile) then exit;
    // aS.GLSL = source text; aS.SpvPath = output path
    Result := fOnCompile(aSP.GLSL, aStageId, aSP.SpvPath);
  end;

begin
  R     := BuildAll(aGP, aSP);
  SaveSources(R);

  AllOK := True;
  AllOK := TryStage(R.Vert, 'vert') and AllOK;
  AllOK := TryStage(R.Geom, 'geom') and AllOK;
  AllOK := TryStage(R.Frag, 'frag') and AllOK;

  Result := AllOK;
end;


end.
