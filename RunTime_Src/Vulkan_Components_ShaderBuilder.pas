//???????????????????????????????????????????????????????????????????????????????
//  Resolve helpers
//???????????????????????????????????????????????????????????????????????????????

function TvgShaderBuilder.ResolvedGP(aGP: TvgGraphicPipeline): TvgGraphicPipeline;
begin
  if Assigned(aGP) then Result := aGP else Result := fPipeline;
end;

function TvgShaderBuilder.ResolvedSP(aGP: TvgGraphicPipeline;
                                      aSP: TvgSubPass): TvgSubPass;
begin
  if Assigned(aSP) then
    Result := aSP
  else if Assigned(aGP) then
    Result := aGP.SubPass
  else
    Result := nil;
end;

//???????????????????????????????????????????????????????????????????????????????
//  Formatting helpers
//???????????????????????????????????????????????????????????????????????????????

function TvgShaderBuilder.Cmt(const aText: String): String;
begin
  if fIncludeComments then Result := '// ' + aText + sLineBreak
  else                     Result := '';
end;

function TvgShaderBuilder.Sep(const aTitle: String): String;
begin
  if fIncludeComments then
    Result := sLineBreak + '// --- ' + aTitle + ' ---' + sLineBreak
  else
    Result := sLineBreak;
end;

//???????????????????????????????????????????????????????????????????????????????
//  TYPE-MAPPING HELPERS
//???????????????????????????????????????????????????????????????????????????????

//???????????????????????????????????????????????????????????????????????????????
//  VkFormat ? GLSL type string
//  Covers every format realistically used for vertex attributes.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.VkFmtToGLSL(aFmt: TVkFormat): String;
begin
  case aFmt of
    // 32-bit float (most common vertex attributes)
    VK_FORMAT_R32_SFLOAT          : Result := 'float';
    VK_FORMAT_R32G32_SFLOAT       : Result := 'vec2';
    VK_FORMAT_R32G32B32_SFLOAT    : Result := 'vec3';
    VK_FORMAT_R32G32B32A32_SFLOAT : Result := 'vec4';
    // 64-bit double (requires GL_EXT_shader_explicit_arithmetic_types_float64)
    VK_FORMAT_R64_SFLOAT          : Result := 'double';
    VK_FORMAT_R64G64_SFLOAT       : Result := 'dvec2';
    VK_FORMAT_R64G64B64_SFLOAT    : Result := 'dvec3';
    VK_FORMAT_R64G64B64A64_SFLOAT : Result := 'dvec4';
    // 16-bit half (promoted in shader to float/vec)
    VK_FORMAT_R16_SFLOAT          : Result := 'float';
    VK_FORMAT_R16G16_SFLOAT       : Result := 'vec2';
    VK_FORMAT_R16G16B16_SFLOAT    : Result := 'vec3';
    VK_FORMAT_R16G16B16A16_SFLOAT : Result := 'vec4';
    // 32-bit signed int
    VK_FORMAT_R32_SINT            : Result := 'int';
    VK_FORMAT_R32G32_SINT         : Result := 'ivec2';
    VK_FORMAT_R32G32B32_SINT      : Result := 'ivec3';
    VK_FORMAT_R32G32B32A32_SINT   : Result := 'ivec4';
    // 32-bit unsigned int
    VK_FORMAT_R32_UINT            : Result := 'uint';
    VK_FORMAT_R32G32_UINT         : Result := 'uvec2';
    VK_FORMAT_R32G32B32_UINT      : Result := 'uvec3';
    VK_FORMAT_R32G32B32A32_UINT   : Result := 'uvec4';
    // 8-bit normalised colour (expanded to vec4 in shader)
    VK_FORMAT_R8G8B8A8_UNORM,
    VK_FORMAT_B8G8R8A8_UNORM      : Result := 'vec4';
  else
    // Unknown – emit a diagnostic comment; will not prevent compilation
    Result := Format('float /*FIXME VkFormat=%d*/', [Ord(aFmt)]);
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  TvgSpecialisationType ? GLSL type keyword
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SpecTypeToGLSL(aST: TvgSpecialisationType): String;
begin
  case aST of
    TS_BOOLEAN : Result := 'bool';
    TS_INTEGER : Result := 'int';
    TS_SINGLE  : Result := 'float';
  else
    Result := 'int /*FIXME SpecType*/';
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  TvgPrimitiveTopology ? geometry shader keywords
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.TopologyGeomIn(aT: TvgPrimitiveTopology): String;
begin
  case aT of
    POINT_LIST                    : Result := 'points';
    LINE_LIST, LINE_STRIP         : Result := 'lines';
  else {TRIANGLE_LIST, STRIP etc} Result := 'triangles';
  end;
end;

function TvgShaderBuilder.TopologyGeomOut(aT: TvgPrimitiveTopology): String;
begin
  case aT of
    POINT_LIST                    : Result := 'points';
    LINE_LIST, LINE_STRIP         : Result := 'line_strip';
  else                              Result := 'triangle_strip';
  end;
end;

function TvgShaderBuilder.TopologyMaxVerts(aT: TvgPrimitiveTopology): Integer;
begin
  case aT of
    POINT_LIST                    : Result := 1;
    LINE_LIST, LINE_STRIP         : Result := 2;
  else                              Result := 3;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  TvgAttributeType helpers
//
//  TvgAttributeType is declared in Vulkan_Components_Lookups which is not
//  uploaded here.  The integer ordinals below use the standard enum ordering
//  that matches the CI_xxx constant assignments seen in BuildAGraphicPipeline.
//  Replace every Ord(aAT) comparison with the named constant once available:
//     Ord 0 ? AT_POSITION   (feeds gl_Position, NOT an interpolant)
//     Ord 1 ? AT_NORMAL
//     Ord 2 ? AT_COLOR
//     Ord 3 ? AT_TEXCOORD
//     Ord 4 ? AT_TANGENT
//     Ord 5 ? AT_BITANGENT
//     Ord 6 ? AT_INSTANCE
//     Ord 7 ? AT_OBJECTID
//???????????????????????????????????????????????????????????????????????????????

function TvgShaderBuilder.AttIsPosition(aAT: TvgAttributeType): Boolean;
begin
  Result := (aAT = AT_POSITION);
end;

// For the interpolant type we special-case TEXCOORD ? always vec2
// regardless of the underlying storage format.
function TvgShaderBuilder.AttGLSLType(aAT: TvgAttributeType;
                                       aFmt: TVkFormat): String;
begin
  if aAT = AT_TEXTURE then
    Result := 'ivec2'    //check
  else
    Result := VkFmtToGLSL(aFmt);
end;

// Generates a descriptive interpolant variable name from semantic
function TvgShaderBuilder.AttInterpolantName(aAT: TvgAttributeType;
                                              aLoc: Integer): String;
var
  BaseName: String;
begin
  case Ord(aAT) of
    1 : BaseName := 'fragNormal';
    2 : BaseName := 'fragColor';
    3 : BaseName := 'fragTexCoord';
    4 : BaseName := 'fragTangent';
    5 : BaseName := 'fragBitangent';
    6 : BaseName := 'fragInstance';
    7 : BaseName := 'fragObjectID';
  else  BaseName := 'fragAttr';
  end;
  // aLoc is the running interpolant-location counter — unique per non-position
  // attribute and identical across SB_VertexOutputs/SB_FragmentInputs/
  // SB_GeomInterface/SB_VertexMain/SB_GeometryMain — so suffixing guarantees
  // distinct identifiers even with two attributes of the same semantic type
  // (e.g. two TEXCOORD channels), and doubles as a readable location tag.
  Result := Format('%s%d', [BaseName, aLoc]);
end;

//???????????????????????????????????????????????????????????????????????????????
//  SECTION BUILDERS
//???????????????????????????????????????????????????????????????????????????????

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  #version and extension block
//???????????????????????????????????????????????????????????????????????????????

function TvgShaderBuilder.SB_Header(aUseDouble, aGeomStage,
                                     aDescriptorIndexing: Boolean): String;
var
  SB: TStringBuilder;
begin
  SB := TStringBuilder.Create;
  try
    SB.AppendLine('#version 450');
    SB.AppendLine('#extension GL_ARB_separate_shader_objects : enable');

    if aDescriptorIndexing then
    begin
      SB.AppendLine('#extension GL_EXT_nonuniform_qualifier : enable');
      SB.AppendLine('#extension GL_EXT_descriptor_indexing : enable');
    end;

    if aUseDouble then
    begin
      SB.AppendLine('#extension GL_EXT_shader_explicit_arithmetic_types_float64 : enable');
      SB.AppendLine('#extension GL_ARB_gpu_shader_fp64 : enable');
    end;

    if aGeomStage then
      SB.AppendLine('#extension GL_ARB_geometry_shader4 : enable');

    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  Specialisation constants from a TvgShaderModule
//  Reads: ConstantID, SpecType (? GLSL type), SpecTValue (? default literal),
//         Name (? GLSL identifier).
//  The SpecialConst collection is already populated by BuildAGraphicPipeline.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_SpecialisationConstants(aModule: TvgShaderModule): String;
var
  SB       : TStringBuilder;
  I        : Integer;
  SC       : TvgShaderSpecialisationItem;
  GLSLType : String;
  Default  : String;
begin
  Result := '';
  if not Assigned(aModule) then exit;
  if aModule.SpecialConst.Count = 0 then exit;

  SB := TStringBuilder.Create;
  try
    SB.Append(Sep('Specialisation constants'));

    for I := 0 to aModule.SpecialConst.Count - 1 do
    begin
      SC := aModule.SpecialConst.Items[I];
      if not Assigned(SC) then continue;

      GLSLType := SpecTypeToGLSL(SC.SpecType);

      // Convert the stored Pascal string to a valid GLSL literal
      case SC.SpecType of
        TS_BOOLEAN :
          if SameText(SC.SpecTValue, 'True') or SameText(SC.SpecTValue, 'T') then
            Default := 'true'
          else
            Default := 'false';
        TS_INTEGER : Default := SC.SpecTValue;
        TS_SINGLE  :
          begin
            Default := SC.SpecTValue;
            // GLSL requires a decimal point for float literals
            if Pos('.', Default) = 0 then Default := Default + '.0';
          end;
      else
        Default := SC.SpecTValue;
      end;

      SB.AppendLine(Format('layout(constant_id = %d) const %s %s = %s;',
                           [SC.ConstantID, GLSLType, SC.Name, Default]));
    end;

    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  SET 0 – global resources
//
//  Binding 0 : GlobalUBO  (viewProject mat4) — always when RU_GLOBAL
//  Binding 1 : objectIDImage (rg32ui storage) — only when Renderer.SelectON
//
//  The actual set index is 0 because BindPipelineDescriptors binds GlobalRes
//  first (SN starts at 0) and GraphicPipeRes second.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_GlobalSet(aRE: TvgBaseRenderEngine): String;
var
  SB      : TStringBuilder;
  Renderer: TvgBaseRenderEngine;
begin
  Result := '';
  if not Assigned(aRE) then exit;
//  if not (RU_GLOBAL in aRE.ResourceUse) then exit;

  Renderer := aRE;

  SB := TStringBuilder.Create;
  try
    SB.Append(Sep('SET 0 – Global resources (shared across all pipelines)'));
   //always ON
    SB.AppendLine('layout(set = 0, binding = 0) uniform GlobalUBO {');
    SB.AppendLine('    mat4 viewProject;');
    SB.AppendLine('} globalUBO;');
    SB.AppendLine('');

    // ObjectID storage image – only present when the renderer has SelectON
    if Renderer.SelectON then
    begin
      SB.Append(Cmt('Object-picking storage image – written by fragment, read by CPU'));
      SB.AppendLine('layout(set = 0, binding = 1, rg32ui) uniform uimage2D objectIDImage;');
      SB.AppendLine('');
    end;

    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [INFRA]  SET 1 – GraphicPipeRes descriptor bindings
//
//  Iterates GP.GraphicPipeRes.Descriptors and calls each TvgDescriptor's
//  GetShaderDescriptorStringTemplate_<Stage>(set, binding) virtual.
//
//  TvgDescriptor_Texture   ? FULL (returns "layout(set=S,binding=B) uniform
//                              sampler2D %s" which we format with DI.Name)
//  TvgDescriptor_UBO       ? stub '' until override adds GetShaderDescriptor*
//  TvgDescriptor_SSBO      ? stub '' until override adds GetShaderDescriptor*
//  TvgDescriptor_StorageImage ? stub '' until override
//
//  For every stub we emit a commented skeleton with the correct set/binding
//  numbers so the developer can fill it in immediately.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_PipeSet(aGP: TvgGraphicPipeline;
                                      aSetIndex: TvkUint32;
                                      const aStageTag: String): String;
var
  SB         : TStringBuilder;
  DS         : TvgDescriptorSet;
  DI         : TvgDescriptorItem;
  D          : TvgDescriptorArray;
  Line       : String;
  DescType   : String;
  I          : Integer;
  OS         : TvgBaseObjectStore;
begin
  Result := '';
  if not Assigned(aGP) then exit;
  If not assigned(aGP.ObjectStore) then exit;
  if not (RU_OBJECTSTORE in aGP.ObjectStore.ResourceUse) then exit;

  DS := aGP.ObjectStore.ObjectStoreRes;

  if not Assigned(DS) or (DS.Descriptors.Count = 0) then exit;

  SB := TStringBuilder.Create;
  try
    SB.Append(Sep(Format('SET %d – GraphicPipe resources', [aSetIndex])));

    for I := 0 to DS.Descriptors.Count - 1 do
    begin
      DI := DS.Descriptors.Items[I];
      if not Assigned(DI) then continue;

      D := DI.Descriptor;
      if not Assigned(D) then continue;

      // Ask the descriptor for its GLSL line
      if SameText(aStageTag, 'Vertex') then
        Line := D.GetShaderDescriptorStringTemplate_Vertex(aSetIndex, DI.Descriptor.Binding)
      else if SameText(aStageTag, 'Geometry') then
        Line := D.GetShaderDescriptorStringTemplate_Geometry(aSetIndex, DI.Descriptor.Binding)
      else
        Line := D.GetShaderDescriptorStringTemplate_Fragment(aSetIndex, DI.Descriptor.Binding);

      if Line <> '' then
      begin
        if Pos('%s', Line) > 0 then
          Line := StringReplace(Line, '%s', DI.Name, [rfReplaceAll]);
        // Ensure it ends with a semicolon
        Line := TrimRight(Line);
        if (Length(Line) > 0) and (Line[High(Line)] <> ';') then
          Line := Line + ';';

        SB.AppendLine(Line);
      end else
      begin
        //??????????????????????????????????????????????????????????????????
        // Stub: the descriptor subclass has not overridden the template.
        // Emit a typed comment skeleton the developer can activate quickly.
        //??????????????????????????????????????????????????????????????????
        DescType := D.ClassName;
      (*
        if D is TvgDescriptorArray_UBO then
        begin
          SB.AppendLine(Format('// TODO (set=%d binding=%d) uniform %s {',
                                [aSetIndex, D.Binding, DI.Name]));
                                 SB.AppendLine('//     /* add fields matching your Pascal record T */');
                                 SB.AppendLine(Format('// } %s;  // size = %d bytes', [DI.Name, D.GetSize]));
        end else
        if D is TvgDescriptor_SSBO then
        begin
          SB.AppendLine(Format( '// TODO (set=%d binding=%d) buffer %s {',
                                  [aSetIndex, D.Binding, DI.Name]));
                                SB.AppendLine('//     /* add fields matching your Pascal record T */');
                                SB.AppendLine(Format('// };  // stride = %d bytes', [DI.Name, D.GetStride]));
        end else
        begin
        *)
          SB.AppendLine(Format('// TODO set=%d binding=%d  [%s] "%s"  — override ' +
                              'GetShaderDescriptorStringTemplate_%s',
                              [aSetIndex, D.Binding, DescType, DI.Name, aStageTag]));
       // end;

      end;
    end;

    SB.AppendLine('');

    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  Vertex attribute input declarations
//  Uses TvgVertexAttributeDesc.GetShaderHeadTemplate which already produces
//  the correct "layout(location = N) in <type> <name>" string.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_VertexInputs(aGP: TvgGraphicPipeline): String;
var
  SB : TStringBuilder;
  I  : Integer;
  A  : TvgVertexAttributeDesc;
begin
  Result := '';
  if not Assigned(aGP) then exit;
  if aGP.VertexInput.Attributes.Count = 0 then exit;

  SB := TStringBuilder.Create;
  try
    SB.Append(Sep('Per-vertex inputs'));

    for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
    begin
      A := aGP.VertexInput.Attributes.Items[I];
      if not Assigned(A) then continue;
      // GetShaderHeadTemplate returns the layout line without trailing semicolon
      SB.AppendLine(A.GetShaderHeadTemplate + ';');
    end;

    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [INFRA]  Vertex output interpolants
//  Position attributes are skipped (they write to gl_Position in main).
//  aOutCount receives the number of out variables emitted so that
//  SB_FragmentInputs and SB_GeomInterface can produce matching declarations.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_VertexOutputs(aGP: TvgGraphicPipeline;
                                             out aOutCount: Integer): String;
var
  SB      : TStringBuilder;
  I       : Integer;
  A       : TvgVertexAttributeDesc;
  GLSLTyp : String;
  VarName : String;
  Loc     : Integer;
begin
  Result   := '';
  aOutCount := 0;
  if not Assigned(aGP) then exit;

  SB  := TStringBuilder.Create;
  Loc := 0;
  try
    SB.Append(Sep('Vertex ? fragment interpolants (out)'));

    for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
    begin
      A := aGP.VertexInput.Attributes.Items[I];
      if not Assigned(A) then continue;
      if AttIsPosition(A.AttType) then continue;  // ? gl_Position in main()

      GLSLTyp := AttGLSLType(A.AttType, TVkFormat(Ord(A.AttFormat)));
      VarName  := AttInterpolantName(A.AttType, Loc);

      SB.AppendLine(Format('layout(location = %d) out %s %s;',
                           [Loc, GLSLTyp, VarName]));
      Inc(Loc);
    end;

    if Loc = 0 then
    begin
      SB.Append(Cmt('No interpolants derived from attributes.'));
      SB.Append(Cmt('Add layout(location=N) out declarations here if needed.'));
    end;

    aOutCount := Loc;
    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [INFRA]  Fragment inputs – exact mirror of vertex outputs
//???????????????????????????????????????????????????????????????????????????????

function TvgShaderBuilder.SB_FragmentInputs(aGP: TvgGraphicPipeline;
                                             out aInCount: Integer): String;
var
  SB      : TStringBuilder;
  I       : Integer;
  A       : TvgVertexAttributeDesc;
  GLSLTyp : String;
  VarName : String;
  Loc     : Integer;
begin
  Result   := '';
  aInCount := 0;
  if not Assigned(aGP) then exit;

  SB  := TStringBuilder.Create;
  Loc := 0;
  try
    SB.Append(Sep('Fragment inputs (interpolated from vertex stage)'));

    for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
    begin
      A := aGP.VertexInput.Attributes.Items[I];
      if not Assigned(A) then continue;
      if AttIsPosition(A.AttType) then continue;

      GLSLTyp := AttGLSLType(A.AttType, TVkFormat(Ord(A.AttFormat)));
      VarName  := AttInterpolantName(A.AttType, Loc);

      SB.AppendLine(Format('layout(location = %d) in %s %s;',
                           [Loc, GLSLTyp, VarName]));
      Inc(Loc);
    end;

    if Loc = 0 then
      SB.Append(Cmt('No interpolated inputs. Add layout(location=N) in here.'));

    aInCount := Loc;
    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  Fragment color outputs
//  Number of vec4 outputs = SP.ColorAttachments.Count + SP.ResolveAttachment.Count
//  ObjectID output appended when GP.ObjectIDON.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_FragmentOutputs(aGP: TvgGraphicPipeline;
                                               aSP: TvgSubPass): String;
var
  SB       : TStringBuilder;
  ColCount : Integer;
  Loc      : Integer;
  I        : Integer;
begin
  SB := TStringBuilder.Create;
  try
    SB.Append(Sep('Fragment outputs'));

    // Count color outputs from SubPass attachment collections
    ColCount := 1;  // safe minimum – one output always exists

    if Assigned(aSP) then
    begin
      ColCount := aSP.ColorAttachments.Count;
      // Resolve attachments are resolved automatically by the driver during
      // the subpass — the fragment shader never writes to them directly, so
      // they must NOT add extra output locations.
      if ColCount < 1 then ColCount := 1;
    end;

    Loc := 0;
    for I := 0 to ColCount - 1 do
    begin
      if I = 0 then
        SB.AppendLine(Format('layout(location = %d) out vec4 outColor;', [Loc]))
      else
        SB.AppendLine(Format('layout(location = %d) out vec4 outColor%d;', [Loc, I]));
      Inc(Loc);
    end;

    // ObjectID output
    if Assigned(aGP) and aGP.ObjectIDON then
    begin
      SB.AppendLine('');
      SB.Append(Cmt('Object-picking output – location immediately after color outputs'));
      SB.AppendLine(Format('layout(location = %d) out uvec2 outObjectID;', [Loc]));
    end;

    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  Geometry shader primitive-type declarations
//  Fully derived from InputAssembly.Topology.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_GeomLayout(aGP: TvgGraphicPipeline): String;
var
  SB   : TStringBuilder;
  Topo : TvgPrimitiveTopology;
begin
  Result := '';
  if not Assigned(aGP) then exit;

  SB   := TStringBuilder.Create;
  Topo := aGP.InputAssembly.Topology;
  try
    SB.Append(Sep('Geometry shader primitive declarations (derived from topology)'));
    SB.AppendLine(Format('layout(%s) in;', [TopologyGeomIn(Topo)]));
    SB.AppendLine(Format('layout(%s, max_vertices = %d) out;',
                         [TopologyGeomOut(Topo), TopologyMaxVerts(Topo)]));
    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [INFRA]  Geometry shader interpolant interface
//  Inputs from vertex are arrays: layout(loc=N) in T nameIn[];
//  Outputs to fragment are scalars: layout(loc=N) out T name;
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_GeomInterface(aGP: TvgGraphicPipeline): String;
var
  SB      : TStringBuilder;
  I       : Integer;
  A       : TvgVertexAttributeDesc;
  Typ     : String;
  Nam     : String;
  Loc     : Integer;
begin
  Result := '';
  if not Assigned(aGP) then exit;

  SB  := TStringBuilder.Create;
  Loc := 0;
  try
    SB.Append(Sep('Interpolant interface (in[] from vertex, out to fragment)'));

    for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
    begin
      A := aGP.VertexInput.Attributes.Items[I];
      if not Assigned(A) then continue;
      if AttIsPosition(A.AttType) then continue;

      Typ := AttGLSLType(A.AttType, TVkFormat(Ord(A.AttFormat)));
      Nam := AttInterpolantName(A.AttType, Loc);

      SB.AppendLine(Format('layout(location = %d) in  %s %sIn[];',
                           [Loc, Typ, Nam]));   // input array from vertex
      SB.AppendLine(Format('layout(location = %d) out %s %s;',
                           [Loc, Typ, Nam]));   // scalar output to fragment
      Inc(Loc);
    end;

    SB.AppendLine('');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  main() BUILDERS
//???????????????????????????????????????????????????????????????????????????????

//???????????????????????????????????????????????????????????????????????????????
//  [MAIN]  Vertex main()
//
//  Deterministic parts (generated from state):
//    • gl_Position = globalUBO.viewProject * vec4(<position_attr>, 1.0)
//    • Pass-through assignments for every non-position interpolant
//    • gl_PointSize branch guarded by the POINT_SIZE_ON spec constant
//    • USE_DOUBLE branch with dvec4 cast
//
//  Stub parts (require application logic):
//    • The model-space transform (currently identity / viewProject only)
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_VertexMain(aGP: TvgGraphicPipeline): String;
var
  SB       : TStringBuilder;
  I        : Integer;
  A        : TvgVertexAttributeDesc;
  PosName  : String;
  VarName  : String;
  Loc      : Integer;
  UseDouble: Boolean;
  UsePoints: Boolean;
begin
  SB        := TStringBuilder.Create;
  PosName   := 'inPosition'; // fallback if no AT_POSITION attribute found
  UseDouble := False;
  UsePoints := False;
  Loc       := 0;

  if Assigned(aGP) then
  begin

    UseDouble := ModuleUsesDouble(aGP.VertexS);
    UsePoints := (aGP.InputAssembly.Topology = POINT_LIST);
    // Detect USE_DOUBLE from spec constants

    // Find the position attribute name
    for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
    begin
      A := aGP.VertexInput.Attributes.Items[I];
      if Assigned(A) and AttIsPosition(A.AttType) then
      begin
        PosName := A.Name;
        break;
      end;
    end;
  end;

  try
    SB.AppendLine('void main()');
    SB.AppendLine('{');

    //?? gl_Position ??????????????????????????????????????????????????????????
    if UseDouble then
    begin
      SB.AppendLine('    // Double-precision path (USE_DOUBLE = true)');
      SB.AppendLine('    // TODO: apply model matrix in double precision before projecting');
      SB.AppendLine('    if (USE_DOUBLE) {');
      SB.AppendLine('        dvec4 worldPos   = dvec4(' + PosName + ', 1.0lf);');
      SB.AppendLine('        // dvec4 worldPos = dModelMatrix * dvec4(' + PosName + ', 1.0lf);');
      SB.AppendLine('        gl_Position = vec4(globalUBO.viewProject * vec4(worldPos));');
      SB.AppendLine('    } else {');
      SB.AppendLine('        gl_Position = globalUBO.viewProject * vec4(' + PosName + ', 1.0);');
      SB.AppendLine('    }');
    end else
    begin
      SB.AppendLine('    // TODO: insert model matrix if this pipeline uses per-object transforms');
      SB.AppendLine('    gl_Position = globalUBO.viewProject * vec4(' + PosName + ', 1.0);');
    end;

    //?? interpolant pass-through ?????????????????????????????????????????????
    if Assigned(aGP) and (aGP.VertexInput.Attributes.Count > 0) then
    begin
      SB.AppendLine('');
      SB.Append('    ' + Cmt('Pass-through interpolants'));

      for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
      begin
        A := aGP.VertexInput.Attributes.Items[I];
        if not Assigned(A) then continue;
        if AttIsPosition(A.AttType) then continue;

        VarName := AttInterpolantName(A.AttType, Loc);
        SB.AppendLine(Format('    %s = %s;', [VarName, A.Name]));
        Inc(Loc);
      end;
    end;

    //?? point size ???????????????????????????????????????????????????????????
    if UsePoints then
    begin
      SB.AppendLine('');
      SB.AppendLine('    if (POINT_SIZE_ON) {');
      SB.AppendLine('        // TODO: drive point size from a UBO or push constant');
      SB.AppendLine('        gl_PointSize = 4.0;');
      SB.AppendLine('    }');
    end;

    SB.AppendLine('}');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [MAIN]  Fragment main()
//
//  Deterministic parts:
//    • Texture sample when a TvgDescriptor_Texture is present in GraphicPipeRes
//    • Multi-render-target zero-fill for extra color outputs
//    • ObjectID write branch when GP.ObjectIDON
//
//  Stub parts:
//    • Actual lighting / shading calculation
//
//  Outputs magenta (1,0,1,1) as a visible "not implemented" signal when
//  no texture is present.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_FragmentMain(aGP: TvgGraphicPipeline;
                                          aSP: TvgSubPass): String;
var
  SB          : TStringBuilder;
  I           : Integer;
  DI          : TvgDescriptorItem;
  SamplerName : String;
  ColCount    : Integer;
  HasTexture  : Boolean;
begin
  SB          := TStringBuilder.Create;
  SamplerName := '';
  HasTexture  := False;

  // Detect first sampler in the GraphicPipeRes descriptor set
  if Assigned(aGP) and assigned(aGP.ObjectStore)and (RU_OBJECTSTORE in aGP.ObjectStore.ResourceUse) and
     Assigned(aGP.ObjectStore.ObjectStoreRes) and (aGP.ObjectStore.ObjectStoreRes.Descriptors.count>0) then
  begin
    for I := 0 to aGP.ObjectStore.ObjectStoreRes.Descriptors.Count - 1 do
    begin
      DI := aGP.ObjectStore.ObjectStoreRes.Descriptors.Items[I];
      if Assigned(DI) and (DI.Descriptor is TvgDescriptorArray_Texture) then
      begin
        SamplerName := DI.Name;
        HasTexture  := True;
        break;
      end;
    end;
  end;

  ColCount := 1;
  if Assigned(aSP) then
  begin
    ColCount := aSP.ColorAttachments.Count + aSP.ResolveAttachment.Count;
    if ColCount < 1 then ColCount := 1;
  end;

  try
    SB.AppendLine('void main()');
    SB.AppendLine('{');

    //?? primary color output ??????????????????????????????????????????????????
    if HasTexture then
    begin
      SB.AppendLine('    // TODO: verify fragTexCoord is declared as an interpolant above');
      SB.AppendLine('    vec4 texSample = texture(' + SamplerName + ', fragTexCoord);');
      SB.AppendLine('');
      SB.AppendLine('    // TODO: add lighting calculation here');
      SB.AppendLine('    outColor = texSample;');
    end else
    begin
      SB.AppendLine('    // TODO: replace with actual shading / material logic');
      SB.AppendLine('    // Magenta signals this shader has not been completed');
      SB.AppendLine('    outColor = vec4(1.0, 0.0, 1.0, 1.0);');
    end;

    //?? additional MRT outputs ?????????????????????????????????????????????????
    if ColCount > 1 then
    begin
      SB.AppendLine('');
      SB.AppendLine('    // TODO: fill additional G-Buffer render targets');
      for I := 1 to ColCount - 1 do
        SB.AppendLine(Format('    outColor%d = vec4(0.0);', [I]));
    end;

    //?? ObjectID output ????????????????????????????????????????????????????????
    if Assigned(aGP) and aGP.ObjectIDON then
    begin
      SB.AppendLine('');
      SB.AppendLine('    if (USE_OBJECTID) {');
      SB.AppendLine('        // Encode a per-object index into the picking buffer.');
      SB.AppendLine('        // TODO: supply objectIndex via push constant or UBO.');
      SB.AppendLine('        uint objectIndex   = 0u; // REPLACE with actual index');
      SB.AppendLine('        uint primitiveIndex = uint(gl_PrimitiveID);');
      SB.AppendLine('        outObjectID = uvec2(objectIndex, primitiveIndex);');
      SB.AppendLine('    }');
    end;

    SB.AppendLine('}');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  [FULL]  Geometry main() – complete pass-through
//
//  This is the only main() that requires zero application-specific logic.
//  The topology drives the vertex count, and every interpolant is forwarded
//  from the vertex-stage arrays to the fragment-stage scalars.
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.SB_GeometryMain(aGP: TvgGraphicPipeline): String;
var
  SB       : TStringBuilder;
  I        : Integer;
  A        : TvgVertexAttributeDesc;
  VarName  : String;
  MaxV     : Integer;
  Loc      : Integer;
begin
  SB   := TStringBuilder.Create;
  MaxV := 3;
  Loc  := 0;

  if Assigned(aGP) then
    MaxV := TopologyMaxVerts(aGP.InputAssembly.Topology);

  try
    SB.AppendLine('void main()');
    SB.AppendLine('{');
    SB.AppendLine(Format('    for (int i = 0; i < %d; i++)', [MaxV]));
    SB.AppendLine('    {');
    SB.AppendLine('        gl_Position = gl_in[i].gl_Position;');

    // Forward each interpolant from input array to output scalar
    if Assigned(aGP) then
    begin
      for I := 0 to aGP.VertexInput.Attributes.Count - 1 do
      begin
        A := aGP.VertexInput.Attributes.Items[I];
        if not Assigned(A) then continue;
        if AttIsPosition(A.AttType) then continue;

        VarName := AttInterpolantName(A.AttType, Loc);
        SB.AppendLine(Format('        %s = %sIn[i];',
                             [VarName, VarName]));
        Inc(Loc);
      end;
    end;

    SB.AppendLine('        EmitVertex();');
    SB.AppendLine('    }');
    SB.AppendLine('    EndPrimitive();');
    SB.AppendLine('}');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  PRIMARY PUBLIC BUILD METHODS
//???????????????????????????????????????????????????????????????????????????????

//???????????????????????????????????????????????????????????????????????????????
//  BuildVertexShader
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.BuildVertexShader(aGP: TvgGraphicPipeline): String;
var
  SB       : TStringBuilder;
  GP       : TvgGraphicPipeline;
  UseDouble: Boolean;
  I        : Integer;
  OutCount    : Integer;
begin
  GP := ResolvedGP(aGP);

  if not Assigned(GP) then
  begin
    Result := '// ERROR: TvgShaderBuilder.Pipeline is not assigned' + sLineBreak;
    exit;
  end;

  if not (PS_VERTEX in GP.UseShaders) then
  begin
    Result := '';
    exit;
  end;

  // Detect USE_DOUBLE spec constant in the vertex module
  UseDouble := ModuleUsesDouble(GP.VertexS);


  for I := 0 to GP.VertexS.SpecialConst.Count - 1 do
    if SameText(GP.VertexS.SpecialConst.Items[I].Name, 'USE_DOUBLE') then
      UseDouble := True;

  SB := TStringBuilder.Create;
  try

    SB.Append(Cmt('------------------------------------------------------'));
    SB.Append(Cmt('VERTEX SHADER - generated by TvgShaderBuilder'));
    SB.Append(Cmt('Pipeline : ' + GP.Name));
    SB.Append(Cmt('------------------------------------------------------'));

    SB.AppendLine('');

    SB.Append(SB_Header(UseDouble, False, RequiresDescriptorIndexing(GP)));
    SB.Append(SB_SpecialisationConstants(GP.VertexS));         // [FULL]
    SB.Append(SB_GlobalSet(GP.Renderer));                               // [FULL]
    SB.Append(SB_PipeSet(GP, 1, 'Vertex'));                    // [INFRA]
    SB.Append(SB_VertexInputs(GP));                            // [FULL]
    SB.Append(SB_VertexOutputs(GP, OutCount));                    // [INFRA]
    SB.AppendLine('');
    SB.Append(SB_VertexMain(GP));                              // [MAIN]

    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  BuildGeometryShader
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.BuildGeometryShader(aGP: TvgGraphicPipeline): String;
var
  SB : TStringBuilder;
  GP : TvgGraphicPipeline;
begin
  GP := ResolvedGP(aGP);

  if not Assigned(GP) then
  begin
    Result := '// ERROR: TvgShaderBuilder.Pipeline is not assigned' + sLineBreak;
    exit;
  end;

  if not (PS_GEOMETRY in GP.UseShaders) then
  begin
    Result := '';
    exit;
  end;

  SB := TStringBuilder.Create;
  try

    SB.Append(Cmt('------------------------------------------------------'));
    SB.Append(Cmt('GEOMETRY SHADER - generated by TvgShaderBuilder'));
    SB.Append(Cmt('Pipeline : ' + GP.Name));
    SB.Append(Cmt('------------------------------------------------------'));

    SB.AppendLine('');

    SB.Append(SB_Header(False, True, RequiresDescriptorIndexing(GP)));
    SB.Append(SB_SpecialisationConstants(GP.GeometryS));       // [FULL]
    SB.Append(SB_GeomLayout(GP));                              // [FULL]
    SB.Append(SB_GlobalSet(GP.Renderer));                               // [FULL]
    SB.Append(SB_PipeSet(GP, 1, 'Geometry'));                  // [INFRA]
    SB.Append(SB_GeomInterface(GP));                           // [INFRA]
    SB.AppendLine('');
    SB.Append(SB_GeometryMain(GP));                            // [FULL]

    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  BuildFragmentShader
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.BuildFragmentShader(aGP: TvgGraphicPipeline;
                                               aSP: TvgSubPass): String;
var
  SB : TStringBuilder;
  GP : TvgGraphicPipeline;
  SP : TvgSubPass;
  InCount:Integer;
begin
  GP := ResolvedGP(aGP);
  SP := ResolvedSP(GP, aSP);

  if not Assigned(GP) then
  begin
    Result := '// ERROR: TvgShaderBuilder.Pipeline is not assigned' + sLineBreak;
    exit;
  end;

  if not (PS_FRAGMENT in GP.UseShaders) then
  begin
    Result := '';
    exit;
  end;

  SB := TStringBuilder.Create;
  try

      SB.Append(Cmt('------------------------------------------------------'));
    SB.Append(Cmt('FRAGMENT SHADER - generated by TvgShaderBuilder'));
    SB.Append(Cmt('Pipeline : ' + GP.Name));
    SB.Append(Cmt('------------------------------------------------------'));

    SB.AppendLine('');

    SB.Append(SB_Header(False, False, RequiresDescriptorIndexing(GP)));
    SB.Append(SB_SpecialisationConstants(GP.FragmentS));       // [FULL]
    SB.Append(SB_GlobalSet(GP.Renderer));                               // [FULL]
    SB.Append(SB_PipeSet(GP, 1, 'Fragment'));                  // [INFRA]
    SB.Append(SB_FragmentInputs(GP,InCount));                  // [INFRA]
    SB.Append(SB_FragmentOutputs(GP, SP));                     // [FULL]
    SB.AppendLine('');
    SB.Append(SB_FragmentMain(GP, SP));                        // [MAIN]

    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

//???????????????????????????????????????????????????????????????????????????????
//  BuildAll
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.BuildAll(aGP: TvgGraphicPipeline;
                                    aSP: TvgSubPass): TvgShaderBuildResult;
var
  GP       : TvgGraphicPipeline;
  SP       : TvgSubPass;
  BaseName : String;
  OutPath  : String;
begin
  GP := ResolvedGP(aGP);
  SP := ResolvedSP(GP, aSP);

  BaseName := '';
  if Assigned(GP) then BaseName := GP.Name;

  OutPath := fOutputPath;
  if OutPath = '' then OutPath := ShaderFolderPath;

// Vertex
  Result.Vert.GLSL        := BuildVertexShader(GP);
  Result.Vert.IsGenerated := Result.Vert.GLSL <> '';
  Result.Vert.SpvPath     := TPath.Combine(OutPath, BaseName + '_vert.spv');

  // Geometry
  Result.Geom.GLSL        := BuildGeometryShader(GP);
  Result.Geom.IsGenerated := Result.Geom.GLSL <> '';
  Result.Geom.SpvPath     := TPath.Combine(OutPath, BaseName + '_geom.spv');

  // Fragment
  Result.Frag.GLSL        := BuildFragmentShader(GP, SP);
  Result.Frag.IsGenerated := Result.Frag.GLSL <> '';
  Result.Frag.SpvPath     := TPath.Combine(OutPath, BaseName + '_frag.spv');

  // Sanity check: interpolant counts must agree between stages
  if Result.Vert.IsGenerated and Result.Frag.IsGenerated and
     (fLastVertexOutCount <> fLastFragmentInCount) then
    CustomAssert(False, Format('TvgShaderBuilder: vertex output count (%d) does not match ' +
      'fragment input count (%d) for pipeline "%s"',
      [fLastVertexOutCount, fLastFragmentInCount, BaseName]));
 end;

//???????????????????????????????????????????????????????????????????????????????
//  SaveSources  –  write .vert / .geom / .frag text files
//???????????????????????????????????????????????????????????????????????????????
procedure TvgShaderBuilder.SaveSources(const aResult: TvgShaderBuildResult);

  procedure WriteOne(const aStage: TvgShaderStageResult; const aExt: String);
  var
    Path: String;
  begin
    if not aStage.IsGenerated then exit;
    Path := ChangeFileExt(aStage.SpvPath, aExt);
    TFile.WriteAllText(Path, aStage.GLSL, TEncoding.UTF8);
  end;

var
  Dir: String;
begin
  Dir := fOutputPath;
  if Dir = '' then Dir := ShaderFolderPath;
  if not TDirectory.Exists(Dir) then
    TDirectory.CreateDirectory(Dir);

  WriteOne(aResult.Vert, '.vert');
  WriteOne(aResult.Geom, '.geom');
  WriteOne(aResult.Frag, '.frag');
end;

//???????????????????????????????????????????????????????????????????????????????
//  CompileAll  –  save sources then call OnCompile for every active stage
//???????????????????????????????????????????????????????????????????????????????
function TvgShaderBuilder.CompileAll(aGP: TvgGraphicPipeline;
                                      aSP: TvgSubPass): Boolean;
var
  R    : TvgShaderBuildResult;
  AllOK: Boolean;

  function TryStage(const aSP: TvgShaderStageResult; const aStageId: String): Boolean;
  begin
    Result := True;
    if not aSP.IsGenerated then exit;
    if not Assigned(fOnCompile) then exit;
    // aS.GLSL = source text; aS.SpvPath = output path
    Result := fOnCompile(aSP.GLSL, aStageId, aSP.SpvPath);
  end;

begin
  R     := BuildAll(aGP, aSP);
  SaveSources(R);

  AllOK := True;
  AllOK := TryStage(R.Vert, 'vert') and AllOK;
  AllOK := TryStage(R.Geom, 'geom') and AllOK;
  AllOK := TryStage(R.Frag, 'frag') and AllOK;

  Result := AllOK;
end;


end.
