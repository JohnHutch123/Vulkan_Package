Function TvgBaseRenderEngine.SetDisabled:Boolean;
begin
  Result := False;


  if assigned(fGlobalRes) then
    fGlobalRes.Active := False;

  // STEP 1: Clean up this renderer's GPs through the ObjectStore (proper owner path).
  //         This calls SP.RemoveGraphicPipe on each SubPass — SubPass must still be
  //         valid at this point, so this MUST run before fRenderPass.Active := False.
  if assigned(fBaseScene) then
    fBaseScene.DisConnectDataFromRenderer(self);


  CleanUpAndFreeWorkers;

  // STEP 2: Tear down RenderPass infrastructure. SubPass.SetDisabled now asserts
  //         fGraphicPipeList is empty — it should be, Step 1 emptied it.
  if assigned(fRenderPass) then
    fRenderPass.Active := False;

  Result := Inherited;
  CustomAssert(Result,Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);
end;


