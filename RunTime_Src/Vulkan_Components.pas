  I, L, WS             : Integer;
  RunStart, RunCount    : Integer;
  DD                    : TvgDescriptorData;
  DF                    : TvgDescriptorPerFrameData;
  BufInfos              : array of TVkDescriptorBufferInfo;
  ImgInfos              : array of TVkDescriptorImageInfo;
  AllowGaps             : Boolean;

  // Never had a TvgDescriptorData assigned at this position at all.
  // This is the ONLY thing PartiallyBound is about - it's a binding
  // layout property, fixed at VkDescriptorSetLayout creation time.
  function IsVacant(aIndex: Integer): Boolean;
  begin
    Result := (aIndex < 0) or (aIndex >= L) or (not Assigned(fDescriptorArray[aIndex]));
  end;

  // Assigned, but this frame's payload isn't built yet (still streaming,
  // multi-buffer upload lagging, etc). A transient per-frame condition,
  // never a layout/configuration problem - so never gated by PartiallyBound.
  function IsPendingUpload(aIndex: Integer): Boolean;
  begin
    Result := (not IsVacant(aIndex)) and (not Assigned(fDescriptorArray[aIndex].FrameData[aFrameIndex]));
  end;

  function HasPayload(aIndex: Integer): Boolean;
  begin
    Result := (not IsVacant(aIndex)) and Assigned(fDescriptorArray[aIndex].FrameData[aFrameIndex]);
  end;

  procedure FlushRun;
  var K: Integer;
  begin
    if RunCount = 0 then Exit;

    SetLength(BufInfos, RunCount);
    SetLength(ImgInfos, RunCount);

    for K := 0 to RunCount - 1 do
    begin
      BufInfos[K] := Default(TVkDescriptorBufferInfo);
      ImgInfos[K] := Default(TVkDescriptorImageInfo);

      DD := fDescriptorArray[RunStart + K];
      DF := DD.FrameData[aFrameIndex];
      DF.GetWriteDescriptorPayload(BufInfos[K], ImgInfos[K]);
    end;

    aSet.WriteToDescriptorSet(aBinding,
                              aArrayElement + TvkUint32(RunStart),
                              RunCount,
                              fDescriptorType,
                              ImgInfos,
                              BufInfos,
                              [],
                              False);

    SetLength(BufInfos, 0);
    SetLength(ImgInfos, 0);
    RunCount := 0;
  end;

begin
  L := Length(fDescriptorArray);
  if L = 0 then Exit;

  if aFrameIndex >= FrameCount then
     aFrameIndex := FrameCount - 1;

  WS        := Integer(GetDescriptorCountForWrite(aFrameIndex));
  AllowGaps := PartiallyBound;

  RunStart := -1;
  RunCount := 0;

  for I := 0 to WS - 1 do
  begin
    if HasPayload(I) then
    begin
      if RunCount = 0 then
         RunStart := I;
      Inc(RunCount);
    end
    else
    begin
      FlushRun;   // close out (and actually SEND) whatever valid run preceded this slot

      if IsVacant(I) then
        // Genuinely never-assigned slot - only acceptable if this binding
        // was explicitly declared gap-tolerant.
        CustomAssert(AllowGaps,
          Format('Descriptor array has an unwritten slot at index %d (binding %d) but PartiallyBound is not set', [I, aBinding]),
          Self);
      // else: IsPendingUpload(I) - assigned, just not ready for this frame.
      // Nothing to write yet; not an error, just move on.
    end;
  end;

  FlushRun;   // flush the trailing run, if any

end;


