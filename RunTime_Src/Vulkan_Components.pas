  TvgMemAvailable = record
       DEVICE_LOCAL_BIT,                            //< If otherwise stated, then allocate memory on device
       HOST_VISIBLE_BIT,                            //< Memory is mappable by host
       HOST_COHERENT_BIT,                           //< Memory will have i/o coherency. If not set, application may need to use vkFlushMappedMemoryRanges and vkInvalidateMappedMemoryRanges to flush/invalidate host cache
       HOST_CACHED_BIT,                             //< Memory will be cached by the host
       LAZILY_ALLOCATED_BIT,                        //< Memory may be allocated by the driver when it is required
       PROTECTED_BIT,
       DEVICE_COHERENT_BIT_AMD,
       DEVICE_UNCACHED_BIT_AMD,
       RDMA_CAPABLE_BIT_NV      :Boolean;
  end;

