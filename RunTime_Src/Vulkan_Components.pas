{ TvgBaseComponent }

function TvgBaseComponent.ApplyState( const ANewState: TvgComponentState): Boolean;
var
  OldState: TvgComponentState;
begin
  //Result := False;

  if fStateChanging then
    raise Exception.Create('Reentrant ApplyState');

  OldState := fState;

  if OldState = ANewState then
    Exit(True);

  if not CanTransition(OldState, ANewState) then
    Exit(False);

  fStateChanging := True;
  fRequestedState := ANewState;

  try
    DoStateChanging(OldState, ANewState);

    Result := ExecuteTransition(OldState, ANewState);

    if not Result then
    begin

      CustomAssert(Result, Format('Transition %s to %s failed in %s',[GetEnumName(TypeInfo(TvgComponentState), Ord(OldState)),
                                                                      GetEnumName(TypeInfo(TvgComponentState), Ord(aNewState)),
                                                                      ClassName]),self);


    //  ExecuteTransition(ANewState, OldState); // rollback  is dangerous
      Exit(False);
    end;

    fState := ANewState;

    DoStateChanged(OldState, ANewState);

    Result := True;

  finally
    fStateChanging := False;
  end;
end;


