constructor TvgCommandBuffer.Create;
begin
  inherited;
  fBufferState  := cbsINITIAL;
  fCommandLevel := CB_PRIMARY;
end;

destructor TvgCommandBuffer.Destroy;
begin
  SetActiveState(False);
  inherited;
end;

procedure TvgCommandBuffer.EndRecording;
begin

  RequireState([cbsRecording], 'Command requires Recording state');
  CustomAssert(IsValidHandle,'Vulkan Buffer handle not valid');

  fVulkanCommandBuffer.EndRecording;

  fBufferState := cbsExecutable;

end;


procedure TvgCommandBuffer.ExecuteCommand(const aQueue: TpvVulkanQueue;
  const aWaitDstStageFlags: TVkPipelineStageFlags;
  const aWaitSemaphore:TpvVulkanSemaphore;
  const aSignalSemaphore: TpvVulkanSemaphore;
  const aUseFence: boolean;
  const aDoWaitAndResetFence: boolean);

 // Var SingleUse : Boolean;

begin
  if (fCommandLevel <> CB_PRIMARY) then exit;  //cant execute a secondary commend


  RequireState([cbsExecutable], 'Command requires EXECUTABLE state');
  CustomAssert(IsValidHandle,'Vulkan Buffer handle not valid');


            fVulkanCommandBuffer.Execute(aQueue,
                                         aWaitDstStageFlags,
                                         aWaitSemaphore,
                                         aSignalSemaphore,
                                         fBufferFence,
                                         aDoWaitAndResetFence); //if a fence provided then wait on fence OR not

  If fIsSingleUse then
    fBufferState := cbsInvalid;

 (*

  if not assigned(fVulkanCommandBuffer) then exit;
  if (fVulkanCommandBuffer.Handle=VK_NULL_HANDLE) then exit;
  if NOT assigned(fBufferFence) then exit;


  SingleUse := IsSingleUseCommand;

  if (fBufferState=BS_PENDING) then
    SetBufferState(BS_EXECUTABLE);


  if (fBufferState=BS_EXECUTABLE) then
  Begin
    Try
       if aUseFence then
       Begin

            fVulkanCommandBuffer.Execute(aQueue,
                                         aWaitDstStageFlags,
                                         aWaitSemaphore,
                                         aSignalSemaphore,
                                         fBufferFence,
                                         aDoWaitAndResetFence); //if a fence provided then wait on fence OR not

            if SingleUse then
                SetBufferState(BS_INVALID)
            else
            if not aDoWaitAndResetFence then
            Begin
                SetBufferState(BS_PENDING);   //waiting to finish
                fFenceSet := True;
            end;

      end else
      Begin
            fVulkanCommandBuffer.Execute(aQueue,
                                         aWaitDstStageFlags,
                                         aWaitSemaphore,
                                         aSignalSemaphore,
                                         nil,
                                         False); //if a fence provided then wait on fence OR not

            if SingleUse then
                SetBufferState(BS_INVALID)
            else
            Begin
                //SetBufferState(BS_PENDING);   //waiting to finish
                fFenceSet := False;
            end;
      End;
    Except
      SetBufferState(BS_INVALID);
    End;
  End ;
 // else
 //   CustomAssert((fBufferState = BS_RECORDING) ,'Not valid Buffer State');
  *)
end;

