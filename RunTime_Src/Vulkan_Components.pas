procedure TvgDescriptorSet.BuildVariableDescriptorCounts;
var
  I, VarIndex: Integer;
  D: TvgDescriptorArray;
begin
  SetLength(fVariableDescriptorCounts, 0);

  VarIndex := GetVariableBindingIndex;
  if VarIndex = -1 then
    Exit;

  SetLength(fVariableDescriptorCounts, fFrameCount);
  D := fDescriptorCol.Items[VarIndex].Descriptor;

  for I := 0 to fFrameCount - 1 do
  begin
    if Assigned(D) then
      fVariableDescriptorCounts[I] := D.GetDescriptorCountForWrite(I)
    else
      fVariableDescriptorCounts[I] := 0;
  end;
end;

procedure TvgDescriptorSet.ClearDescriptorData(aFrameIndex: TvkUint32);
  Var I           : Integer;
      SD          : TvgDescriptorItem;
      D           : TvgDescriptorArray;
      B           : TvgCommandBuffer;
begin
  If not (fState=vgcsActive )then exit;

  If length( fVulkanDescriptorSets)=0 then exit;

  CustomAssert(Assigned(fVulkanDescriptorSets[aFrameIndex]),'Vulkan Descriptor Set not created',self);

  CustomAssert(Assigned(fLinker),'Linker not conected',self);
  CustomAssert(Assigned(fLinker.ScreenDevice),'Screen Device not conected',self);
  CustomAssert(Assigned(fLinker.ScreenDevice.VulkanDevice),'Screen Device not Active',self);

  If fDescriptorCol.Count = 0 then exit;

  SetCurrentFrame(aFrameIndex);

  CustomAssert(assigned(fDSGraphicCommandPool), 'Transfer Command Pool not assigned', Self);

  B := fDSGraphicCommandPool.AcquireUploadCommand(aFrameIndex);//  RequestCommand(aFrameIndex, CB_PRIMARY,  [BU_ONE_TIME_SUBMIT_BIT]) ;

  If assigned(B) then
  Begin
      B.Active := True;

      B.BeginRecordingPrimary;

      For I := 0 to fDescriptorCol.Count - 1 do
      Begin

        SD := fDescriptorCol.Items[I];
        If not SD.Active then
           SD.Active := True;

        D := SD.Descriptor;
        If assigned(D) then
          D.ClearDescriptor(B) ;

      End;

      B.EndRecording;

      If B.fCommandCount>0 then
      Begin
        B.ExecuteCommand( fLinker.ScreenDevice.VulkanDevice.GraphicsQueue,
                          TVkPipelineStageFlags(VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT),
                          nil, nil, true, true);
      End;

      fDSGraphicCommandPool.ReleaseCommand(B);     //ok
  End;

end;

procedure TvgDescriptorSet.ClearDescriptorSetLayout;
begin
  If assigned(fVulkanDescriptorSetLayout) then
     FreeAndNil(fVulkanDescriptorSetLayout);
  fSetCount:=0;
  SetLength(fCountArray,0);
  SetLength(fVariableDescriptorCounts, 0);

  fSetCurrent := False;
end;

