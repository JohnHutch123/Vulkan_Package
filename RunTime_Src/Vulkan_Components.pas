procedure TvgRenderWorker.BindDescriptors_DataStore;
begin
  If Not assigned(fCurrentPipe) then exit;
  If not fPipeBound then exit;

 // If not assigned(fCurrentNode) then exit;
  If not assigned(fGraphicCommandPool) then exit;
  If not assigned(fGraphicCommandPool.CommandBuffer[fFrameIndex]) then exit;


  fCurrentPipe.BindObjectStoreResources(fCurrentGraphicCommandBuffer,//fWorkerCommandPool.CommandBuffer[fFrameIndex],
                                           fWorkerIndex,
                                           fSubPassIndex,
                                           fTaskData.ObjectStore);

end;

procedure TvgRenderWorker.BindPipeLine;
begin

  If (fCurrentPipe<>Nil) and  (fCurrentPipe = fTaskData.GraphicPipe) and fPipeBound then exit;  //task pipe is currently bound

  fCurrentPipe :=  fTaskData.GraphicPipe;
  If Not assigned(fCurrentPipe) then
  Begin
    fPipeBound := False;
    exit;
  End;

  CustomAssert(assigned(fGraphicCommandPool),'Graphic Command NOT available');
  If not assigned(fCurrentGraphicCommandBuffer) then exit;

  If Not fCurrentPipe.fUseShaderObjects then

      fCurrentPipe.BindPipeline(fCurrentGraphicCommandBuffer,
                                fWorkerIndex,
                                fFrameIndex)
  else
      fCurrentPipe.BindShaderObjects(fCurrentGraphicCommandBuffer,
                                      fWorkerIndex,
                                      fFrameIndex)    ;

  fPipeBound := True;             //true if fCurrentPipe has been bound


end;

procedure TvgRenderWorker.BuildCommand;

begin

  CustomAssert(assigned(fTaskData.ObjectStore),'Object Data Store NOT assigned to Task');
  CustomAssert(assigned(fLinker),'Window Link NOT assigned');
  CustomAssert((fLinker.Active=True),'Window Link NOT Active');
  CustomAssert((fLinker.ScreenDevice.Active=True),'Screen Device NOT Active');

  CustomAssert(assigned(fCurrentGraphicCommandBuffer),'Working Command not created');
  CustomAssert(assigned(fCurrentPipe),'Current Pipet not linked');
  CustomAssert((fPipeBound=True), 'CurrentPipe NOT bound');

  If fCurrentGraphicCommandBuffer.BufferState=cbsRECORDING then


    fTaskData.ObjectStore.RecordVulkanCommand(fCurrentGraphicCommandBuffer,
                                             fCurrentPipe,
                                             fFrameIndex,
                                             fRenderCount );


end;

procedure TvgRenderWorker.UploadObjectStoreDataToVulkan;
begin
  CustomAssert(assigned(fTaskData.ObjectStore),'Data Store NOT assigned to Task');

  CustomAssert(assigned(fLinker),'Window Link not assigned to Worker');
  CustomAssert(assigned(fLinker.ScreenDevice),'Window Link Screen Device not assigned to Worker');
  CustomAssert(assigned(fLinker.ScreenDevice.VulkanDevice),'Window Link Screen Device not Active');

  CustomAssert(assigned(fTransferCommandPool),'Transfer Command Pool not assigned');

  If fTaskData.ObjectStore.GetDataDirty(fFrameIndex)  then
  Begin
    If assigned(fEngineCriticalSection) then fEngineCriticalSection.Acquire;

    Try
       fTaskData.ObjectStore.UploadAllData(fGraphicCommandPool, fFrameIndex);

    Finally
      If assigned(fEngineCriticalSection) then fEngineCriticalSection.Release;
    End;
  End;


end;

procedure TvgRenderWorker.UploadObjectStoreDataToVulkanInCommand;

Begin
  CustomAssert(assigned(fTaskData.ObjectStore),'Data Store NOT assigned to Task');

  CustomAssert(assigned(fLinker),'Window Link not assigned to Worker');
  CustomAssert(assigned(fLinker.ScreenDevice),'Window Link Screen Device not assigned to Worker');
  CustomAssert(assigned(fLinker.ScreenDevice.VulkanDevice),'Window Link Screen Device not Active');

  If not assigned(fCurrentGraphicCommandBuffer) or not fCurrentGraphicCommandBuffer.Active or
     (fCurrentGraphicCommandBuffer.fBufferState<>cbsRECORDING) then exit;


  If fTaskData.ObjectStore.GetDataDirty(fFrameIndex)  then
  Begin
    If assigned(fEngineCriticalSection) then fEngineCriticalSection.Acquire;

    Try
       fTaskData.ObjectStore.UploadAllDataUsingCommand(fCurrentGraphicCommandBuffer , fFrameIndex);
       //should use transfer buffer here

    Finally
      If assigned(fEngineCriticalSection) then fEngineCriticalSection.Release;
    End;
  End;
end;

