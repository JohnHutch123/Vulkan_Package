  fConstantID := Value;
end;

procedure TvgShaderSpecialisationItem.SetfSpecialisationType( const Value: TvgSpecialisationType);
begin
  If fSpecialisationType = Value then exit;

  fSpecialisationType := Value;

  Case fSpecialisationType  of
        TS_BOOLEAN :  SetfSpecialisationValue('False');
        TS_INTEGER :  SetfSpecialisationValue('0');
        TS_SINGLE  :  SetfSpecialisationValue('0.0');   //may use others later
  End;

end;

procedure TvgShaderSpecialisationItem.SetfSpecialisationValue( const Value: String);
  Var I : Integer;
      S : Single;
begin
  If CompareText(fSpecValueStr, Value) =0 then exit;

  Case fSpecialisationType  of
        TS_BOOLEAN :Begin
                      If (CompareText(Value,'True')=0) or
                         (CompareText(Value,'T')=0) then
                      Begin
                          fSpecValueStr := 'True';
                          fDataBoolean  := True;
                      end else
                      If (CompareText(Value,'False')=0) or
                         (CompareText(Value,'F')=0) then
                      Begin
                          fSpecValueStr := 'False' ;
                          fDataBoolean  := false  ;
                      end else
                      Begin
                          fSpecValueStr := 'False';
                          fDataBoolean  := false  ;
                      End;
                    end ;
        TS_INTEGER :Begin
                      Try
                        I:=StrToInt(Value) ;
                        fSpecValueStr := Value;
                        fDataInteger  := I;
                      Except
                        fSpecValueStr := '0';
                        fDataInteger  := 0;
                      End;
                    End;
        TS_SINGLE  :Begin
                      Try
                        S:=StrToFloat(Value) ;
                        fSpecValueStr := Value;
                        fDataSingle   := S;
                      Except
                        fSpecValueStr := '0.0';
                        fDataSingle   := 0.0;
                      End;
                    end;  //may use others later
  End;

  fShaderHeadStr := Format('layout(constant_id = %d) const bool %s = %s;',[self.Index, fName, fSpecValueStr])   ;
end;

procedure TvgShaderSpecialisationItem.SetName(const Value: String);
begin
  fName := Value;

  fShaderHeadStr := Format('layout(constant_id = %d) const bool %s = %s;',[self.Index, fName, fSpecValueStr])   ;
end;


