  fScreenDevice := Value;

  If assigned(fScreenDevice) then
  Begin
     fScreenDevice.FreeNotification(self);

     If assigned(fScreenDevice.PhysicalDevice) then
     Begin
       If assigned(fSurface) then
         fSurface.PhysicalDevice :=  fScreenDevice.PhysicalDevice;

       If assigned(fSwapChain) then
         fSwapChain.Device := fScreenDevice;
     End;
  end;

  If assigned(fScreenDevice) then
    fScreenDevice.AddLinker(self);
end;

