procedure TvgGraphicPipeline.SetRenderEngine(const Value: TvgBaseRenderEngine);
begin
  If fRenderEngine=Value then exit;

  SetActiveState(False);

  fRenderEngine  := Value;

  If assigned(fRenderEngine) and assigned(fRenderEngine.Linker) and assigned(fRenderEngine.Linker.ScreenDevice) and
     assigned(fObjectStore) then
  Begin

    fObjectStore.SetResourceLinker(fRenderEngine.Linker);
    fFrameCount :=  fRenderEngine.Linker.FrameCount;
  End;

  If assigned(fRenderEngine) then
  Begin
         fThreadCount  := fRenderEngine.fRenderWorkerCount;

         fRenderEngine.SetUpDepthAndMSAA(self);
  End;

end;

