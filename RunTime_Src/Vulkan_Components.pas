procedure TvgRenderPass.AddFrameToScreenSubPass;
    Var// MSAAon:Boolean;
            SP: TvgSubPass;
            A : TvgAttachment;
            AR: TvgSubPassAttachment;
            SD: TvgSubPassDependency;
            CF:Boolean;

    Function CheckForFrameAttachment:Boolean;
      Var I:Integer;
    Begin
      Result := False;
      if fAttachments.Count=0  then exit;
      for I := 0 to fAttachments.Count-1 do
         if fAttachments.Items[I].fType=atFrame then
         Begin
           Result := True;
           exit;
         End;
    End;

begin
  // build a sub pass to copy Frame to Screen
  CustomAssert(assigned(fLinker),'TvgRenderPass: Linker not connected',Self);
  if not (fLinker.RenderTarget=RT_FRAME) then exit;

  CF :=  CheckForFrameAttachment ;

  if CF then exit;

  SP:= fSubPasses.Add;  //sub pass #0

  CustomAssert(Assigned(SP),'SubPass not assigned',Self);

  SP.SubPassMode := SPT_OFFSCREENTOSCREEN;

  If (SP.PipelineBindPoint <>  BP_GRAPHICS) then
      SP.PipelineBindPoint :=  BP_GRAPHICS;

  SP.Name := 'FrameToScreen_1';

  //Screen Attachment Target for rendering
  A := fAttachments.Add;
  If assigned(A) then
  Begin
           A.Name              := 'FTSScreen_Attach_1';
           A.AttachType        := atFrame;//  screen image buffer

           If Assigned(SP) then
           Begin
             AR := SP.ColorAttachments.Add;

             If Assigned(AR) then
             Begin
               AR.Attachment := A;
               AR.Layout     := COLOR_ATTACHMENT_OPTIMAL;
             End;
           end;

        //SubPass Dependancy
          SD := fSubPassDependencies.add;

          If Assigned(SD) then
          Begin
            SD.Name             := 'FTSDependency_2';
            SD.SrcSubPass       := Nil;
            SD.DstSubpass       := SP;
            SD.SrcStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT];
            SD.DstStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT];
            SD.SrcAccessMask    := [];
            SD.DstAccessMask    := [COLOR_ATTACHMENT_WRITE_BIT,
                                    COLOR_ATTACHMENT_READ_BIT];
          end;   //dependency

  end;//screen

  //Frame should already be in attachments maybe check


end;

procedure TvgRenderPass.BuildStructure;

  Procedure BuildSimpleSubpass ;
  Begin

  End;

  Procedure BuildGBufferSubpass;
    Var MSAAon:Boolean;
            SP: TvgSubPass;
            A : TvgAttachment;
            AR: TvgSubPassAttachment;
            SD: TvgSubPassDependency;
            AttIndex : Integer;
  Begin

    SP:= fSubPasses.Add;  //sub pass #0

    CustomAssert(Assigned(SP),'SubPass not assigned',Self);

    SP.SubPassMode := SPT_G_BUFFER;

    If (SP.PipelineBindPoint <>  BP_GRAPHICS) then
        SP.PipelineBindPoint :=  BP_GRAPHICS;

    SP.Name        := 'G_BUFFER';
    SP.SubPassMode := SPT_G_BUFFER;   //correct for Scene data

    MSAAon :=  IsMSAAOn;

    If assigned(fLinker) and (fColourFormat=VK_FORMAT_UNDEFINED) and (fLinker.ImageFormat<>VK_FORMAT_UNDEFINED) then
       fColourFormat := fLinker.ImageFormat;
    AttIndex := 0;

    If MSAAon then
    Begin
      // 1. Create MSAA attachment FIRST
      A := fAttachments.Add;

      A.Name       := 'MSAA_Color';
      A.AttachType := atMSAA;
      A.AttachmentIndex := AttIndex;      //important
      inc(AttIndex);

      AR := SP.ColorAttachments.Add;
      AR.Attachment := A;
      AR.Layout     := COLOR_ATTACHMENT_OPTIMAL;

//SubPass Dependancy
        SD:=fSubPassDependencies.add;

        If Assigned(SD) then
        Begin
          SD.Name             := 'Dependency_1';
          SD.SrcSubPass       := Nil;
          SD.DstSubpass       := SP;
          If Not fDepthBufOn then
          Begin
            SD.SrcStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT];
            SD.DstStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT];
            SD.SrcAccessMask    := [];
            SD.DstAccessMask    := [COLOR_ATTACHMENT_WRITE_BIT, COLOR_ATTACHMENT_READ_BIT];
          End else
          Begin
            SD.SrcStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT, EARLY_FRAGMENT_TESTS_BIT];
            SD.DstStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT, EARLY_FRAGMENT_TESTS_BIT];
            SD.SrcAccessMask    := [];
            SD.DstAccessMask    := [COLOR_ATTACHMENT_WRITE_BIT, DEPTH_STENCIL_ATTACHMENT_WRITE_BIT];  //check
          End;
          SD.DependencyFlags    := [BY_REGION_BIT];

        end;   //dependency

      // 2. Create resolve attachment SECOND
      A := fAttachments.Add;

      case fLinker.RenderTarget of
        RT_SCREEN: A.AttachType := atScreen;
        RT_FRAME : A.AttachType := atFrame;
      end;
      A.AttachmentIndex := AttIndex;
      inc(AttIndex);

      AR := SP.ResolveAttachment.Add;
      AR.Attachment := A;
      AR.Layout     := COLOR_ATTACHMENT_OPTIMAL;


      //SubPass Dependancy
          SD := fSubPassDependencies.add;

          If Assigned(SD) then
          Begin
            SD.Name             := 'Dependency_2';
            SD.SrcSubPass       := Nil;
            SD.DstSubpass       := SP;
            If Not fDepthBufOn then
            Begin
              SD.SrcStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT];
              SD.DstStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT];
              SD.SrcAccessMask    := [];
              SD.DstAccessMask    := [COLOR_ATTACHMENT_WRITE_BIT, COLOR_ATTACHMENT_READ_BIT];
            End else
            Begin
              SD.SrcStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT, EARLY_FRAGMENT_TESTS_BIT];
              SD.DstStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT, EARLY_FRAGMENT_TESTS_BIT];
              SD.SrcAccessMask    := [];
              SD.DstAccessMask    := [COLOR_ATTACHMENT_WRITE_BIT, DEPTH_STENCIL_ATTACHMENT_WRITE_BIT];
              SD.DependencyFlags  := [BY_REGION_BIT];
            End;
          end;   //dependency
    End
    else
    Begin
      // Non-MSAA path
      A := fAttachments.Add;

      case fLinker.RenderTarget of
        RT_SCREEN: A.AttachType := atScreen;
        RT_FRAME : A.AttachType := atFrame;
      end;

      AR := SP.ColorAttachments.Add;
      AR.Attachment := A;

      A.AttachmentIndex := AttIndex;
      inc(AttIndex);

      //SubPass Dependancy
          SD := fSubPassDependencies.add;

          If Assigned(SD) then
          Begin
            SD.Name             := 'Dependency_2';
            SD.SrcSubPass       := Nil;
            SD.DstSubpass       := SP;
            If Not fDepthBufOn then
            Begin
              SD.SrcStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT];
              SD.DstStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT];
              SD.SrcAccessMask    := [];
              SD.DstAccessMask    := [COLOR_ATTACHMENT_WRITE_BIT, COLOR_ATTACHMENT_READ_BIT];
            End else
            Begin
              SD.SrcStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT, EARLY_FRAGMENT_TESTS_BIT];
              SD.DstStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT, EARLY_FRAGMENT_TESTS_BIT];
              SD.SrcAccessMask    := [];
              SD.DstAccessMask    := [COLOR_ATTACHMENT_WRITE_BIT, DEPTH_STENCIL_ATTACHMENT_WRITE_BIT];
              SD.DependencyFlags  := [BY_REGION_BIT];
            End;
          end;   //dependency


    End;


if MSAAon then
begin
  CustomAssert(SP.ColorAttachments.Count = 1,'Incorrect Color Attachment count',self);
  CustomAssert(SP.ResolveAttachment.Count = 1,'Incorrect Resolve Attachment count',self);
end;

  //DEPTH/Stencil Buffer
     If fDepthBufOn then
     Begin

         A := fAttachments.Add;
         If assigned(A) then
         Begin
           A.Name            := 'Depth/Stencil Attachment';
           A.AttachType      := atDepthStencil;

            A.AttachmentIndex := AttIndex;
          //  inc(AttIndex);


           If Assigned(SP) then
           Begin
             AR:= SP.DepthStencilAttachment.Add;
             If Assigned(AR) then
             Begin
               AR.Attachment:= A;
               AR.Layout    := DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
             End;

             SD:=fSubPassDependencies.add;
             If Assigned(SD) then
             Begin
                SD.Name             := 'Depth Dependency';
                SD.SrcSubPass       := Nil;
                SD.DstSubpass       := SP;

                SD.SrcStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT, EARLY_FRAGMENT_TESTS_BIT];
                SD.DstStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT, EARLY_FRAGMENT_TESTS_BIT];
                SD.SrcAccessMask    := [];
                SD.DstAccessMask    := [COLOR_ATTACHMENT_WRITE_BIT, DEPTH_STENCIL_ATTACHMENT_WRITE_BIT];

                SD.DependencyFlags  := [BY_REGION_BIT];
             end;   //dependency

           End;  //subpass
          End;   //attachment


     end;  //depth Buffer ON

  End;

  Procedure BuildOFFSCREENTOSCREENSubPass;
    Var     SP: TvgSubPass;
            A : TvgAttachment;
            AR: TvgSubPassAttachment;
            SD: TvgSubPassDependency;
  Begin

    SP:= fSubPasses.Add;

    CustomAssert(Assigned(SP),'SubPass not assigned',Self);

    SP.SubPassMode := SPT_OFFSCREENTOSCREEN;

    If (SP.PipelineBindPoint <>  BP_GRAPHICS) then
        SP.PipelineBindPoint :=  BP_GRAPHICS;

    SP.Name := 'CopySubPass';
    SP.SubPassMode := SPT_OFFSCREENTOSCREEN;

  //Screen attachment

    A := fAttachments.Add;
    If assigned(A) then
    Begin
      A.Name              := 'Screen_Attach_1';
      A.AttachType        := atScreen;//  screen image buffer

      If Assigned(SP) then
      Begin
        AR := SP.ColorAttachments.Add;

        If Assigned(AR) then
        Begin
          AR.Attachment := A;
          AR.Layout     := COLOR_ATTACHMENT_OPTIMAL;
        End;
      end;

    //SubPass Dependancy
      SD := fSubPassDependencies.add;

      If Assigned(SD) then
      Begin
        SD.Name             := 'Dependency_1';
        SD.SrcSubPass       := Nil;
        SD.DstSubpass       := SP;
        SD.SrcStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT];
        SD.DstStageMask     := [COLOR_ATTACHMENT_OUTPUT_BIT];
        SD.SrcAccessMask    := [];
        SD.DstAccessMask    := [COLOR_ATTACHMENT_WRITE_BIT, COLOR_ATTACHMENT_READ_BIT];

        SD.DependencyFlags  := [BY_REGION_BIT];
      end;   //dependency

    End;  //assigned A

  End;

begin

  CustomAssert(assigned(fSubPasses),'SubPass collection not created',Self);
  CustomAssert(assigned(fAttachments),'Attachment collection not created',Self);
  CustomAssert(assigned(fSubPassDependencies),'Dependancies collection not created',Self);

  if fSubPasses.Count>0 then exit;

  (*
      ( SPS_SIMPLE,              //used to render data straight to the screen
        SPS_G_BUFFER,
        SPS_LIGHTING,
        SPS_TRANSPARENCY,
        SPS_POST_PROCESS,
        SPS_SHADOW,
        SPS_OFFSCREENTOSCREEN,   //used to copy OffScreen image to the Screen
        SPS_UI                   //used to add User info Cursor/text to screen

  *)


  If (SPS_SIMPLE in fRenderPassSet )       then BuildSimpleSubpass;
  If (SPS_G_BUFFER in fRenderPassSet )     then BuildGBufferSubpass;
  If (SPS_LIGHTING in fRenderPassSet )     then ;
  If (SPS_TRANSPARENCY in fRenderPassSet ) then ;
  If (SPS_POST_PROCESS in fRenderPassSet ) then ;
  If (SPS_SHADOW in fRenderPassSet )       then ;
  If (SPS_OFFSCREENTOSCREEN in fRenderPassSet ) then BuildOFFSCREENTOSCREENSubPass;
  If (SPS_UI in fRenderPassSet )           then ;


end;


