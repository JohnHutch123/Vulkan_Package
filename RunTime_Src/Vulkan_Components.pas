procedure TvgDescriptorArray.SetPartiallyBound(const Value: Boolean);
begin
  if GetPartiallyBound = Value then Exit;

  if (not Value) and (fBindingMode = vgdbmFixedArray) and HasInteriorGap then
  begin
    CustomAssert(False,
      'Cannot clear PartiallyBound: this FixedArray binding currently has ' +
      'an unwritten interior slot. Fill the gap, or compact the array ' +
      '(RemoveAndFreeDescriptor), before disabling PartiallyBound.', Self);
    Exit;
  end;

  SetActiveState(False);   // fBindingFlags is baked into the layout once active

  if Value then
    Include(fIndexingOptions, dioPartiallyBound)
  else
    Exclude(fIndexingOptions, dioPartiallyBound);

  RebuildBindingFlags;
  RebuildLayoutFlags;
end;

