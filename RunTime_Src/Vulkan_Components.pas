function TvgBaseObjectStore.FreeGraphicPipeline(aRenderer: TvgBaseRenderEngine;   aSubPass: TvgSubPass): Boolean;
  Var R :TvgGraphicPipeRecord;
      GP:TvgGraphicPipeline;
      OS:TvgBaseObjectStore;
begin
  Result := False;

  If not assigned(aRenderer) then exit;
  If not assigned(aSubPass) then exit;

  If fGraphicPipes.Count = 0 then exit;

  R.Renderer := aRenderer;
  R.SubPass  := aSubPass;

 if fGraphicPipes.TryGetValue(R, GP) and assigned(GP) then
  begin
    if aSubPass.fGraphicPipeList.TryGetValue(GP, OS) then
      aSubPass.fGraphicPipeList.Remove(GP);

    if GP.Active then
      GP.Active := False;       // ← explicit, controlled deactivation first

    fGraphicPipes.Remove(R);    // doOwnsValues then frees the already-deactivated GP
    Result := True;
  end;
end;

