procedure TvgPhysicalDevice.Notification(AComponent: TComponent; Operation: TOperation);
begin
  inherited Notification(AComponent, Operation);

  case Operation of
    opInsert:
      begin
        if AComponent = Self then
          Exit;
        if NotificationTestON and not (csDesigning in ComponentState) then
          Exit;

        if (AComponent is TvgInstance) and not Assigned(fInstance) then
        begin
          InvalidateStates;
          TvgInstance(AComponent).AddDevice(Self);
        end;

        // Optional design-time auto-link
        if (AComponent is TvgLogicalDevice) and not Assigned(fLogicalDevice) then
          SetLogicalDevice(TvgLogicalDevice(AComponent));
      end;

    opRemove:
      begin
        if (AComponent is TvgInstance) and (TvgInstance(AComponent) = fInstance) then
        begin
          InvalidateStates;
          ClearPhysicalDevice;
          fInstance := nil;
        end;

        if (AComponent is TvgLogicalDevice) and (TvgLogicalDevice(AComponent) = fLogicalDevice) then
          SetLogicalDevice(nil);

        // If you also track screen device separately:
        if (AComponent is TvgScreenRenderDevice) and (TvgScreenRenderDevice(AComponent) = fScreenRenderDevice) then
        begin
          if fLogicalDevice = fScreenRenderDevice then
            SetLogicalDevice(nil)
          else
            fScreenRenderDevice := nil;
        end;
      end;
  end;
end;

