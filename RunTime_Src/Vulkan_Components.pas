function TvgSubPassCol.IndexOf(aItem: TvgSubPass): Integer;
Var I:Integer;
begin
  Result:=-1;
  If self.Count=0 then exit;
  If not assigned(aItem) then exit;
  For I:=0 to count-1 do
  Begin
    If Items[I]=aItem then
    Begin
      Result:=I;
      Exit;
    End;
  End;
end;

