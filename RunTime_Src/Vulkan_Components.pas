Function TvgResourceImageBuffer.SetDisabled: Boolean;
  Var Device         : TpvVulkanDevice;
begin
  Result := False;

  If assigned(fPixelSampler) then
  Begin
    fPixelSampler.Active := False;
    FreeAndNil(fPixelSampler);
  End;

  If assigned(fFrameBufferAttachment) then
  Begin
    FreeAndNil(fFrameBufferAttachment);
    fImage     := nil;
    fImageView := nil;
    //no need to free these objects as freed by the Attachment
  end else
  Begin      //handle the NO attachment
    FreeAndNil(fImage);
    FreeAndNil(fImageView);
  End;

  if assigned(fMemoryBlock) then
  begin
   CustomAssert(assigned(fLinker),'VulkanLink connection not set',Self);
   CustomAssert(assigned(fLinker.ScreenDevice),'VulkanLink Screen Device not set',Self);
   CustomAssert(assigned(fLinker.ScreenDevice.VulkanDevice),'VulkanLink Screen Device NOT active',Self);

   Device                        := fLinker.ScreenDevice.VulkanDevice;
   fMemoryBlock.AssociatedObject :=nil;
   Device.MemoryManager.FreeMemoryBlock(fMemoryBlock);
   fMemoryBlock                  :=nil;
  end;

  Result := Inherited;
  CustomAssert(Result=True, System.SysUtils.Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]) ,self);
end;

Function TvgResourceImageBuffer.SetEnabled : Boolean;
  Var   Device     : TpvVulkanDevice;
      aImageProps : TvgImageFormatProps;


  Procedure GetRequiredMemoryAndBind;
    Var MemoryRequirements           : TVkMemoryRequirements;
        RequiresDedicatedAllocation,
        PrefersDedicatedAllocation   : Boolean;
        MemoryBlockFlags             : TpvVulkanDeviceMemoryBlockFlags;

  Begin
    MemoryRequirements := Device.MemoryManager.GetImageMemoryRequirements(fImage.Handle ,
                                                                           RequiresDedicatedAllocation,
                                                                           PrefersDedicatedAllocation);

    MemoryBlockFlags:=[];

    if RequiresDedicatedAllocation or PrefersDedicatedAllocation then
      Include(MemoryBlockFlags,TpvVulkanDeviceMemoryBlockFlag.DedicatedAllocation);


    fMemoryBlock := Device.MemoryManager.AllocateMemoryBlock(MemoryBlockFlags,
                                                             MemoryRequirements.size,
                                                             MemoryRequirements.alignment,
                                                             MemoryRequirements.memoryTypeBits,
                                                             fMemoryProperty,//  TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT),
                                                             0,
                                                             0,
                                                             0,
                                                             0,
                                                             0,
                                                             0,
                                                             0,
                                                             fMemoryType,//TpvVulkanDeviceMemoryAllocationType.ImageOptimal,
                                                             @fImage.Handle);

    CustomAssert(Assigned(fMemoryBlock),'Memory Block not created.',Self);


   fMemoryBlock.AssociatedObject := self;

   VulkanCheckResult(Device.Commands.BindImageMemory(Device.Handle,
                                                          fImage.Handle,
                                                          fMemoryBlock.MemoryChunk.Handle,
                                                          fMemoryBlock.Offset));

  End;



begin

  Result := Inherited;
  CustomAssert(Result,System.SysUtils.Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);

   CustomAssert(assigned(fLinker),'VulkanLink connection not set',Self);
   CustomAssert(assigned(fLinker.SwapChain),'VulkanLink swapchain not set',Self);
   CustomAssert(assigned(fLinker.ScreenDevice),'VulkanLink Screen Device not set',Self);
   CustomAssert(assigned(fLinker.ScreenDevice.VulkanDevice),'VulkanLink Screen Device NOT active',Self);

   CustomAssert((fFormat <> VK_FORMAT_UNDEFINED),'Format is NOT set',Self);

   if (fImageWidth=0) or (fImageHeight=0) then exit;

   aImageProps.Format    := fFormat ;
   aImageProps.ImageType := fImageType;
   aImageProps.Tiling    := fImageTiling ;
   aImageProps.Usage     := fUsage ;
   aImageProps.Samples   := fSamples;


   If  NOT IsImageFormatSupported( fLinker.ScreenDevice.PhysicalDevice, aImageProps) then
   Begin
     //handle Format NOT supported;

     exit;
   end;



 Try

   Device := fLinker.ScreenDevice.VulkanDevice;

   fImage := TpvVulkanImage.Create(Device,
                                    0,
                                    fImageType,
                                    fFormat,
                                    fImageWidth,
                                    fImageHeight,
                                    fDepth,
                                    fMipLevels,
                                    fArrayLayers,
                                    fSamples,
                                    fImageTiling,
                                    fUsage,
                                    fSharingMode,
                                    0,
                                    Nil,
                                    fInitialLayout);

   CustomAssert(assigned(fImage), 'Image not created',Self);

  //assign memory and Bind to Image
   GetRequiredMemoryAndBind;

  //create ImageView
   fImageView := TpvVulkanImageView.Create(Device,
                                           fImage,
                                           fImageViewType,
                                           fFormat,
                                           fComponentRed,
                                           fComponentGreen,
                                           fComponentBlue,
                                           fComponentAlpha,
                                           fImageAspectFlags,
                                           fBaseMipLevel,
                                           fCountMipMapLevels,
                                           fBaseArrayLayer,
                                           fCountArrayLayers);

   CustomAssert(Assigned(fImageView) , 'Image View creation failed.',Self);

   If fFrameBufferAttachmentON then
   Begin

       fFrameBufferAttachment := TpvVulkanFrameBufferAttachment.Create(Device,
                                                                       fImage,
                                                                       fImageView,
                                                                        fImageWidth,
                                                                        fImageHeight,
                                                                       fFormat,
                                                                       True);
   end;

   If fPixelSamplerON  then
   Begin
      fPixelSampler              := TvgPixelSampler.create;
      fPixelSampler.SourceBuffer := self;
      fPixelSampler.Active       := True;
      fPixelSampler.SampleRadius := PixelSampleRadius;
   End;

   Result:=True;

 Except
    On EpvVulkanResultException do
    Begin
      Result := False;
      Raise;
