procedure TvgBaseScene.SetScreenDevice(const Value: TvgScreenRenderDevice);
  Var OldScreenDevice:TvgScreenRenderDevice;
begin
  If  fScreenDevice=Value then exit;
  SetActiveState(False);

  OldScreenDevice := fScreenDevice;
  If assigned(OldScreenDevice) then
  Begin
     OldScreenDevice.RemoveFreeNotification(self);
     fScreenDevice := Nil;
     If OldScreenDevice.fScene = Self then
       OldScreenDevice.fScene := Nil;
  End;

  fScreenDevice := Value;

  If assigned(fScreenDevice) then
  Begin
     fScreenDevice.FreeNotification(self);
     If fScreenDevice.fScene <> Self then
       fScreenDevice.fScene := Self;
  End;

end;



