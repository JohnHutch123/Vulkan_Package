procedure TvgCommandBuffer.SetCommandBufferLevel(  const Value: TvgCommandBufferLevel);
begin
  If fCommandLevel=Value then exit;
  SetActiveState(False);
  fCommandLevel:=Value;


end;

procedure TvgCommandBuffer.SetDisabled;
begin
  Inherited;

  If assigned(fVulkanCommandBuffer) then
     FreeAndNil(fVulkanCommandBuffer);

  if assigned(fBufferFence) then
     FreeAndNil(fBufferFence);

  fActive      := False;

  fBufferState := cbsInitial;
end;

procedure TvgCommandBuffer.SetEnabled;
  Var CL:TVkCommandBufferLevel;
begin
  Inherited;
  fActive := False;

  CustomAssert(assigned(fCommandPool),'Command Pool not assigned');
  CustomAssert(assigned(fCommandPool.fVulkanCommandPool),'Command Pool NOT Active');

  Case fCommandLevel of
       CB_PRIMARY   : CL:= VK_COMMAND_BUFFER_LEVEL_PRIMARY;
       CB_SECONDARY : CL:= VK_COMMAND_BUFFER_LEVEL_SECONDARY;
    else
       CL := VK_COMMAND_BUFFER_LEVEL_PRIMARY;
  End;

  if assigned(fCommandPool) and
     assigned(fCommandPool.Device) and
     assigned(fCommandPool.Device.VulkanDevice) and
     (CL = VK_COMMAND_BUFFER_LEVEL_PRIMARY) then
  Begin
    fBufferFence := TpvVulkanFence.Create(fCommandPool.Device.VulkanDevice, 0);  //not signaled
                                     //        TVkFenceCreateFlags(VK_FENCE_CREATE_SIGNALED_BIT)); //fence created in signaled state
    fFenceSet    := False;
  end;

  fVulkanCommandBuffer := TpvVulkanCommandBuffer.Create(fCommandPool.fVulkanCommandPool, CL);

  fActive      := True;
  fBufferState := cbsInitial;

end;

procedure TvgCommandBuffer.SetUseFlags(const Value: TvgCommandBufferUsageFlags);
  Var V: TVkCommandBufferUsageFlags;
begin
   V:=GetVKCommandBufferUsageFlags(Value);
   if fBufferUse=V then exit;
   SetActiveState(False);

   fBufferUse := V;

   fIsSingleUse:= (BU_ONE_TIME_SUBMIT_BIT in Value);

end;

procedure TvgCommandBuffer.ValidateRecordingState;
begin
if fBufferState <> cbsRECORDING then
    raise EvgVulkanException.Create('Command buffer must be in recording state');
end;

function TvgCommandBuffer.WaitOnFence: Boolean;
 // Var VR:TvkResult;
begin
  Result:=True;

  if not fFenceSet then
      Exit;

  if not assigned(fBufferFence) then exit;

  fBufferFence.WaitFor;    //Still waiting
  fBufferFence.Reset ;


  fFenceSet := False;

  if fBufferState =  cbsPending then
     fBufferState := cbsExecutable;


 (*
  If not fFenceSet then exit;

  if fCommandLevel<>CB_PRIMARY then exit;     //must be a PRIMARY command

  if not assigned(fBufferFence) then exit;

  fBufferFence.WaitFor;    //Still waiting
  fBufferFence.Reset ;

  fFenceSet := False;

 *)
(*
  VR := fBufferFence.GetStatus;
  case VR of
      VK_SUCCESS :    fBufferFence.Reset ;     //OK
      VK_NOT_READY :Begin
                      fBufferFence.WaitFor;    //Still waiting
                      fBufferFence.Reset ;
                    End;
    else                                      //something is wrong
      Result := False;
  end;
  *)
end;

