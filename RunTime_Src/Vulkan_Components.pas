  SetActiveState(False);

  If (Value = 0) or (Value>MaxFramesInFlight) then
     fFrameCount := MaxFramesInFlight
  else
     fFrameCount := Value;

  fCurrentFrameIndex := 0;

  SetUpArraysForFrameCount ;


end;

