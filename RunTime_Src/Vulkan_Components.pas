procedure TvgGraphicPipeline.BindPipeline(aCommandBuf: TvgCommandBuffer;  aWorkerIndex, aFrameIndex: TvkUint32);
  Var FrameIndex,
      WorkerIndex    : Integer;
begin
  If (fState = vgcsInactive) then exit;

  CustomAssert(assigned(fRenderEngine),'Renderer not assigned',Self);
  CustomAssert(assigned(fSubPass),'SubPass Index not assigned',Self);

  CustomAssert(assigned(aCommandBuf),'Command not assigned',Self);
  CustomAssert( Assigned(aCommandBuf.VulkanCommandBuffer),'Command Buffer NOT enabled',Self);

  WorkerIndex := aWorkerIndex;
  FrameIndex  := aFrameIndex;

   If (WorkerIndex < 0) or (WorkerIndex >= Length(fPipelineHandles)) then exit;
   If (FrameIndex  < 0) or (FrameIndex  >= Length(fPipelineHandles[WorkerIndex])) then exit;

  aCommandBuf.CmdBindPipeline(VK_PIPELINE_BIND_POINT_GRAPHICS,
                              fPipelineHandles[WorkerIndex,FrameIndex]);

  BindPipelineDescriptors(aCommandBuf,  aWorkerIndex);

end;

procedure TvgGraphicPipeline.BindPipelineDescriptors( aCommandBuf: TvgCommandBuffer;
                                                      aWorkerIndex: TvkUint32 );
  Var FrameIndex     : TvkUint32;
      DescriptHandle : Array Of TVkDescriptorSet;
      DCount,SN, I   : Integer;
    //  DW             : TVkWriteDescriptorSet ;
      aHandle        : TVkDescriptorSet;

begin

    If (fState = vgcsInactive) then exit;

    CustomAssert(assigned(aCommandBuf),'Command not assigned',Self);
    CustomAssert(assigned(fRenderEngine),'Renderer not assigned',Self);
    CustomAssert( Assigned(aCommandBuf.VulkanCommandBuffer),'Command Buffer NOT enabled',Self);

    FrameIndex  := fRenderEngine.Linker.PrepareFrameIndex;

    DCount:=0;
    I     :=0;
    SN    :=0;

   //important to keep Global Set bound here
    If  Assigned(fRenderEngine) and
        assigned(fRenderEngine.GlobalRes) and
        (fRenderEngine.GlobalRes.Descriptors.count>0) and
        (fRenderEngine.GlobalRes.Active) and
        (fRenderEngine.GlobalRes.fVulkanDescriptorSets[FrameIndex].handle<>VK_NULL_HANDLE) then
    Begin
      Inc(DCount);
      SetLength(DescriptHandle, DCount);
      DescriptHandle[I]:= fRenderEngine.GlobalRes.fVulkanDescriptorSets[FrameIndex].Handle;
      Inc(I);
    End;


   If assigned(fObjectStore) and
      fObjectStore.GetObjectStoreResourceDataHandle(FrameIndex, aHandle ) then
    Begin
      Inc(DCount);
      SetLength(DescriptHandle, DCount);
      DescriptHandle[I]:= aHandle;
    End;


   If DCount>0 then
   Begin
      aCommandBuf.CmdBindDescriptorSets(VK_PIPELINE_BIND_POINT_GRAPHICS,
                                             fPipelineLayoutHandle,    //important
                                             SN,                       //SET value IMPORTANT
                                             DCount,
                                             @DescriptHandle[0],
                                             0,
                                             nil);
      SetLength(DescriptHandle,0);
   end;

end;

