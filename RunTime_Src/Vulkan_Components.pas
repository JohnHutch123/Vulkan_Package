{ TvgGenericDescriptorObject<T> }

procedure TvgGenericDescriptorObject<T>.Add(const Item: T);
  var L:Integer;
begin
  If not assigned(Item)  then exit;
  L:=  Length(fObjectData) ;
  SetLength(fObjectData,L+1);
  fObjectData[L]:=Item;
end;

procedure TvgGenericDescriptorObject<T>.Clear;
  Var I:Integer;
begin
  If Length(fObjectData)=0 then exit;
  For I:=0 to Length(fObjectData) -1 do
    fObjectData[I].free;
  SetLength(fObjectData, 0);
end;

procedure TvgGenericDescriptorObject<T>.SetDescriptorCapacity(aCapacity: Integer);
  Var L:Integer;
begin
  L:=   Length(fObjectData)  ;

  If aCapacity> L  then
     SetLength( fObjectData, aCapacity)
  else
  If aCapacity< L then
  Begin
    L:= L-1;
    Repeat
      fObjectData[L].free;
      Dec(L);
    Until L = aCapacity-1;

    SetLength(fObjectData, aCapacity);
  End;
end;

