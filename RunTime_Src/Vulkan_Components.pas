function TvgBaseComponent.ExecuteTransition(const FromState, ToState: TvgComponentState): Boolean;
begin
  Result := False;

  case FromState of

    vgcsInactive:
      case ToState of
        vgcsDesign:
          Result := EnableDesigning;

        vgcsActive:
          Result := SetEnabled;
      end;

    vgcsDesign:
      case ToState of
        vgcsInactive:
          Result := DisableDesigning;

        vgcsActive:
        begin
          Result := DisableDesigning;
          if Result then
            Result := SetEnabled;
        end;
      end;

    vgcsActive:
      case ToState of
        vgcsInactive:
          Result := SetDisabled;

        vgcsDesign:
        begin
          Result := SetDisabled;
          if Result then
            Result := EnableDesigning;
        end;
      end;

  end;
end;

