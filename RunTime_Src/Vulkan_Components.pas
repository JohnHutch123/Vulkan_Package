begin
  If Value = fRenderPassSet then exit;
  SetActiveState(False);

  fRenderPassSet := Value;
  CheckAndFixSubValuesPassValues ;
end;

procedure TvgRenderPass.SetUpClearColorArray;
 Var //RPass : TvgRenderPass;
     CL,I:Integer;
      A : TvgAttachment;
begin
  CustomAssert(assigned(fLinker),'Vulkan Link not attached',Self);
//  CustomAssert(assigned(fRenderPass),'Render Pass not created',Self);

//  RPass :=  fLinker.RenderPass;

  CL := fAttachments.Count;

  SetLength(fClearColArray,CL);

  For  I:=0 to CL-1 do
  Begin
    A:=fAttachments.Items[I];
    Case A.fType of
        atScreen,
        atFrame,
        atColour,
        atMSAA :Begin
                    If assigned(fLinker.Surface) and assigned(fLinker.Surface.WindowIntf) then
                       fLinker.Surface.WindowIntf.vgWindowBackgroundColor(fClearColArray[I])
                    else
                    Begin
                      fClearColArray[I].color.float32[0]:= 0.0;
                      fClearColArray[I].color.float32[1]:= 0.0;
                      fClearColArray[I].color.float32[2]:= 0.0;
                      fClearColArray[I].color.float32[3]:= 1.0;
                    end;
                  end;
        atDepthStencil:Begin
                        fClearColArray[I].depthStencil.depth  := fDepthClear;
                        fClearColArray[I].depthStencil.stencil:= fStencilClear;
                       end;
        atCustom:Begin
                  end;       //a manual setup attachment resource
    else
    End;


  End;
end;

procedure TvgRenderPass.UpdateAttachmentFormats;
    Var I   : Integer;
          A : TvgAttachment;

begin

  if attachments.Count=0 then exit;
  if not assigned(fLinker) then exit;

  for I := 0 to attachments.Count-1 do
  Begin
    A := Attachments.Items[I];
    if assigned(A) then
    Begin
      if (A.fType in [atScreen, atFrame, atColour, atMSAA]) and
         (A.Format <> ColourFormat) then
          A.fImageFormatProp.Format := fColourFormat;  //OK
    End;


  End;

end;

procedure TvgRenderPass.UpdateWindowSize;
  Var A:TvgAttachment;
      I,L,J:Integer;

      Width,Height : TvkUint32;
begin
 CustomAssert(Assigned(fLinker),'Linker NOT assigned',Self);
 If fAttachments.Count=0 then exit;

 If fLinker.RenderTarget= RT_FRAME then
 Begin
    Width  := fLinker.fSwapChain.ImageWidth  * fLinker.FrameResolution;
    Height := fLinker.fSwapChain.ImageHeight * fLinker.FrameResolution;
 end else
 Begin
   Width  := fLinker.fSwapChain.ImageWidth;
   Height := fLinker.fSwapChain.ImageHeight;
 end;


 For I:=0 to self.fAttachments.Count-1 do
   Begin
     A:= fAttachments.Items[I];

     If assigned(A) then
     Begin
       A.fWidth := Width;
       A.fHeight:= Height;

       L:=Length(A.fImageBufferArray);

        If (L>0) then
        Begin
          for J := 0 to L-1 do
            if assigned(A.fImageBufferArray[I]) then
            Begin
               A.fImageBufferArray[J].fImageWidth  := Width;
               A.fImageBufferArray[J].fImageHeight := Height;
            End;
        End;

     End;
   End;

end;

procedure TvgRenderPass.SetLinker(const Value: TvgLinker);
begin
  If fLinker = Value then exit;
  SetActiveState(False);

  If assigned(fLinker) then
     RemoveFreeNotification(fLinker) ;

  fLinker := Value;

  If assigned(fLinker) then
     FreeNotification(fLinker) ;
end;

procedure TvgRenderPass.SetRenderEngine(const Value: TvgBaseRenderEngine);
begin
  If fRenderEngine = Value then exit;
  SetActiveState(False);

  If assigned(fRenderEngine) then
    fRenderEngine.RemoveFreeNotification(self);

  fRenderEngine := Value;

  If assigned(fRenderEngine) then
    fRenderEngine.FreeNotification(self);

end;

procedure TvgRenderPass.SetRequiredSamplingExtension;
begin
  CustomAssert(assigned(fLinker),'Linker not connected',Self);
  CustomAssert(assigned(fLinker.ScreenDevice),'Screen Device not assigned',Self);

end;

