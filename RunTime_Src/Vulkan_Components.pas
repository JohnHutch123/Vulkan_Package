   aMat.RawComponents[0,0]:=1.0;
   aMat.RawComponents[0,1]:=0.0;
   aMat.RawComponents[0,2]:=0.0;
   aMat.RawComponents[0,3]:=0.0;
   aMat.RawComponents[1,0]:=0.0;
