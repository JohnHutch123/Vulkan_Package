Procedure TvgDescriptorData.SetEnabled;
  Var I,L:Integer;
begin
  fActive := True;

  L:= Length(fFrameData);
  If L=0 then exit;
  For I:=0 to L-1 do
    fFrameData[I].SetActiveState(True);
end;

procedure TvgDescriptorData.SetFrameCount(aFrameCount: TvkUint32);
  Var L,I, FC:Integer;
begin
  L  := Length(fFrameData) ;
  FC := aFrameCount;

  SetActiveState(False);

  If (FC < L) then
  Begin
    Repeat
      dec(L);
      if (L>=0) and assigned(fFrameData[L]) then
         FreeAndNil(fFrameData[L]);
    Until L <= FC;

    SetLength(fFrameData,aFrameCount);
  End else
  If (FC>=L) then
  Begin
    If FC>L then
      SetLength(fFrameData,FC);

    For I:=0 to Length(fFrameData)-1 do
      If not assigned( fFrameData[I] ) then
          GetOrAddFrameDataObject(I);
  End;
end;

