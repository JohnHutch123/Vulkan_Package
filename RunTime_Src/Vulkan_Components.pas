procedure TvgCommandBuffer.PrepareForRecording;
begin
  If fIsSingleUse then
     Reset;

case fBufferState of
    cbsInitial:
      Exit;

    cbsRecording:
      raise Exception.Create('Cannot prepare: still recording');

    cbsExecutable:
      Reset;

    cbsPending:
      begin
        WaitOnFence;
        Reset;
      end;
  end;
end;

procedure TvgCommandBuffer.RequireState(const AExpected: array of TvgCommandBufferState; const AError: string);
var
  S: TvgCommandBufferState;
begin
  for S in AExpected do
    if fBufferState = S then
      Exit;

  raise
     Exception.CreateFmt( '%s (Current state: %d)', [AError, Ord(fBufferState)]  );
end;

procedure TvgCommandBuffer.Reset;
Begin

  If fIsSingleUse  or (fBufferState in [cbsExecutable, cbsPending, cbsInvalid])  then
  Begin
      // Ensure GPU is finished if pending
      if fBufferState = cbsPending then
        WaitOnFence;

     If assigned(fBufferFence)then
        fBufferFence.Reset;

      if vkResetCommandBuffer(fVulkanCommandBuffer.Handle, 0) <> VK_SUCCESS then
        raise Exception.Create('Failed to reset command buffer');

      fBufferState := cbsInitial;
      fCommandCount := 0;
  End;

