procedure TvgGraphicPipeline.UpdateConnections;
  Var SD:TvgScreenRenderDevice;
begin
  SD:=self.GetScreenDevice;
  CustomAssert(Assigned(SD),'Scren Device not assigned',Self);

  If assigned(fVertShader) then
