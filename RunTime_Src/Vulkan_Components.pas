function IsImageFormatSupported(aDevice          : TvgPhysicalDevice;
                                aImageFormatProp : TvgImageFormatProps):Boolean;
var
  imageFormatProps: TVkImageFormatProperties;
  resultCode: TVkResult;
  testInfo: TVkPhysicalDeviceImageFormatInfo2;
  props: TVkImageFormatProperties2;

  B1,B2:Boolean;
begin
   Result := False;

   If not assigned(aDevice) then exit;
   If not assigned(aDevice.Instance) then exit;
   B1:=False;
   B2:=False;

   If not assigned(aDevice.Instance.VulkanInstance) then
   Begin
     aDevice.Instance.applystate(vgcsDesign);
     B1:=True;
   End;

   If not assigned(aDevice.VulkanPhysicalDevice) then
   Begin
     aDevice.applystate(vgcsDesign);
     B2:=True;
   End;


  If (aDevice.Instance.UnPackedVersion.Major>=1) and (aDevice.Instance.UnPackedVersion.Minor<1)then
  Begin
      // Basic check with VkImageFormatProperties
      resultCode := vkGetPhysicalDeviceImageFormatProperties(aDevice.VulkanPhysicalDevice.handle,
                                               aImageFormatProp.Format,
                                               aImageFormatProp.ImageType,//VK_IMAGE_TYPE_2D,
                                               aImageFormatProp.Tiling,
                                               aImageFormatProp.Usage,    //TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) + , VK_IMAGE_USAGE_SAMPLED_BIT],
                                               0,
                                               @imageFormatProps);
      if resultCode <> VK_SUCCESS then
        Exit(False);

      If  (integer(aImageFormatProp.Samples) and integer(imageFormatProps.sampleCounts)) = 0 then
        Exit(false);

  end else
  Begin

  // For more detail (Vulkan 1.1+), use extended properties if available

      TestInfo := default(TVkPhysicalDeviceImageFormatInfo2) ;
      testInfo.sType   := VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2;
      testInfo.format  := aImageFormatProp.Format;
      testInfo.type_   := aImageFormatProp.ImageType;//VK_IMAGE_TYPE_2D;
      testInfo.tiling  := aImageFormatProp.Tiling;//VK_IMAGE_TILING_OPTIMAL;
      testInfo.usage   := aImageFormatProp.Usage;//VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT or VK_IMAGE_USAGE_SAMPLED_BIT;
      testInfo.flags   := 0;

      props := Default(TVkImageFormatProperties2);
      props.sType := VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2;

      resultCode := vkGetPhysicalDeviceImageFormatProperties2(aDevice.VulkanPhysicalDevice.handle, @testInfo, @props);

      if resultCode <> VK_SUCCESS then
        Exit(False);

      If  (integer(aImageFormatProp.Samples) and integer(Props.imageFormatProperties.sampleCounts)) = 0 then
        Exit(false);
  end;

  If B2 then aDevice.applystate(vgcsInactive);
  If B1 then aDevice.Instance.applystate(vgcsInactive);

  Result := True;
end;

class function TCollectionItemHelper.IsItemLoading(const Item: TCollectionItem): Boolean;
var
  OwnerObj: TPersistent;
begin
  Result := False;
  if Item = nil then Exit;
  if not assigned(Item.Collection) then exit;

  // TCollection.GetOwner returns the owning TPersistent (usually the component that
  // contains the collection). That owner is the one that participates in streaming.
  OwnerObj := Item.Collection.Owner;
  if (OwnerObj <> nil) and (OwnerObj is TComponent) then
    Result := csLoading in TComponent(OwnerObj).ComponentState
  else
    // If owner is not a TComponent we generally treat it as not loading
    Result := False;
end;

class function TCollectionItemHelper.IsItemNotLoading(const Item: TCollectionItem): Boolean;
begin
  Result := not IsItemLoading(Item);
end;


