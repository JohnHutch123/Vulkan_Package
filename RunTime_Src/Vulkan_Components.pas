  FreeGraphicPipes;

  If assigned(fRenderPass) then
     FreeAndNil(fRenderPass);

  If assigned(fGlobalRes) then
    FreeAndNil(fGlobalRes);

  If assigned(fRenderWorkers) then
  Begin
    CleanUpAndFreeWorkers;
    FreeAndNil(fRenderWorkers);
  End;


  inherited;
end;

