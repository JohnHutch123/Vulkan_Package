procedure TvgDescriptorArray.SetUploadFlag(aFrameIndex, aDescriptorIndex: TvkUint32; aValue: Boolean);
  Var DL,FL:Integer;
Begin

  DL:=  Length(fDescriptorArray);
  If  ( DL=0) or (aDescriptorIndex<0)  or (aDescriptorIndex>=DL) then exit ;

  FL:=  Length(fDescriptorArray[aDescriptorIndex].fFrameData);
  If  ( FL=0) or (aFrameIndex<0)  or (aFrameIndex>=FL) then exit ;

  If fDescriptorArray[aDescriptorIndex].fFrameData[aFrameIndex].UploadNeeded <> aValue then
     fDescriptorArray[aDescriptorIndex].fFrameData[aFrameIndex].UploadNeeded := aValue;

end;

procedure TvgDescriptorArray.SetUploadFlags;
  Var I,J, DC:Integer;
      DD : TvgDescriptorData;
begin
  If fFrameCount=0 then exit;
  DC :=  GetDescriptorCount ;


  If DC>0 then
    For I:=0 to DC-1 do
    Begin
      If (DF_UP in fDataFlow) then
      Begin
        DD:= self.fDescriptorArray[I];

        If assigned(DD) then
        Begin
          For J:=0 to Length(DD.fFrameData)-1 do
             DD.fFrameData[J].SetUploadNeeded(True);
        end;
      End;
    End;
end;

procedure TvgDescriptorArray.SetUploadNeeded(aFrameIndex, aDescriptorIndex: Integer; const Value: Boolean);
  Var DL,FL:Integer;
Begin

  DL:=  Length(fDescriptorArray);
  If  ( DL=0) or (aDescriptorIndex<0)  or (aDescriptorIndex>=DL) then exit ;

  FL:=  Length(fDescriptorArray[aDescriptorIndex].fFrameData);
  If  ( FL=0) or (aFrameIndex<0)  or (aFrameIndex>=FL) then exit ;

  If fDescriptorArray[aDescriptorIndex].fFrameData[aFrameIndex].UploadNeeded <> Value then
     fDescriptorArray[aDescriptorIndex].fFrameData[aFrameIndex].UploadNeeded := Value;

end;

procedure TvgDescriptorArray.SetVariableDescriptorCount(const Value: Boolean);
begin
  if Value then
  begin
    Include(fIndexingOptions, dioVariableDescriptorCount);
    fBindingMode := vgdbmVariableArray;
  end else
  begin
    Exclude(fIndexingOptions, dioVariableDescriptorCount);
    if fBindingMode = vgdbmVariableArray then
    begin
      fBindingMode := vgdbmFixedArray;
    end;
  end;

  RebuildBindingFlags;
  RebuildLayoutFlags;
end;


procedure TvgDescriptorArray.SyncPartiallyBoundWithGapState;
begin
  // A FixedArray can legitimately have unwritten slots between populated
  // ones. Whenever that's true, dioPartiallyBound must be set or
  // WriteDescriptorSet will refuse to write the binding. Never force it
  // OFF here — only ON when a gap is actually present.
  if (fBindingMode = vgdbmFixedArray) and HasInteriorGap then
    Include(fIndexingOptions, dioPartiallyBound);
end;

function TvgDescriptorArray.UnLockData(aFrame:Integer): Boolean;
  Var I:Integer;
begin
  If (aFrame<0) or (aFrame>=Length(fSection)) then
  Begin
    For I:= 0 to High(fSection) do
      fSection[I].Leave;
    Result      := True;
  End else
  Begin
    fSection[aFrame].Leave;
    Result      := True;
  End;
end;

procedure TvgDescriptorArray.UpLoadDescriptorData(aFrameIndex: TvkUint32; aGraphicPool, aTransferPool: TvgCommandBufferPool);
  Var I,L,Actual:Integer;
begin
  If not assigned(aGraphicPool) then exit;
  If not assigned(aTransferPool) then exit;

  L := self.GetDescriptorCountForWrite(aFrameIndex);//   Length(fDescriptorArray);
  If L=0 then exit;

  Actual := Length(fDescriptorArray);

  For I:= 0 to L-1 do
  If (I<Actual) and assigned(fDescriptorArray[I]) then
    fDescriptorArray[I].UpLoadDescriptorData(aFrameIndex, aGraphicPool, aTransferPool) ;

end;

function TvgDescriptorArray.ValidateDescriptorArray(out aError: String): Boolean;
var I: Integer;
    FoundGap: Boolean;
begin
  Result := True;
  aError := '';
  FoundGap := False;

  for I := 0 to BindingCount - 1 do
  begin
    if Assigned(GetDescriptorData(I)) then
    begin
      if FoundGap and (not PartiallyBound) then
      begin
        aError := Format('unwritten slot before index %d but PartiallyBound is not set', [I]);
        Result := False;
        Exit;
      end;
    end else
      FoundGap := True;
  end;
end;

function TvgDescriptorArray.ValidateIndexingOptions(out aError: String): Boolean;
begin
  Result := False;
  aError := '';

  if (fBindingMode = vgdbmSingle) and (fIndexingOptions <> []) then
  begin
    aError := 'IndexingOptions are not valid for single bindings.';
    Exit;
  end;

  if (dioVariableDescriptorCount in fIndexingOptions) and
     (fBindingMode <> vgdbmVariableArray) then
  begin
    aError := 'VariableDescriptorCount requires vgdbmVariableArray.';
    Exit;
  end;

  Result := True;
end;


