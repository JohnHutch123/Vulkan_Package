procedure TvgPhysicalDevice.SetInstance(const Value: TvgInstance);
begin
  if fInstance=Value then exit;

 InvalidateStates;
  If assigned(fInstance) then
  Begin
     fInstance.RemoveFreeNotification(self) ;
     fInstance.RemoveDevice(self);
     fInstance := Nil; //important
  end;

  if assigned(Value) then
    Value.AddDevice(self);

  If assigned(fInstance) then
  Begin
    fInstance.FreeNotification(self) ;
    fInstance.RenderToScreen := assigned(fScreenRenderDevice);
  end;
end;

procedure TvgPhysicalDevice.SetLogicalDevice(const Value: TvgLogicalDevice);
begin
  if fLogicalDevice = Value then
    Exit;

  InvalidateStates;

  // Stop listening for destruction of the previous logical device
  if Assigned(fLogicalDevice) then
    fLogicalDevice.RemoveFreeNotification(Self);

  fLogicalDevice := Value;

  // Screen-device special case (unchanged intent)
  if not Assigned(fScreenRenderDevice) and (fLogicalDevice is TvgScreenRenderDevice) then
  begin
    fScreenRenderDevice := TvgScreenRenderDevice(fLogicalDevice);
    if Assigned(fInstance) then
      fInstance.RenderToScreen := True;
  end;

  // Listen for destruction of the new logical device
  if Assigned(fLogicalDevice) then
  begin
    fLogicalDevice.FreeNotification(Self);

    // Keep reverse link consistent without re-entering if already set
    if fLogicalDevice.fPhysicalDevice <> Self then
      fLogicalDevice.fPhysicalDevice := Self;
  end;
end;
