function TvgBaseObjectStore.BuildAGraphicPipeline( aRenderer: TvgBaseRenderEngine; aSubPass: TvgSubPass): TvgGraphicPipeline;
var
  GP  : TvgGraphicPipeline;
  GPR : TvgGraphicPipeRecord;
begin
  Result := GetGraphicPipeline(aRenderer, aSubPass);
  if Assigned(Result) then exit;  // already built for this renderer/subpass

  GP := TvgGraphicPipeline.Create(nil);
  GP.ObjectStore := Self;
  GP.Renderer    := aRenderer;
  GP.SubPass     := aSubPass;

  // Phase 1: ObjectStore configures its own data
  ConfigureGraphicPipeline(GP);      // virtual — descendants add specialisations here

  // Phase 2: SubPass configures rendering mode
  aSubPass.SubPassConfigureGraphicPipeline(GP);

  // Phase 3: Renderer/RenderPass configures hardware context
  GP.Renderer := aRenderer;          // triggers SetRenderEngine
  aRenderer.ConfigureGraphicPipelineFromRenderPass(GP);

  UpdateGraphicPipeline(GP);

  GP.ValidStructure := True;

  GPR.Renderer := aRenderer;
  GPR.SubPass  := aSubPass;
  Result       := GP;
  fGraphicPipes.AddOrSetValue(GPR, Result);
  aSubPass.AddGraphicPipe(Self, Result);
end;


