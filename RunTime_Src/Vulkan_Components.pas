{TvgPixelSampler}

constructor TvgPixelSampler.Create;
begin
  inherited;

  // Initialize defaults
  fSampleRadius := psr_1x1;  // Single pixel by default
  fSampleSize := 1;
  fLastSampleX := -1;
  fLastSampleY := -1;

  // Transition image layout to TRANSFER_SRC_OPTIMAL
  FillChar(fimageBarrier, SizeOf(fimageBarrier), #0);
  fimageBarrier.sType := VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
  fimageBarrier.srcAccessMask := TVkAccessFlags(VK_ACCESS_SHADER_WRITE_BIT);
  fimageBarrier.dstAccessMask := TVkAccessFlags(VK_ACCESS_TRANSFER_READ_BIT);
  fimageBarrier.oldLayout := VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
  fimageBarrier.newLayout := VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
  fimageBarrier.srcQueueFamilyIndex := VK_QUEUE_FAMILY_IGNORED;
  fimageBarrier.dstQueueFamilyIndex := VK_QUEUE_FAMILY_IGNORED;
  fimageBarrier.subresourceRange.aspectMask := TVkImageAspectFlags(VK_IMAGE_ASPECT_COLOR_BIT);
  fimageBarrier.subresourceRange.baseMipLevel := 0;
  fimageBarrier.subresourceRange.levelCount := 1;
  fimageBarrier.subresourceRange.baseArrayLayer := 0;
  fimageBarrier.subresourceRange.layerCount := 1;

  // Restore barrier: returns image to its normal layout after readback
  FillChar(fRestoreBarrier, SizeOf(fRestoreBarrier), #0);
  fRestoreBarrier.sType               := VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
  fRestoreBarrier.srcAccessMask       := TVkAccessFlags(VK_ACCESS_TRANSFER_READ_BIT);
  fRestoreBarrier.dstAccessMask       := TVkAccessFlags(VK_ACCESS_SHADER_READ_BIT) or
                                         TVkAccessFlags(VK_ACCESS_SHADER_WRITE_BIT);
  fRestoreBarrier.oldLayout           := VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
  fRestoreBarrier.newLayout           := VK_IMAGE_LAYOUT_GENERAL;  // overwritten in SetEnabled
  fRestoreBarrier.srcQueueFamilyIndex := VK_QUEUE_FAMILY_IGNORED;
  fRestoreBarrier.dstQueueFamilyIndex := VK_QUEUE_FAMILY_IGNORED;
  fRestoreBarrier.subresourceRange.aspectMask     := TVkImageAspectFlags(VK_IMAGE_ASPECT_COLOR_BIT);
  fRestoreBarrier.subresourceRange.baseMipLevel   := 0;
  fRestoreBarrier.subresourceRange.levelCount     := 1;
  fRestoreBarrier.subresourceRange.baseArrayLayer := 0;
  fRestoreBarrier.subresourceRange.layerCount     := 1;

  // Copy region setup
  FillChar(fcopyRegion, SizeOf(fcopyRegion), #0);
  fcopyRegion.bufferOffset := 0;
  fcopyRegion.bufferRowLength := 0;
  fcopyRegion.bufferImageHeight := 0;
  fcopyRegion.imageSubresource.aspectMask := TVkImageAspectFlags(VK_IMAGE_ASPECT_COLOR_BIT);
  fcopyRegion.imageSubresource.mipLevel := 0;
  fcopyRegion.imageSubresource.baseArrayLayer := 0;
  fcopyRegion.imageSubresource.layerCount := 1;
  fcopyRegion.imageOffset.z := 0;
  fcopyRegion.imageExtent.depth := 1;
end;

