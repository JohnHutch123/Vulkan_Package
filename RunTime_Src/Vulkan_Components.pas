procedure TvgShaderSpecialisationItem.FillOutSpecializationInfo(var aInfo: TVkSpecializationInfo);
begin

  fSpecializationEntry := Default( TVkSpecializationMapEntry);
  fSpecializationEntry.constantID := Index;
  fSpecializationEntry.offset     := 0;
  Case fSpecialisationType of
        TS_BOOLEAN  : fSpecializationEntry.size := SizeOf(Boolean);
        TS_INTEGER  : fSpecializationEntry.size := SizeOf(Integer);
        TS_SINGLE   : fSpecializationEntry.size := SizeOf(Single);
  End;


  aInfo := Default(TVkSpecializationInfo);
  aInfo.mapEntryCount := 1;
  aInfo.pMapEntries   := @fSpecializationEntry;
  aInfo.dataSize      := fSpecializationEntry.size;
  Case fSpecialisationType of
        TS_BOOLEAN  : aInfo.pData := @fDataBoolean;
        TS_INTEGER  : aInfo.pData := @fDataInteger;
        TS_SINGLE   : aInfo.pData := @fDataSingle;
  End;

end;

