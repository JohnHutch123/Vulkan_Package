procedure TvgDescriptorSet.BuildDescriptorSetLayout;
var
  I, VDI: Integer;
  SD: TvgDescriptorArray;
  VD: TvgDescriptorEnumType;
  CountArrayL: Integer;
  BindingCount: TvkUint32;
  LayoutFlags: TVkDescriptorSetLayoutCreateFlags;

begin
  fSetCurrent := False;

  CustomAssert(Assigned(fLinker), 'Logical Device NOT assigned', Self);
  CustomAssert(Assigned(fLinker.ScreenDevice), 'Screen Device NOT assigned', Self);
  CustomAssert(Assigned(fLinker.ScreenDevice.VulkanDevice), 'Vulkan Logical Device NOT assigned', Self);

  if fDescriptorCol.Count = 0 then
    Exit;

  ValidateDescriptorBindings;
  ValidateDescriptorIndexingSupport;
  ValidateVariableDescriptorBindingRules;

  CountArrayL := Ord(High(TvgDescriptorEnumType)) - Ord(Low(TvgDescriptorEnumType)) + 1;
  SetLength(fCountArray, CountArrayL);
  FillChar(fCountArray[0], CountArrayL * SizeOf(TvkUint32), 0);
  fSetCount := 0;

  LayoutFlags := 0;
  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    SD := fDescriptorCol.Items[I].Descriptor;
    if Assigned(SD) then
      LayoutFlags := LayoutFlags or SD.LayoutFlags;
  end;

  fVulkanDescriptorSetLayout := TpvVulkanDescriptorSetLayout.Create(  Linker.ScreenDevice.VulkanDevice,
                                                                     layoutflags,
                                                                     UsesDescriptorIndexing    );

  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    if not Assigned(fDescriptorCol.Items[I].Device) or
       (fDescriptorCol.Items[I].Device <> Linker.ScreenDevice) then
        fDescriptorCol.Items[I].Device := Linker.ScreenDevice;

    SD := fDescriptorCol.Items[I].Descriptor;
    if Assigned(SD) then
    begin
      BindingCount := SD.GetDescriptorCountForLayout;

      fVulkanDescriptorSetLayout.AddBinding(  SD.Binding,
                                              SD.fDescriptorType,
                                              BindingCount,
                                              SD.fStageFlags,
                                              [],
                                              SD.BindingFlags
                                            );

      VD := GeTvgDescriptorType(SD.fDescriptorType);
      VDI := Ord(VD);
      Inc(fCountArray[VDI], SD.GetDescriptorCountForPool);
      Inc(fSetCount, BindingCount);
    end;
  end;

  fVulkanDescriptorSetLayout.Initialize;
  fSetCurrent := True;
end;

