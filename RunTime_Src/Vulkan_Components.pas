procedure TvgDescriptorCol.Update(Item: TCollectionItem);
var
  str: string;
  i: Integer;
begin
  inherited;
  // update everything in any case...
  str := '';
  for i := 0 to Count - 1 do
  begin
    str := str + String((Items [i] as TvgDescriptorItem).fName);
    if i < Count - 1 then
      str := str + '-';
  end;
  FCollString := str;
end;

