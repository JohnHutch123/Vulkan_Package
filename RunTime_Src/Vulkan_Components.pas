function TvgRenderWorker.BuildCommandAndStartRecording: Boolean;
  Var  SPI : TvkUint32;
begin

  fRenderCount := 0;

  fCurrentGraphicCommandBuffer   := fGraphicCommandPool.AcquireSecondaryCommand(fFrameIndex);

  If assigned(fCurrentGraphicCommandBuffer) and not fCurrentGraphicCommandBuffer.Active then
    fCurrentGraphicCommandBuffer.Active  := True;


  CustomAssert(assigned(fCurrentGraphicCommandBuffer),'Graphic Buffer NOT assigned');

  fCurrentGraphicCommandBuffer.Active := True;
  SPI :=  tvkUint32(fSubPassIndex);

  fCurrentGraphicCommandBuffer.BeginRecordingSecondary(fRenderer.Renderpass.RenderPassHandle,
                                                      SPI,
                                                      0,
                                                      false,
                                                      0,
                                                      0 );

  Result := (fCurrentGraphicCommandBuffer.fBufferState = cbsRECORDING);

end;

Function TvgRenderWorker.CompleteTask(aTask: TvgRenderTask):TvgRenderTaskStatus;

begin
 // Result := TS_NONE;

  CustomAssert(Assigned(fRenderer),'Renderer NOT assigned');
  CustomAssert(Assigned(fLinker),'Linker NOT assigned');

  If not fActive then
            SetActiveState(True);

  fTaskData :=  aTask;

  If fTaskData.TaskJob = TM_UPLOADRESOURCEDATA then
    CustomAssert(assigned(fTaskData.Resources),'Resource not assigned to Task')
  else
  If fTaskData.TaskJob = TM_RENDER_OBJECTSTORE then
    CustomAssert(assigned(fTaskData.ObjectStore),'Render Node not assigned to Task');

 //change Frame
  If (fFrame <> aTask.Frame) then
  Begin
      fCurrentPipe := Nil;
      fPipeBound   :=False;
      fCurrentGraphicCommandBuffer := Nil;
      fRecordingON := False;

      fFrame     := aTask.Frame;
      CustomAssert(assigned(fFrame),'Frame NOT connected');

      If assigned(fFrame) then
      Begin
        fFrameIndex    := fFrame.FrameIndex;

        If assigned(fGraphicCommandPool) and (fGraphicCommandPool.FrameIndex<>fFrameIndex) then
        Begin
           fGraphicCommandPool.FrameIndex := fFrameIndex;
           (*
           fCurrentWorkerCommandBuffer   := fWorkerCommandPool.AcquireSecondaryCommand(fFrameIndex);
           If assigned(fCurrentWorkerCommandBuffer) and not fCurrentWorkerCommandBuffer.Active then
              fCurrentWorkerCommandBuffer.Active  := True;
           *)
        End;

        If assigned(fTransferCommandPool) and (fTransferCommandPool.FrameIndex<>fFrameIndex) then
           fTransferCommandPool.FrameIndex := fFrameIndex;

      end else
        fFrameIndex:=0;
  End;

  //change Render SubPass
  If  (fSubPassIndex <> fTaskData.SubPassIndex) then
  Begin
    fCurrentPipe := Nil;
    fPipeBound   :=False;
    fCurrentGraphicCommandBuffer := Nil;
    fRecordingON := False;

    fSubPassIndex      := fTaskData.SubPassIndex;

  End;

  fFrameBufferHandle     := aTask.FrameBufferHandle;  //  fRenderer.ScreenFrameBufferHandle[fTaskData.ImageIndex]  ;  //check

  fEngineCriticalSection := fTaskData.CriticalSection;

  fRenderPassHandle      := fRenderer.RenderPass.fRenderPassHandle;

  Result := TS_WORKING;

 //ORDER and SEQUENCE  is IMPORTANT
 Try

  Case aTask.TaskJob of
  //main thread tasks
    TM_UPLOADRESOURCEDATA: Begin
    //called for each Resource
                             UploadResourceDataToVulkan;
                             Result := TS_COMPLETE;
                           End;

    TM_UPLOADOBJECTDATA        : Begin
    //called for each Node
                             CreateDataStoreBuffers(fLinker.ScreenDevice);
                             UploadObjectStoreDataToVulkan;
                             UploadObjectStoreResourceDataToVulkan;

                             Result := TS_COMPLETE;
                           End;

  //below are threaded tasks
    TM_BEGIN_RECORDING_FRAME    : Begin
     //called on each thread
                              fRecordingOn := BuildCommandAndStartRecording;

                              Result       := TS_COMPLETE;
                           End;

    TM_BIND_PIPELINE      : begin
    //called on each thread
                              If not fRecordingOn then
                              Begin
                                Result := TS_FAIL;
                                exit;
                              End;

                              BindPipeLine;
                              Result := TS_COMPLETE;
                           end;
    TM_RENDER_OBJECTSTORE  : Begin
    //Must be in recording state
    //called for each NODE and picked up by available thread
                              If not fRecordingOn then
                              Begin
                                Result := TS_FAIL;
                                exit;
                              End;

                              BindDescriptors_DataStore ;
                              BuildCommand;
                              Result := TS_COMPLETE;
                           End;
    TM_END_RECORDING_FRAME  : Begin
    //called on each thread
                             If fRecordingOn and EndCommandRecording then
                               Result       := TS_COMPLETE
                             else
                               Result       := TS_FAIL;
                             fRecordingOn := False;
                           End;

    TM_EXECUTE_SECONDARY : Begin
    //called on each thread
                             If EndCommandRecording then
                               fRecordingOn := False;
                             ExecuteSecondaryCommand   ;                     //called on each thread
                             Result := TS_COMPLETE;

                           End;

    TM_RESET             : Begin
    //called on each thread
                           //  Result                := TS_COMPLETE;
                             fCurrentPipe          := Nil;
                              fPipeBound           :=False;
                             fCurrentGraphicCommandBuffer := nil;
                             FillChar(fTaskData,SizeOf(fTaskData),#0);
                             fRecordingON          := False;
                              Result               := TS_COMPLETE;
                           End;
  end;

 Except
    On E:Exception do
    Begin
      Result := TS_FAIL;
    End;
 End;

end;

constructor TvgRenderWorker.Create(aWorkerIndex:Integer);
begin
  Inherited Create;

  fWorkerIndex           := aWorkerIndex;
  fEngineCriticalSection := nil;

end;

procedure TvgRenderWorker.CreateDataStoreBuffers(aDevice:TvgScreenRenderDevice);
begin
  CustomAssert(assigned(fTaskData.ObjectStore),'Object Store not assigned to Task');

  fTaskData.ObjectStore.CreateVulkanDataBuffers;
end;

procedure TvgRenderWorker.ActivateVulkanPipeline;
begin
  CustomAssert(assigned(fCurrentPipe),'Graphic pipeline not assigned to Worker');

  fCurrentPipe.Active := True;

end;

destructor TvgRenderWorker.Destroy;
begin
  SetActiveState(False); //must stay here

  inherited;

end;

procedure TvgRenderWorker.DisconnectSceneData;
begin
  fCurrentPipe := nil;
  fCurrentObject:=Nil;
  fPipeBound   :=False;
  fCurrentGraphicCommandBuffer := Nil;
  fFrameIndex  := 0;
  fSubPassIndex:= 0;
end;

function TvgRenderWorker.EndCommandRecording : Boolean;

begin
  Result := False;
  If not assigned(fCurrentGraphicCommandBuffer) then exit;
  if fCurrentGraphicCommandBuffer.fBufferState = cbsEXECUTABLE then
  Begin
    Result := True;
    Exit;
  End;

  fCurrentGraphicCommandBuffer.EndRecording;

  Result  := (fCurrentGraphicCommandBuffer.fBufferState in [cbsEXECUTABLE, cbsINITIAL]);

end;

procedure TvgRenderWorker.ExecuteSecondaryCommand;

begin
  CustomAssert(assigned(fCurrentGraphicCommandBuffer),'Working command buffer not assigned');
  CustomAssert(assigned(fFrame),'Frame not assigned');
  CustomAssert(assigned(fFrame.FrameCommandBuffer),'Frame Command Buffer not assigned');

   //execute worker commande
  If assigned(fCurrentGraphicCommandBuffer) and
     assigned(fCurrentGraphicCommandBuffer.fVulkanCommandBuffer) and
     (fCurrentGraphicCommandBuffer.BufferState= cbsExecutable) then
  Begin
      If assigned(fEngineCriticalSection) then
         fEngineCriticalSection.Acquire;

    Try
     fFrame.FrameCommandBuffer.CmdExecuteCommands( 1, @fCurrentGraphicCommandBuffer.fVulkanCommandBuffer.Handle);
       //OK
    Finally

      If assigned(fEngineCriticalSection) then
         fEngineCriticalSection.Release;

    End;

  end;
end;

procedure TvgRenderWorker.SetDisabled;

begin

  If assigned(fTransferCommandPool) then
  Begin
    fTransferCommandPool.ReleaseAllCommands(True);
    fTransferCommandPool.Active := False;
    FreeAndNil(fTransferCommandPool);
  End;

  If assigned(fGraphicCommandPool) then
  Begin
    fGraphicCommandPool.ReleaseAllCommands(True);
    fGraphicCommandPool.Active := False;
    FreeAndNil(fGraphicCommandPool);
  End;

  fCurrentPipe                := nil;
  fPipeBound                  := False;
  fCurrentGraphicCommandBuffer := Nil;
  fFrameIndex                 := 0;
  fSubPassIndex               := 0;

  fActive := False;

end;

procedure TvgRenderWorker.SetEnabled;

begin
  CustomAssert(assigned(fLinker),'Window Link not assigned');

//  CustomAssert((fLinker.Active=True),'Window Link not Active');

  If Not assigned(fRenderer) then
     fRenderer := fLinker.Renderer;

  CustomAssert(assigned(fRenderer),'Renderer not assigned');
  CustomAssert(assigned(fRenderer.RenderPass),'Renderer Renderpass not assigned');

  fSubPassCount :=  fRenderer.RenderPass.SubPasses.count;
  If fSubPassCount=0 then
     fSubPassCount := 1;
  fSubPassIndex :=0;

  fFrameCount := fLinker.FrameCount;
  fFrameIndex := 0;

  If not assigned(fGraphicCommandPool) then
  Begin
    fGraphicCommandPool                 := TvgCommandBufferPool.Create(nil);
    fGraphicCommandPool.Device          := fLinker.ScreenDevice ;
    fGraphicCommandPool.Name            := 'GP';
    fGraphicCommandPool.SetSubComponent(True);
    fGraphicCommandPool.QueueFamilyType := VGT_GRAPHIC ;
    fGraphicCommandPool.QueueCreateFlags:= [CP_TRANSIENT, CP_RESET_COMMAND_BUFFER];
  End;

  fGraphicCommandPool.SetUpBufferArrays(fFrameCount);
  fGraphicCommandPool.Active   := True;

//  fGraphicFence    := TpvVulkanFence.Create(fLinker.ScreenDevice.VulkanDevice);

  If not assigned(fTransferCommandPool) then
  Begin
    fTransferCommandPool                 := TvgCommandBufferPool.Create(nil);
    fTransferCommandPool.Device          := fLinker.ScreenDevice ;
    fTransferCommandPool.Name            := 'TP';
    fTransferCommandPool.SetSubComponent(True);
    fTransferCommandPool.QueueFamilyType := VGT_TRANSFER ;
    fTransferCommandPool.QueueCreateFlags:= [CP_TRANSIENT, CP_RESET_COMMAND_BUFFER];
  End;

  fTransferCommandPool.SetUpBufferArrays(fFrameCount);
  fTransferCommandPool.Active:= True;

  fCurrentPipe := nil;
  fPipeBound   :=False;

  fActive := True;

end;

procedure TvgRenderWorker.SetRenderer(const Value: TvgBaseRenderEngine);
begin
  If fRenderer=Value then exit;
  SetActiveState(False);

  fRenderer := Value;
  If assigned(fRenderer) then
    fLinker   := fRenderer.linker
  else
    fLinker   := nil;
end;


