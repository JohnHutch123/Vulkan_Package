procedure TvgSubPass.ActivateGraphicPipelines;
  Var GP:TvgGraphicpipeline;
begin
  CustomAssert(assigned( fGraphicPipeList),'GraphicPipeline List NOT created');
  If fGraphicPipeList.Count=0 then exit;

  For GP in fGraphicPipeList.Keys do
  Begin
      If assigned(GP) and not GP.active then             //value CAN be null
        GP.Active := True;
  End;

end;

{ TvgRenderPassSubPass }

procedure TvgSubPass.AddGraphicPipe(aStore : TvgBaseObjectStore; aPipe: TvgGraphicPipeline);
  Var RP:TvgRenderPass;
begin
  If not assigned(aPipe) then exit;
  if not assigned(aStore) then exit;
  RP:=nil;

  If (fGraphicPipeList.count=0) or NOT fGraphicPipeList.ContainsKey(aPipe) then
  Begin
      If not assigned(aPipe.SubPass) then
        aPipe.SubPass  := Self;


      If not assigned(aPipe.Renderer) and assigned(RP) then
      Begin
         RP             := GetRenderPass;
         If assigned( RP) then
           aPipe.Renderer := RP.RenderEngine;
      End;

      fGraphicPipeList.AddOrSetValue(aPipe, aStore) ;
  end;

end;

procedure TvgSubPass.AddObjectStoreToCommand(aTask: TvgRenderTask; aRenderWorker: TvgRenderWorker);
   Var// J  : Integer;
       GP : TvgGraphicPipeline;
       ObjStr : TvgBaseObjectStore;
       PR : TPair<TvgGraphicPipeline, TvgBaseObjectStore>;
begin
  CustomAssert(Assigned(fGraphicPipeList),'fGraphicPipeList NOT assigned');
  If fGraphicPipeList.Count=0 then exit;

  For PR in fGraphicPipeList do     //Keys MUST exist
  Begin

    If assigned(PR.Value) then
    Begin
      ObjStr := PR.Value;
      GP     := PR.Key;

      If assigned(ObjStr) and (ObjStr.ObjectCount>0)  and Assigned(GP) then
      Begin

        GP.CurrentFrameIndex := TvgRenderPass(Collection.Owner).Linker.CurrentPrepareFrame.FrameIndex;

        GP.AddObjectStoreToCommand(aTask, aRenderWorker) ;

      end;
    End;
  end;

end;

