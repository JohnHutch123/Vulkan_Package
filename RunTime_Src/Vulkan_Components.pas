                                                  fAddressModeW,
                                                  fMipLodBias,
                                                  fAnisotropyEnable,
                                                  fMaxAnisotropy,
                                                  fCompareEnable,
                                                  fCompareOp,
                                                  fMinLod,
                                                  fMaxLod,
                                                  fBorderColor,
                                                  fUnnormalizedCoordinates,
                                                  fReductionMode   );


  End;
  Result := True;
end;

