{ TvgScene_Base }

procedure TvgBaseScene.ConnectRenderEngine(aRenderEngine: TvgBaseRenderEngine);
var
  Established : TvgPhysicalDevice;
  Incoming    : TvgPhysicalDevice;
begin
  if not Assigned(aRenderEngine)          then exit;
  if aRenderEngine.fBaseScene <> nil          then exit;
  if fRendererList.IndexOf(aRenderEngine) <> -1 then exit;

  // --- Device consistency check ---
  Established := GetEstablishedPhysicalDevice;
  Incoming    := aRenderEngine.GetPhysicalDevice;

  if Assigned(Established) and Assigned(Incoming) then
    CustomAssert(Established = Incoming,
      'TvgScene: all renderers must share the same TvgPhysicalDevice. ' +
      'Renderer "' + aRenderEngine.Name + '" uses a different device.',
      aRenderEngine);
  // If either is nil the renderer is not yet linked to a device
  // (design-time / late binding) — allow it through; the check
  // will fire when the renderer is activated via SetEnabled instead.

  fRendererList.Add(aRenderEngine);
  aRenderEngine.FreeNotification(self);
  FreeNotification(aRenderEngine);

  aRenderEngine.fBaseScene := Self;
end;

procedure TvgBaseScene.ClearScene;
  Var J :Integer;
begin
  If assigned(fSceneRes) then
    fSceneRes.FreeALLDescriptors;

  If assigned(fRendererList) and (fRendererList.Count>0) then
    for J := 0 to fRendererList.Count-1 do
       fRendererList.Items[J].ClearSceneLinks;

end;

constructor TvgBaseScene.Create(AOwner: TComponent);
begin
  inherited;

  fRendererList := TvgRendererList.Create;

  fSceneRes     := TvgDescriptorSet.Create(self);
end;

destructor TvgBaseScene.Destroy;
  Var I:Integer;
begin
  SetActiveState(False); //must stay here


  if assigned(fRendererList) then
  Begin

     If fRendererList.count>0 then
     Begin
       For I:=fRendererList.count-1 downto 0 do
         DisConnectRenderEngine( RendererList.items[I] );
     End;

     FreeAndNil(fRendererList);
  End;

  If assigned(fSceneRes) then
     FreeAndNil(fSceneRes);

  inherited;
end;

procedure TvgBaseScene.DisConnectRenderEngine(aRenderEngine: TvgBaseRenderEngine);
 Var I:Integer;
begin
  If not assigned(aRenderEngine) then exit;
  I:= fRendererList.IndexOf(aRenderEngine);
  If (I<0) then exit;

  aRenderEngine.fBaseScene := nil;
  aRenderEngine.RemoveFreeNotification(self);
  RemoveFreeNotification(aRenderEngine);

   if (fRendererList.IndexOf(aRenderEngine)<>-1) then
       fRendererList.Remove(aRenderEngine);
end;

procedure TvgBaseScene.FlagRenderRebuild;
  Var I:Integer;
      R : TvgBaseRenderEngine;
begin
  CustomAssert(assigned(fRendererList),'Renderer List NOT created',self);
  If  fRendererList.Count=0 then exit;
  For I:= 0 to fRendererList.count-1 do
  Begin
    R := fRendererList.Items[I] ;
    If assigned(R) then
       R.FlagRebuildALLFrames;

  End;
end;

// In TvgBaseScene (protected or public)
function TvgBaseScene.GetEstablishedPhysicalDevice: TvgPhysicalDevice;
var
  I : Integer;
  R : TvgBaseRenderEngine;
begin
  Result := nil;
  for I := 0 to fRendererList.Count - 1 do
  begin
    R := fRendererList.Items[I];
    if Assigned(R) then
    begin
      Result := R.GetPhysicalDevice;
      if Assigned(Result) then exit;  // first live one wins
    end;
  end;
end;

function TvgBaseScene.GetVulkanDevice: TpvVulkanDevice;
begin
  Result := Nil;

  If not assigned(fScreenDevice) then exit;
  If not assigned(fScreenDevice) then exit;
  If not assigned(fScreenDevice.VulkanDevice) then exit;

  Result := fScreenDevice.VulkanDevice;

end;

Function TvgBaseScene.Load_Begin:Boolean;
begin
  Result := False;

  If not (fSceneState = SS_READY) then exit;
  fSceneState := SS_LOADING;

  SetActiveState(False);

  ClearScene;

  Result := True;

end;

procedure TvgBaseScene.Load_End;
  Var
        I, J:Integer;
        RE:TvgBaseRenderEngine;
begin
  fSceneState := SS_READY;

  CustomAssert(Assigned(fRendererList),'Render List NOT created',self);
  If fRendererList.Count=0 then exit;

  For I:=0 to fRendererList.count-1 do
  Begin
    RE := fRendererList.Items[I] ;
    If assigned(RE) then
    Begin
      If assigned(RE.fGlobalRes) then
        RE.fGlobalRes.MarkAllDescriptorsDirty;

      If RE.active then
      Begin
        For J:=0 to RE.fGlobalRes.fFrameCount-1 do
          RE.fGlobalRes.UploadDescriptorSetData(J); // or loop 0..FrameCount-1

        BuildGraphicPipelinesForRenderer(RE) ;
        RE.ActivateGraphicPipeLines;

        SetActiveState(True);

        RE.FlagRebuildALLFrames;
        RE.TriggerWindowRepaint;

      end
    End;
  End;

end;

procedure TvgBaseScene.Notification(AComponent: TComponent;   Operation: TOperation);
  Var R:TvgBaseRenderEngine;
begin
  inherited Notification(AComponent, Operation);
  If aComponent=self then exit;

  Case Operation of
     opInsert : Begin
                  If aComponent=self then exit;

                  If NotificationTestON and Not (csDesigning in ComponentState) then exit;     //don't mess with links at runtime

                  If (aComponent is TvgBaseRenderEngine) and (Not assigned(TvgBaseRenderEngine(aComponent).fBaseScene)) then
                     ConnectRenderEngine(TvgBaseRenderEngine(aComponent)) ;

                  If (aComponent is TvgScreenRenderDevice) and not assigned(fScreenDevice) then
                     SetScreenDevice(TvgScreenRenderDevice(aComponent));

                End;
     opRemove : Begin

                  If (aComponent is TvgBaseRenderEngine) and (TvgBaseRenderEngine(aComponent).fBaseScene=self)  then
                  Begin
                    R:= TvgBaseRenderEngine(aComponent);

                    DisConnectDataFromRenderer(R);
                    DisConnectRenderEngine(R);
                  End;

                  If (aComponent is TvgScreenRenderDevice) and assigned(fScreenDevice) and (fScreenDevice=aComponent) then
                     SetScreenDevice(Nil);
                end;
  End;

end;

