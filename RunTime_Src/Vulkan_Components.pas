procedure TvgBaseRenderEngine.SetWorkerCount(const Value: TvkUint32);
  Var TC : TvkUint32;
begin
  If fRenderWorkerCount=Value then exit;
  SetActiveState(False);

  TC := TThread.ProcessorCount;
  If Value>TC then
     fRenderWorkerCount := TC-1
  else
     fRenderWorkerCount := Value;

  If fRenderWorkerCount=0 then
     fRenderWorkerCount := 1;

end;

{ TvgCommandPool }

function TvgCommandBufferPool.AcquireFrameCommand(  aFrameIndex: TvkUint32): TvgCommandBuffer;
begin
    Result := RequestCommand( aFrameIndex,
                              CB_PRIMARY,
                              [] // No one-time submit — reusable for frame commands
                            );
    If assigned(Result) then
    Begin
       Result.PrepareForRecording;
       If not Result.Active then
          Result.Active := True;
    End;
end;

function TvgCommandBufferPool.AcquireSecondaryCommand(aFrameIndex: TvkUint32; const aFlags : TvgCommandBufferUsageFlags=[]): TvgCommandBuffer;
//var
  //Cmd: TvgCommandBuffer;
begin

  Result := RequestCommand(aFrameIndex, CB_SECONDARY, [BU_RENDER_PASS_CONTINUE_BIT]);

  if Assigned(Result) then
     Result.PrepareForRecording;

end;

function TvgCommandBufferPool.AcquireUploadCommand(  aFrameIndex: TvkUint32): TvgCommandBuffer;
begin
    Result := RequestCommand( aFrameIndex,
                              CB_PRIMARY,
                              [  BU_ONE_TIME_SUBMIT_BIT ] // Auto-invalidates after submit
                            );

    If assigned(Result) then
    Begin
       Result.PrepareForRecording;
       If not Result.Active then
          Result.Active := True;
    End;
end;

constructor TvgCommandBufferPool.Create(AOwner: TComponent);
begin
  inherited Create(aOwner);

  fVulkanCommandPool := nil;
  fBufferCount       := 1;
  fCurrentBufferIndex:= 0;
  fQueueFamilyType   := VGT_GRAPHIC;
  fQueueCreateFlags  :=  TVkCommandPoolCreateFlags(VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT ) OR
                         TVkCommandPoolCreateFlags(VK_COMMAND_POOL_CREATE_TRANSIENT_BIT );
end;

procedure TvgCommandBufferPool.CreateBuffers;
var
  I   : Integer;
  Buf : TvgCommandBuffer;
begin
  CustomAssert(fBufferCount > 0, 'FrameCount must be > 0 before SetUpBufferArrays', Self);
  CustomAssert(assigned(fLogicalDevice), 'LogicalDevice must be assigned', Self);
  CustomAssert(assigned(fLogicalDevice.VulkanDevice), 'VulkanDevice must be active', Self);

  If not assigned(fVulkanCommandPool) then exit;

  If fBufferCount=0 then
     fBufferCount:=1;

  SetLength(fBuffers, fBufferCount);

  for I := 0 to fBufferCount - 1 do
  begin
    Buf := TvgCommandBuffer.Create;          // TvgCommandBuffer is already in your unit
    Buf.fCommandPool := self;   // assuming your TvgCommandBuffer exposes this field (or add a property if needed)
    Buf.CommandLevel := CB_PRIMARY;
  //  Buf.Active := True;

    fBuffers[I]      := Buf;
  end;
end;

procedure TvgCommandBufferPool.CreateVulkanPool;
var
  QueueIndex : TvkUint32;
begin
  CustomAssert(not assigned(fVulkanCommandPool), 'VulkanCommandPool already exists', Self);

  case fQueueFamilyType of
    VGT_GRAPHIC  : QueueIndex := fLogicalDevice.QueueGraphics.FamilyIndex;
    VGT_TRANSFER : QueueIndex := fLogicalDevice.QueueTransfer.FamilyIndex;
    VGT_COMPUTE  : QueueIndex := fLogicalDevice.QueueCompute.FamilyIndex;
    VGT_PRESENT  : QueueIndex := fLogicalDevice.QueuePresentation.FamilyIndex;
  else
    QueueIndex := 0;
  end;

  If Not assigned(fLogicalDevice.VulkanDevice) then exit;


  fVulkanCommandPool := TpvVulkanCommandPool.Create(fLogicalDevice.VulkanDevice,
                                                    QueueIndex,
                                                    fQueueCreateFlags);

end;

procedure TvgCommandBufferPool.DefineProperties(Filer: TFiler);
begin
  inherited DefineProperties(Filer);
  Filer.DefineProperty('CommandPoolData', ReadPoolData, WritePoolData, True);
end;

destructor TvgCommandBufferPool.Destroy;
begin
  SetActiveState(False); //must stay here

  DestroyBuffers;
  DestroyVulkanPool;

  inherited;
end;

procedure TvgCommandBufferPool.DestroyBuffers;
var
  I : Integer;
begin
  if Length(fBuffers) = 0 then Exit;

  for I := 0 to High(fBuffers) do
    if assigned(fBuffers[I]) then
    Begin
      fBuffers[I].Active := False;
      FreeAndNil(fBuffers[I]);
    End;

  SetLength(fBuffers, 0);
end;

procedure TvgCommandBufferPool.DestroyVulkanPool;
begin
if assigned(fVulkanCommandPool) then
  begin
    fVulkanCommandPool.Free;
    fVulkanCommandPool := nil;
  end;
end;

