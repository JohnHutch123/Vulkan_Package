procedure TvgDescriptorArray.SetUpArraysForFrameCount;
  Var I,L,J:Integer;
begin

  L:= Length(fSection) ;
  If L>0 then
    For I:=0 to L-1 do
       FreeAndNil(fSection[I]);

  SetLength(fSection, fFrameCount);
  for I := 0 to fFrameCount - 1 do
    fSection[I] := TCriticalSection.Create;

  L:=Length(fDescriptorArray);
  If L>0 then
  For I:= 0 to L-1 do
    If assigned(fDescriptorArray[I]) then
       fDescriptorArray[I].SetFrameCount(fFrameCount);

end;

Function TvgDescriptorArray.LockData(aFrame:Integer; aWaitFor: Boolean=False):Boolean;
  Var I:Integer;
begin
  Result:=False;

  If (aFrame<0) or (aFrame>=Length(fSection)) then
  Begin
    For I:=0 to High(fSection) do
    Begin
      If aWaitFor then
      Begin
         fSection[I].Enter ;
         Result := True;
      end else
         Result := fSection[I].TryEnter;
    End;
  End else
  Begin
      If aWaitFor then
      Begin
         fSection[aFrame].Enter ;
         Result := True;
      end else
         Result := fSection[aFrame].TryEnter;
  End;
end;

procedure TvgDescriptorArray.RebuildBindingFlags;
begin
  fBindingFlags := 0;

  if dioPartiallyBound in fIndexingOptions then
    fBindingFlags := fBindingFlags or TVkDescriptorBindingFlags(VK_DESCRIPTOR_BINDING_PARTIALLY_BOUND_BIT);

  if dioUpdateAfterBind in fIndexingOptions then
    fBindingFlags := fBindingFlags or TVkDescriptorBindingFlags(VK_DESCRIPTOR_BINDING_UPDATE_AFTER_BIND_BIT);

  if dioUpdateUnusedWhilePending in fIndexingOptions then
    fBindingFlags := fBindingFlags or TVkDescriptorBindingFlags(VK_DESCRIPTOR_BINDING_UPDATE_UNUSED_WHILE_PENDING_BIT);

  if dioVariableDescriptorCount in fIndexingOptions then
    fBindingFlags := fBindingFlags or TVkDescriptorBindingFlags(VK_DESCRIPTOR_BINDING_VARIABLE_DESCRIPTOR_COUNT_BIT);

  fExtendedBinding := fBindingFlags <> 0;
end;

procedure TvgDescriptorArray.RebuildLayoutFlags;
begin
  fLayoutFlags := 0;



  if dioUpdateAfterBind in fIndexingOptions then
    fLayoutFlags := fLayoutFlags or TVkDescriptorBindingFlags(VK_DESCRIPTOR_SET_LAYOUT_CREATE_UPDATE_AFTER_BIND_POOL_BIT);
end;

function TvgDescriptorArray.RemoveAndFreeDescriptor(  saDescriptor: TvgDescriptorData): Boolean;
  Var I,L:Integer;
begin
  Result := False;
  If not assigned(saDescriptor) then exit;

  L:=Length(fDescriptorArray);
  If L=0 then exit;

  For I:=0 to L-1 do
  Begin
    If fDescriptorArray[I] = saDescriptor then
    Begin
      FreeAndNil(fDescriptorArray[I]);
      fDescriptorArray[I] := fDescriptorArray[L-1] ;   //move last to here  assume index held
      SetLength(fDescriptorArray,L-1);
      Result := True;
      exit;
    End;
  End;
end;

