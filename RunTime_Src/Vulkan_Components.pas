function TvgDescriptorSet.GetUsesDescriptorIndexing: Boolean;
var I: Integer; D: TvgDescriptorArray;
begin
  Result := False;

  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    D := fDescriptorCol.Items[I].Descriptor;
    if Assigned(D) and D.UsesDescriptorIndexing then
    begin
      Result := True;
      Exit;
    end;
  end;

end;

function TvgDescriptorSet.GetUsesVariableDescriptorCount: Boolean;
begin
  Result := GetVariableBindingIndex <> -1;
end;

function TvgDescriptorSet.GetHighestBinding: TvkUint32;
var I: Integer; B: TvkUint32;
begin
  Result := 0;
  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    If assigned(fDescriptorCol.Items[I].Descriptor) then
    Begin
    B := fDescriptorCol.Items[I].Descriptor.BindingCount;
    if (I = 0) or (B > Result) then
      Result := B;
    End;
  end;
end;

function TvgDescriptorSet.GetVariableBindingIndex: Integer;
var I: Integer; D: TvgDescriptorArray;
begin
  Result := -1;
  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    D := fDescriptorCol.Items[I].Descriptor;
    if Assigned(D) and D.IsVariableCountBinding then
    begin
      Result := I;
      Exit;
    end;
  end;
end;

procedure TvgDescriptorSet.ValidateDescriptorBindings;
var
  I, J: Integer;
  DI, DJ: TvgDescriptorItem;
begin
  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    DI := fDescriptorCol.Items[I];
    CustomAssert(Assigned(DI), 'Descriptor item not assigned', Self);

    if Assigned(DI.Descriptor) then
    Begin
      DI.SyncDescriptorMetadata;

      for J := I + 1 to fDescriptorCol.Count - 1 do
      begin
        DJ := fDescriptorCol.Items[J];
        if Assigned(DJ) and assigned(DJ.Descriptor) and (DI.descriptor.Binding = DJ.descriptor.Binding) then
          raise EvgVulkanException.Create( 'Duplicate descriptor binding ' + IntToStr(DI.descriptor.Binding) + ' in set ' + Name );
      end;
    End;
  end;
end;

procedure TvgDescriptorSet.ValidateVariableDescriptorBindingRules;
var
  I, VarIndex: Integer;
  MaxBinding: TvkUint32;
  D: TvgDescriptorArray;
begin

  VarIndex := GetVariableBindingIndex;
  if VarIndex = -1 then
    Exit;

  MaxBinding := GetHighestBinding;

  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    D := fDescriptorCol.Items[I].Descriptor;
    if Assigned(D) and D.IsVariableCountBinding and (I <> VarIndex) then
      raise EvgVulkanException.Create('Only one variable descriptor binding is supported per set');
  end;

  D := fDescriptorCol.Items[VarIndex].Descriptor;
  if Assigned(D) and (D.Binding <> MaxBinding) then
    raise EvgVulkanException.Create( 'Variable descriptor count binding must be the highest binding in the set'  );
end;

procedure TvgDescriptorSet.ValidateDescriptorIndexingSupport;
var
  I: Integer;
  D: TvgDescriptorArray;
  Err: String;
  F: TvgFeatures;
begin

  if not GetUsesDescriptorIndexing then
    Exit;

  CustomAssert(Assigned(fLinker), 'Linker not assigned', Self);
  CustomAssert(Assigned(fLinker.ScreenDevice), 'Screen device not assigned', Self);
  CustomAssert(Assigned(fLinker.ScreenDevice.Features), 'Features not assigned on screen device', Self);

  F := fLinker.ScreenDevice.Features;

  CustomAssert(F.DescriptorIndexing, 'Descriptor indexing feature not enabled on device', Self);

 // check instance

  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    D := fDescriptorCol.Items[I].Descriptor;
    if not Assigned(D) then
      Continue;

    if not D.ValidateIndexingOptions(Err) then
      raise EvgVulkanException.Create('Invalid descriptor indexing options for ' + D.Name + ': ' + Err);

    if not D.ValidateDescriptorArray(Err) then
      raise EvgVulkanException.Create('Invalid descriptor array for ' + D.Name + ': ' + Err);

    if D.PartiallyBound then
      CustomAssert(F.DescriptorBindingPartiallyBound, 'PartiallyBound not supported', Self);

    if D.VariableDescriptorCount then
      CustomAssert(F.DescriptorBindingVariableDescriptorCount, 'VariableDescriptorCount not supported', Self);

    if D.UpdateUnusedWhilePending then
      CustomAssert(F.DescriptorBindingUpdateUnusedWhilePending, 'UpdateUnusedWhilePending not supported', Self);

    if D.UpdateAfterBind then
      CustomAssert( F.DescriptorBindingUniformBufferUpdateAfterBind or
                    F.DescriptorBindingSampledImageUpdateAfterBind or
                    F.DescriptorBindingStorageImageUpdateAfterBind or
                    F.DescriptorBindingStorageBufferUpdateAfterBind or
                    F.DescriptorBindingUniformTexelBufferUpdateAfterBind or
                    F.DescriptorBindingStorageTexelBufferUpdateAfterBind,
                    'UpdateAfterBind not supported by device features',
                    Self
                  );
  end;


end;

function TvgDescriptorSet.GetVulkanDescriptorSet( index: Integer): TpvVulkanDescriptorSet;
begin
  If (index<Low(fVulkanDescriptorSets)) or (index>High(fVulkanDescriptorSets)) then
    Result := nil
  else
    Result := fVulkanDescriptorSets[index]
end;

procedure TvgDescriptorSet.MarkAllDescriptorsDirty;
var
  I: Integer;
  D: TvgDescriptorArray;
begin
  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    D := fDescriptorCol.Items[I].fDescriptor;
    if Assigned(D) then
      D.SetUploadFlags; // sets fUploadNeeded[frame] = True for all frames
  end;
end;

procedure TvgDescriptorSet.SetCurrentFrame(const Value: TvkUint32);
  Var I:Integer;
      D:TvgDescriptorArray;
begin
 // If fCurrentFrameIndex = Value  then exit;  //Keep this disabled
  //DO NOT Disable here
  fCurrentFrameIndex := Value;

  If assigned(fDSGraphicCommandPool) then
     fDSGraphicCommandPool.FrameIndex  := fCurrentFrameIndex;

  If assigned(fDSTransferCommandPool) then
     fDSTransferCommandPool.FrameIndex := fCurrentFrameIndex;

  If fDescriptorCol.Count>0 then
  For I:=0 to fDescriptorCol.Count-1 do
  Begin
    D :=  fDescriptorCol.Items[I].Descriptor;
    If assigned(D) then
       D.CurrentFrame := fCurrentFrameIndex;
  End;
end;

procedure TvgDescriptorSet.UploadDescriptorSetData(aFrameIndex: TvkUint32);
var
  I,J: Integer;
  SD: TvgDescriptorItem;
  D: TvgDescriptorArray;
  NeedsReflush: Boolean;
  WriteCount: TvkUint32;

begin
  if not fSetCurrent then
    Exit;


  if fDescriptorCol.Count = 0 then
    Exit;

  SetCurrentFrame(aFrameIndex);

  CustomAssert(Assigned(fDSGraphicCommandPool), 'Graphic Command Pool not assigned', Self);
  CustomAssert(Assigned(fDSTransferCommandPool), 'Transfer Command Pool not assigned', Self);

  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    SD := fDescriptorCol.Items[I];
    if not SD.Active then
      SD.Active := True;
  end;

  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    SD := fDescriptorCol.Items[I];
    if Assigned(SD) and Assigned(SD.Descriptor) then
      SD.Descriptor.UpLoadDescriptorData( aFrameIndex,
                                          fDSGraphicCommandPool,
                                          fDSTransferCommandPool
                                        );

  end;

  NeedsReflush := False;

  if (aFrameIndex < TvkUint32(Length(fVulkanDescriptorSets))) and
     Assigned(fVulkanDescriptorSets[aFrameIndex]) then
     begin

    for I := 0 to fDescriptorCol.Count - 1 do
    begin
      SD := fDescriptorCol.Items[I];

      if Assigned(SD) then
        D := SD.Descriptor
      else
        D := nil;

      If assigned(D) and (D.active) then
      For J:=0 to Length(D.fDescriptorArray )-1 do      //for each descriptor

        if assigned(D.DescriptorData[J]) and
           assigned(D.DescriptorData[J].FrameData[aFrameIndex]) and
           (D.DescriptorData[J].FrameData[aFrameIndex].UploadNeeded) then
        begin
              WriteCount := D.GetDescriptorCountForWrite(aFrameIndex);

              if (WriteCount > 0) or (not D.PartiallyBound) then
              begin
                  D.WriteDescriptorSet(         fVulkanDescriptorSets[aFrameIndex],
                                                aFrameIndex,
                                                D.Binding,
                                                D.GetFirstArrayElementForWrite(aFrameIndex),
                                                vgdmWriteActiveRange  );
                  NeedsReflush := True;
              end;

              D.DescriptorData[J].FrameData[aFrameIndex].UploadNeeded := False;
        end;
    end;  //Descriptor Loop

    if NeedsReflush then
      fVulkanDescriptorSets[aFrameIndex].Flush;
  end;
end;

