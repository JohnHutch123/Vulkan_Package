procedure TvgDescriptorArray.SetBinding(const Value: TvkUint32);
begin
  if fBinding = Value then
    Exit;
  SetActiveState(False);
  fBinding := Value;
end;

procedure TvgDescriptorArray.SetBindingCount(const Value: TvkUint32);
var V: TvkUint32;
begin

  V := Value;
  if V = 0 then
    V := 1;

  if fBindingCount = V then   exit;

  SetActiveState(False);
  fBindingCount := V;

  if fBindingMode = vgdbmFixedArray then
  Begin
    EnsureDescriptorArraySize(fBindingCount);
    SyncPartiallyBoundWithGapState;
  End;

end;

procedure TvgDescriptorArray.SetBindingMode(const Value: TvgDescriptorBindingMode);
  Var OldState: TvgDescriptorBindingMode;
begin
  if fBindingMode = Value then
    Exit;
  SetActiveState(False);

  OldState:=  fBindingMode;
  fBindingMode := Value;

  case fBindingMode of
    vgdbmSingle:
    begin
      fBindingCount := 1;
      EnsureDescriptorArraySize(1);
      fIndexingOptions:=[];
    end;
    vgdbmFixedArray:
    begin
      if fBindingCount = 0 then
         fBindingCount := 1;
      EnsureDescriptorArraySize(fBindingCount);


      SyncPartiallyBoundWithGapState;

    end;
    vgdbmVariableArray:
    begin
      if fBindingCount = 0 then
        fBindingCount := 1;

      fIndexingOptions:=[];
      Include(fIndexingOptions, dioVariableDescriptorCount);
      Include(fIndexingOptions, dioPartiallyBound);   //optional

    end;
    vgdbmRuntimeArray:
    Begin
      fIndexingOptions :=[];
      Include(fIndexingOptions, dioRuntimeArray);
      // Runtime arrays almost always also want PartiallyBound
      Include(fIndexingOptions, dioPartiallyBound);

    End;
  end;  //case

  RebuildBindingFlags;
  RebuildLayoutFlags;

end;

