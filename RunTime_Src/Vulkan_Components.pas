constructor TvgFeatures.Create(AOwner: TComponent);
begin
  inherited;

  SetAllFeatures(False);

// Design-time: load only what the GPU actually supports
  if csDesigning in ComponentState then
     QuerySupportedFeatures;

end;

Function TvgFeatures.DisableDesigning: Boolean;
begin
  inherited;
  Result := True;
end;

function TvgFeatures.GetBoolean(aval: TVkBool32): Boolean;
begin
   If aVal=VK_TRUE then
      Result := TRUE
   else
      Result := FALSE;
end;

function TvgFeatures.GetLogicalDevice: TvgLogicalDevice;
begin
  Result := fLogicalDevice;
end;

function TvgFeatures.GetVK32Boolean(aval: Boolean): TVkBool32;
begin
   If aVal then
      Result := VK_TRUE
   else
      Result := VK_FALSE;
end;


procedure TvgFeatures.InternalLoadSupportedFeatures;
begin
  if not Assigned(fLogicalDevice) then Exit;
  if not Assigned(fLogicalDevice.PhysicalDevice) then Exit;
  if not Assigned(fLogicalDevice.PhysicalDevice.VulkanPhysicalDevice) then Exit;
  if fReadFeatures then Exit;

  QuerySupportedFeatures;  // reads from TpvVulkanPhysicalDevice — no Vulkan API call needed
end;

procedure TvgFeatures.QuerySupportedFeatures;
var
  PhysDevice : TpvVulkanPhysicalDevice;
  Ver        : TVkUInt32;
  B1,B2      : Boolean;
begin
 CustomAssert( Assigned(fLogicalDevice) , 'Logical Device NOT assigned',self);
 CustomAssert( Assigned(fLogicalDevice.PhysicalDevice) , 'Physical Device NOT assigned',self);
 CustomAssert( Assigned(fLogicalDevice.Instance) , 'Instance NOT assigned',self);

  If not assigned(fLogicalDevice.Instance.VulkanInstance) then
  Begin
    B1:=True;
    fLogicalDevice.Instance.SetDesignState(True)  ;
  End else
    B1:=False;

  If not assigned(fLogicalDevice.PhysicalDevice.VulkanPhysicalDevice) then
  Begin
    B2:=True;
    fLogicalDevice.PhysicalDevice.SetDesignState(True)  ;
  End else
    B2:=False;
 Try
  PhysDevice := fLogicalDevice.PhysicalDevice.VulkanPhysicalDevice;
  if not Assigned(PhysDevice) then Exit;

  Ver := PhysDevice.Properties.apiVersion and VK_API_VERSION_WITHOUT_PATCH_MASK;

  // 1.0 — always available

  fRequestedFeatures :=   PhysDevice.Features2KHR;

  frobustBufferAccess                     := GetBoolean(PhysDevice.Features.robustBufferAccess);
  ffullDrawIndexUint32                    := GetBoolean(PhysDevice.Features.fullDrawIndexUint32);
  fimageCubeArray                         := GetBoolean(PhysDevice.Features.imageCubeArray);
  findependentBlend                       := GetBoolean(PhysDevice.Features.independentBlend);
  fgeometryShader                         := GetBoolean(PhysDevice.Features.geometryShader);
  ftessellationShader                     := GetBoolean(PhysDevice.Features.tessellationShader);
  fsampleRateShading                      := GetBoolean(PhysDevice.Features.sampleRateShading);
  fdualSrcBlend                           := GetBoolean(PhysDevice.Features.dualSrcBlend);
  flogicOp                                := GetBoolean(PhysDevice.Features.logicOp);
  fmultiDrawIndirect                      := GetBoolean(PhysDevice.Features.multiDrawIndirect);
  fdrawIndirectFirstInstance              := GetBoolean(PhysDevice.Features.drawIndirectFirstInstance);
  fdepthClamp                             := GetBoolean(PhysDevice.Features.depthClamp);
  fdepthBiasClamp                         := GetBoolean(PhysDevice.Features.depthBiasClamp);
  ffillModeNonSolid                       := GetBoolean(PhysDevice.Features.fillModeNonSolid);
  fdepthBounds                            := GetBoolean(PhysDevice.Features.depthBounds);
  fwideLines                              := GetBoolean(PhysDevice.Features.wideLines);
  flargePoints                            := GetBoolean(PhysDevice.Features.largePoints);
  falphaToOne                             := GetBoolean(PhysDevice.Features.alphaToOne);
  fmultiViewport                          := GetBoolean(PhysDevice.Features.multiViewport);
  fsamplerAnisotropy                      := GetBoolean(PhysDevice.Features.samplerAnisotropy);
  ftextureCompressionETC2                 := GetBoolean(PhysDevice.Features.textureCompressionETC2);
  ftextureCompressionASTC_LDR             := GetBoolean(PhysDevice.Features.textureCompressionASTC_LDR);
  ftextureCompressionBC                   := GetBoolean(PhysDevice.Features.textureCompressionBC);
  focclusionQueryPrecise                  := GetBoolean(PhysDevice.Features.occlusionQueryPrecise);
  fpipelineStatisticsQuery                := GetBoolean(PhysDevice.Features.pipelineStatisticsQuery);
  fvertexPipelineStoresAndAtomics         := GetBoolean(PhysDevice.Features.vertexPipelineStoresAndAtomics);
  ffragmentStoresAndAtomics               := GetBoolean(PhysDevice.Features.fragmentStoresAndAtomics);
  fshaderTessellationAndGeometryPointSize := GetBoolean(PhysDevice.Features.shaderTessellationAndGeometryPointSize);
  fshaderImageGatherExtended              := GetBoolean(PhysDevice.Features.shaderImageGatherExtended);
  fshaderStorageImageExtendedFormats      := GetBoolean(PhysDevice.Features.shaderStorageImageExtendedFormats);
  fshaderStorageImageMultisample          := GetBoolean(PhysDevice.Features.shaderStorageImageMultisample);
  fshaderStorageImageReadWithoutFormat    := GetBoolean(PhysDevice.Features.shaderStorageImageReadWithoutFormat);
  fshaderStorageImageWriteWithoutFormat   := GetBoolean(PhysDevice.Features.shaderStorageImageWriteWithoutFormat);
  fshaderUniformBufferArrayDynamicIndexing:= GetBoolean(PhysDevice.Features.shaderUniformBufferArrayDynamicIndexing);
  fshaderSampledImageArrayDynamicIndexing := GetBoolean(PhysDevice.Features.shaderSampledImageArrayDynamicIndexing);
