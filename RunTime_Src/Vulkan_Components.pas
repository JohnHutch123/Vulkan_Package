procedure TvgLinker.AdvanceToNextFrames;
  Var L:Integer;
begin

  L :=  length(fFrames) ;
  if L<=1 then exit;

  Inc(fPrepareFrameIndex);

  If fPrepareFrameIndex >= L then
     fPrepareFrameIndex := 0;

  Inc(fPresentFrameIndex);

  If fPresentFrameIndex >= L then
     fPresentFrameIndex:=0;

  if Frame[fPresentFrameIndex].fFrameRenderLock then
     Frame[fPresentFrameIndex].fFrameRenderLock := False;  //check
end;

