procedure TvgDescriptorSet.WriteInitialDescriptorBindings(  aFrameIndex: TvkUint32; aSet: TpvVulkanDescriptorSet);
var
  J: Integer;
  SD: TvgDescriptorArray;
  WriteCount: TvkUint32;
begin
  for J := 0 to fDescriptorCol.Count - 1 do
  begin
    SD := fDescriptorCol.Items[J].Descriptor;
    if Assigned(SD) then
    begin
      WriteCount := SD.GetDescriptorCountForWrite(aFrameIndex);

      if (WriteCount > 0) or not SD.PartiallyBound then
      begin
        SD.WriteDescriptorSet( aSet,
                              aFrameIndex,
                              SD.Binding,
                              SD.GetFirstArrayElementForWrite(aFrameIndex),
                              vgdmWriteWholeBinding  );
      end;
    end;
  end;
end;

procedure TvgDescriptorSet.SetDescriptorCol(const Value: TvgDescriptorCol);
begin
  If not assigned(Value) then exit;
  SetActiveState(False);
  fDescriptorCol.Clear;
  fDescriptorCol.Assign(Value);
end;

Function TvgDescriptorSet.SetDisabled:Boolean;
  Var I:Integer;
      SD : TvgDescriptorArray;

begin
  Result := False;

  If assigned(fDSGraphicCommandPool) then
  Begin
    fDSGraphicCommandPool.ReleaseAllCommands(True);
    If fDSGraphicCommandPool.Active  then
       fDSGraphicCommandPool.Active := False;
    FreeAndNil(fDSGraphicCommandPool);
  End;

  If assigned(fDSTransferCommandPool) then
  Begin
    fDSTransferCommandPool.ReleaseAllCommands(True);
    If fDSTransferCommandPool.Active then
       fDSTransferCommandPool.Active := False;
    FreeAndNil(fDSTransferCommandPool);
  End;

  For I:=0 to fDescriptorCol.Count-1 do
  Begin
    SD:= fDescriptorCol.Items[I].fDescriptor;
    If assigned(SD) then
      SD.SetActiveState(False);
  End;


  For I:=0 to High(fVulkanDescriptorSets) do
    If assigned( fVulkanDescriptorSets[I]) then
       FreeAndNil(fVulkanDescriptorSets[I]);

  SetLength(fVulkanDescriptorSets,0);

  If assigned(fVulkanDescriptorPool) then
   FreeAndNil(fVulkanDescriptorPool);

   ClearDescriptorSetLayout;


  Result := Inherited;
  CustomAssert(Result,Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);

end;



function TvgDescriptorSet.SetEnabled: Boolean;
var
  I, L: Integer;
  V: TpvVulkanDescriptorSet;
  SD: TvgDescriptorArray;
  PoolFlags: TVkDescriptorPoolCreateFlags;
begin
  Result := False;

  BuildDescriptorSetLayout;  //will caryy out all checks and fail on exception if not OK
  CustomAssert(Assigned(fVulkanDescriptorSetLayout), 'Descriptor Set Layout not created', Self);

  Result := Inherited;
  CustomAssert(Result,Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);

  if fDescriptorCol.Count = 0 then
  begin
    Result := True;
    Exit;
  end;

  CustomAssert(Assigned(fLinker), 'Linker NOT assigned', Self);
  CustomAssert(Assigned(fLinker.ScreenDevice), 'Screen Device NOT assigned', Self);
  CustomAssert(Assigned(fLinker.ScreenDevice.VulkanDevice), 'Vulkan Logical Device NOT assigned', Self);

  fFrameCount := GetLinkerFrameCount;

  if not Assigned(fDSGraphicCommandPool) then
  begin
    fDSGraphicCommandPool := TvgCommandBufferPool.Create(nil);
    fDSGraphicCommandPool.SetSubComponent(True);
    fDSGraphicCommandPool.Name := 'DSG';
    fDSGraphicCommandPool.Device := fLinker.ScreenDevice;
    fDSGraphicCommandPool.QueueFamilyType := VGT_GRAPHIC;
    fDSGraphicCommandPool.QueueCreateFlags := [CP_TRANSIENT, CP_RESET_COMMAND_BUFFER];
    fDSGraphicCommandPool.SetUpBufferArrays(fFrameCount);
    fDSGraphicCommandPool.Active := True;
  end;

  if not Assigned(fDSTransferCommandPool) then
  begin
    fDSTransferCommandPool := TvgCommandBufferPool.Create(nil);
    fDSTransferCommandPool.SetSubComponent(True);
    fDSTransferCommandPool.Name := 'DST';
    fDSTransferCommandPool.Device := fLinker.ScreenDevice;
    fDSTransferCommandPool.QueueFamilyType := VGT_TRANSFER;
    fDSTransferCommandPool.QueueCreateFlags := [CP_TRANSIENT, CP_RESET_COMMAND_BUFFER];
    fDSTransferCommandPool.SetUpBufferArrays(fFrameCount);
    fDSTransferCommandPool.Active := True;
  end;

  PoolFlags := TVkDescriptorPoolCreateFlags(VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT);
  If fUpdateAftreBinding then
     PoolFlags := PoolFlags + TVkDescriptorPoolCreateFlags(VK_DESCRIPTOR_POOL_CREATE_UPDATE_AFTER_BIND_BIT);

  if UsesDescriptorIndexing then
  begin
    for I := 0 to fDescriptorCol.Count - 1 do
    begin
      SD := fDescriptorCol.Items[I].Descriptor;
      if Assigned(SD) and SD.UpdateAfterBind then
      begin
        PoolFlags := PoolFlags or TVkDescriptorPoolCreateFlags(VK_DESCRIPTOR_POOL_CREATE_UPDATE_AFTER_BIND_BIT_EXT);
        Break;
      end;
    end;
  end;

  fVulkanDescriptorPool := TpvVulkanDescriptorPool.Create( fLinker.ScreenDevice.VulkanDevice,
                                                          PoolFlags,
                                                          Integer(fFrameCount) * Max(1, fDescriptorCol.Count)
                                                        );

  L := Length(fCountArray);
  for I := 0 to L - 1 do
  begin
    if fCountArray[I] > 0 then
      fVulkanDescriptorPool.AddDescriptorPoolSize( GetVKDescriptorType(TvgDescriptorEnumType(I)),
                                                    fCountArray[I] * fFrameCount
                                                  );
  end;

  fVulkanDescriptorPool.Initialize;

  SetLength(fVulkanDescriptorSets, fFrameCount);

  for I := 0 to fDescriptorCol.Count - 1 do
  begin
    SD := fDescriptorCol.Items[I].Descriptor;
    if Assigned(SD) then
    begin
      SD.CurrentFrame := fCurrentFrameIndex;
      SD.Active := True;
    end;
  end;

  if UsesVariableDescriptorCount then
    BuildVariableDescriptorCounts;   // already exists, fills fVariableDescriptorCounts[]


  for I := 0 to fFrameCount - 1 do
    begin
      if UsesVariableDescriptorCount then

          V := TpvVulkanDescriptorSet.Create(fVulkanDescriptorPool,
                                             fVulkanDescriptorSetLayout,
                                             fVariableDescriptorCounts[I])     // PasVulkan must expose this

      else
          V := TpvVulkanDescriptorSet.Create(  fVulkanDescriptorPool, fVulkanDescriptorSetLayout  );

    If assigned(V) then
    Begin
      fVulkanDescriptorSets[I] := V;

      WriteInitialDescriptorBindings(I, fVulkanDescriptorSets[I]);

      fVulkanDescriptorSets[I].Flush;
    End;
  end;

  Result := fVulkanDescriptorSetLayout <> nil;
end;

procedure TvgDescriptorSet.SetFrameCount(const Value: TvkUint32);
begin
  If fFrameCount = Value then exit;
  SetActiveState(False);
  fFrameCount := Value;
end;

procedure TvgDescriptorSet.SetLinker(const Value: TvgLinker);
  Var I,FC:Integer;
      Device : TvgLogicalDevice;
begin
  If fLinker = Value then exit;
  SetActiveState(False);
  fLinker := Value;

  Device:=nil;
  FC:=1;
  If assigned(fLinker) then
  Begin
    FC:=fLinker.FrameCount;
    If assigned(fLinker.Device) then
       Device := fLinker.Device.fLogicalDevice;
  End;

  CustomAssert(assigned(fDescriptorCol),'Descriptor Item collection not assigned',self);
  If fDescriptorCol.Count=0 then exit;

  For I:=0 to fDescriptorCol.Count-1 do
  Begin

    If assigned(fDescriptorCol.Items[I].Descriptor) then
    Begin
      fDescriptorCol.Items[I].Descriptor.Device     := Device;
      fDescriptorCol.Items[I].Descriptor.FrameCount := FC;
    end;
  End;
end;

procedure TvgDescriptorSet.SetUpShaderData;
 var    I    : Integer;
      SD     : TvgDescriptorArray;
begin

    For I:=0 to fDescriptorCol.Count-1 do
    Begin
      SD := fDescriptorCol.Items[I].fDescriptor;
      If assigned(SD) then
      Begin
       Try
        If SD.LockData(-1,False) then
           SD.SetupData;
       Finally
         SD.UnLockData(-1);
       End;
      End;
    End;


end;

function TvgDescriptorArray.AddDescriptorDataToArray(  aDescriptorData: TvgDescriptorData): Boolean;
  Var L:Integer;
begin
  Result := False;
  If not assigned(aDescriptorData) then exit;

// For FixedArray we never grow beyond BindingCount
  if (fBindingMode = vgdbmFixedArray) and
     (TvkUint32(Length(fDescriptorArray)) >= fBindingCount) then
    Exit;

  L:=Length(fDescriptorArray);
  SetLength(fDescriptorArray, L+1);
  fDescriptorArray[L]:= aDescriptorData;

  fDescriptorArray[L].fDescriptor := Self;
  fDescriptorArray[L].FrameCount  := self.fFrameCount;
  fDescriptorArray[L].SetGLSLIndex(fNextGLSLIndex);
  Inc(fNextGLSLIndex);

  Result := True;
end;

{ TvgShaderData }

procedure TvgDescriptorArray.Assign(Source: TPersistent);
var DIS: TvgDescriptorArray;
begin
  if Source is TvgDescriptorArray then
  begin
    DIS := TvgDescriptorArray(Source);
    fFrameCount := DIS.fFrameCount;
    fUseStaging := DIS.fUseStaging;
    fBindingFlags := DIS.fBindingFlags;
    fDescriptorType := DIS.fDescriptorType;
    fExtendedBinding := DIS.fExtendedBinding;
    fLayoutFlags := DIS.fLayoutFlags;
    fStageFlags := DIS.fStageFlags;

    fBinding := DIS.fBinding;
    fBindingCount := DIS.fBindingCount;
    fBindingMode := DIS.fBindingMode;
    fIndexingOptions := DIS.fIndexingOptions;
  end else
  begin
    inherited Assign(Source);
  end;
end;

procedure TvgDescriptorArray.ClearDescriptor(aCommandBuffer:TvgCommandBuffer);
begin
   //do nothing
end;

constructor TvgDescriptorArray.Create(AOwner: TComponent);
var I: Integer;
begin
  inherited Create(AOwner);

  fCurrentFrameIndex     :=0;
  fLastFrameIndex        :=High(TvkUint32);  //follows the Current Frame Index use for data updating or reading
  fFrameCount            := MaxFramesInFlight;    //important

  fUseStaging            := True;
  fImageProps            := Default(TvgImageFormatProps);

  fBinding               := 0;
  fBindingCount          := 1;    //single descriptor mode
  fBindingMode           := vgdbmSingle;  //single descriptor mode
  fIndexingOptions       := [];
  EnsureDescriptorArraySize(1);

  fNextGLSLIndex         := 1;

  fBindingFlags          := 0;
  fLayoutFlags           := 0;
  fExtendedBinding       := False;

  fDataFlow              := [DF_UP];

  fResourceType          := RT_UNKNOWN;
  fCurrentDescriptorIndex:=0;

  SetUpArraysForFrameCount;
  SetUploadFlags;

end;

destructor TvgDescriptorArray.Destroy;
var I: Integer;
begin
  SetActiveState(False);

  For I:=0 to length(fDescriptorArray) - 1 do
    If assigned(fDescriptorArray[I]) then
     FreeAndNil(fDescriptorArray[I]);
  SetLength(fDescriptorArray,0);

  for I := 0 to Length(fSection) - 1 do
  begin
    if Assigned(fSection[I]) then
    begin
      fSection[I].Release;
      FreeAndNil(fSection[I]);
    end;
  end;
  SetLength(fSection,0);

  inherited;
end;

procedure TvgDescriptorArray.EnsureDescriptorArraySize(const aSize: TvkUint32);
var
  OldLen, I: Integer;
begin
  if aSize = 0 then
  begin
    // free everything
    for I := 0 to High(fDescriptorArray) do
      if Assigned(fDescriptorArray[I]) then
        FreeAndNil(fDescriptorArray[I]);
    SetLength(fDescriptorArray, 0);
    Exit;
  end;

  OldLen := Length(fDescriptorArray);

  if Integer(aSize) > OldLen then
  begin
    SetLength(fDescriptorArray, aSize);
    // new slots stay nil (partially-bound friendly)
  end
  else if Integer(aSize) < OldLen then
  begin
    for I := aSize to OldLen - 1 do
      if Assigned(fDescriptorArray[I]) then
        FreeAndNil(fDescriptorArray[I]);
    SetLength(fDescriptorArray, aSize);
  end;
  // else same size → do nothing
end;

function TvgDescriptorArray.GetActiveCount: Integer;
  Var I,C:Integer;
begin
  C:=0;
  For I:=0 to Length(fDescriptorArray)-1 do
    If assigned(fDescriptorArray[I]) then
       Inc(C);
  Result := C;
end;

function TvgDescriptorArray.GetBindingFlags: TVkDescriptorBindingFlags;
begin
  Result := fBindingFlags;
end;

function TvgDescriptorArray.GetDescriptorCount: TvkUint32;
begin
  Result := Length(fDescriptorArray);
end;

function TvgDescriptorArray.GetDescriptorCountForLayout: TvkUint32;
begin
  Result := Max(1, fBindingCount);
end;

function TvgDescriptorArray.GetDescriptorCountForPool: TvkUint32;
begin
   Result := GetDescriptorCountForLayout;
end;

function TvgDescriptorArray.GetDescriptorCountForWrite( aFrameIndex: TvkUint32): TvkUint32;
begin
  if fBindingMode = vgdbmVariableArray then
    Result := TvkUint32(Length(fDescriptorArray))
  else
    Result := Max(1, fBindingCount);
end;

function TvgDescriptorArray.GetDescriptorData( Index: Integer): TvgDescriptorData;
begin
  If (Index>=0) and (Index<Length(fDescriptorArray))then
     Result := fDescriptorArray[Index]
  else
