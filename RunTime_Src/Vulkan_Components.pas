procedure TvgSubPass.SubPassConfigureGraphicPipeline(GP: TvgGraphicPipeline);
var
  hasDepth : Boolean;
begin
 (*
  // Name and resource use from SubPassMode
  case fSubPassMode of
    SPT_SIMPLE,
    SPT_G_BUFFER:
      begin
        GP.ResourceUse := [RU_GLOBAL, RU_GRAPHICPIPE];
      end;
    SPT_UI,
    SPT_OFFSCREENTOSCREEN:
      begin
        GP.ResourceUse := [RU_GLOBAL];
      end;
    SPT_TRANSPARENCY:
      begin
        GP.ResourceUse := [RU_GLOBAL, RU_GRAPHICPIPE];
        // transparency needs blend enabled — can set default here
      end;
  end;
  *)
  // Depth: only if this subpass actually has a depth attachment
  hasDepth := fDepthStencilAttachmentRef.Count > 0;
  if not hasDepth then
  begin
    GP.DepthStencil.DepthTestEnable  := False;
    GP.DepthStencil.DepthWriteEnable := False;
  end;

  // Color blend attachment count from actual attachments
  // (ColorBlendingState needs one entry per color output)

  //fix
 // GP.ColorBlending.SetAttachmentCount(fColorAttachmentRefs.Count + fResolveAttachmentRefs.Count);


end;

procedure TvgSubPass.UploadGraphicPipeDescriptorSet(aTask: TvgRenderTask;  aRenderWorker: TvgRenderWorker);
  Var
      GP : TvgGraphicPipeline;


    Procedure UploadGraphicPipeDescriptorSetData(aPipe:TvgGraphicPipeline);
    Begin
      If not assigned(aPipe) then exit;
      If not assigned(aPipe.fObjectStore) then exit;
      If not assigned(aPipe.fObjectStore.fObjectStoreRes) then exit;

      aTask.Resources   := aPipe.fObjectStore.fObjectStoreRes;
      aTask.TaskJob     := TM_UPLOADRESOURCEDATA;
      aRenderWorker.CompleteTask(aTask);
    End;

begin

  For GP in fGraphicPipeList.Keys do
   If assigned(GP) then
      UploadGraphicPipeDescriptorSetData(GP);
end;

procedure TvgSubPass.UpLoadRenderNodeData(aTask: TvgRenderTask;  aRenderWorker: TvgRenderWorker);
  Var
      GP : TvgGraphicPipeline;
      ObjStr : TvgBaseObjectStore;
     //  I : Integer;

begin
  CustomAssert(Assigned(fGraphicPipeList),'Graphicpipeline list not created.');
  If fGraphicPipeList.count=0 then exit;

  For GP in fGraphicPipeList.Keys do
  Begin

    If fGraphicPipeList.TryGetValue(GP, ObjStr) then
    Begin

      aTask.ObjectStore := ObjStr;   //not descendant

      aTask.TaskJob     := TM_UPLOADOBJECTDATA;
      aRenderWorker.CompleteTask(aTask);

    End;
  End;

end;

