procedure TvgGraphicPipeline.AddObjectStoreToCommand(aTask: TvgRenderTask;  aRenderWorker: TvgRenderWorker);
begin

  If not assigned(fObjectStore) then exit;
  If fObjectStore.ObjectCount=0 then exit;

  If fState = vgcsInactive then exit;

  aTask.GraphicPipe := self;
  aTask.TaskJob     := TM_BIND_PIPELINE;
  aRenderWorker.CompleteTask(aTask);

  If fObjectStore.Active then
  Begin
    aTask.ObjectStore := fObjectStore;
    aTask.TaskJob    := TM_RENDER_OBJECTSTORE;
    aRenderWorker.CompleteTask(aTask);
  end;

end;

