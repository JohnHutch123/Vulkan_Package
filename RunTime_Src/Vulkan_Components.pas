  If not fStencilBufOn then
    fDepthStencilFormat  :=  GetVKDeptBufferFormat(DB_D32_SFLOAT)
  else
    fDepthStencilFormat  :=  GetVKDeptBufferFormat(DB_D32_SFLOAT_S8_UINT);
end;

