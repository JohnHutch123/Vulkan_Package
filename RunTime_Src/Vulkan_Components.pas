procedure TvgResourceImageBuffer.SetUpForImageMode;
  Var
      aImageProps : TvgImageFormatProps;
      ImagePropsOK: Boolean ;

begin

  CustomAssert(Assigned(fLinker),'Linker NOT assigned',self);
  CustomAssert(Assigned(fLinker.SwapChain),' NOT assigned',self);
  CustomAssert(Assigned(fLinker.Renderer),' NOT assigned',self);
  CustomAssert(Assigned(fLinker.Renderer.RenderPass),' NOT assigned',self);
  CustomAssert(Assigned(fLinker.ScreenDevice),' NOT assigned',self);
  CustomAssert(Assigned(fLinker.ScreenDevice.PhysicalDevice),' NOT assigned',self);


  If assigned(fAttachment) then
  Begin
     aImageProps  := fAttachment.fImageFormatProp ;
     ImagePropsOK := IsImageFormatSupported( fLinker.ScreenDevice.PhysicalDevice,aImageProps)  ;
  end else
  if assigned(fDescriptor) then
  Begin
     aImageProps  := fDescriptor.fImageProps;
     ImagePropsOK := IsImageFormatSupported( fLinker.ScreenDevice.PhysicalDevice,aImageProps)  ;
  End else
     ImagePropsOK := False;

  if fLinker.fRenderTarget=RT_FRAME then
  Begin
    fImageWidth        := fLinker.SwapChain.ImageWidth  * fLinker.FrameResolution;
    fImageHeight       := fLinker.SwapChain.ImageHeight * fLinker.FrameResolution;
  End else
  Begin
    fImageWidth        := fLinker.SwapChain.ImageWidth;
    fImageHeight       := fLinker.SwapChain.ImageHeight;
  End;


  Case fImageMode of
     imNone         :;
     imColour       :Begin

                        If  Not ImagePropsOK then
                                                      //  aDevice:TvgPhysicalDevice,
                        Begin
                           aImageProps.Format     := VK_FORMAT_R8G8B8_SRGB;
                           aImageProps.ImageType  := VK_IMAGE_TYPE_2D;
                           aImageProps.Tiling     := VK_IMAGE_TILING_OPTIMAL;
                           aImageProps.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) +
                                                     TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSFER_SRC_BIT);
                           aImageProps.Samples    := GetVKSampleCountFlagBit(fLinker.Renderer.RenderPass.MSAASample);
                           ImagePropsOK := IsImageFormatSupported( fLinker.ScreenDevice.PhysicalDevice,aImageProps)  ;
                       end;

                        If ImagePropsOK then
                        Begin
                            fFormat         := aImageProps.Format;
                            fImageType      := aImageProps.ImageType;
                            fImageTiling    := aImageProps.Tiling;
                            fUsage          := aImageProps.Usage;
                            fSamples        := aImageProps.Samples;
                       end else
                       Begin
                         fImageMode := imNone;
                         CustomAssert((fImageMode<>imNone), 'Storage Image : Requested Image Mode is NOT supported on this hardware',self);
                       End;


                        fDepth          := 1;
                        fMipLevels      := 1;
                        fArrayLayers    := 1;

                        fSharingMode    := VK_SHARING_MODE_EXCLUSIVE;
                        fInitialLayout  := VK_IMAGE_LAYOUT_UNDEFINED;
                        fFinalLayout    := VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;

                        fMemoryProperty := TvkFlags(VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) ;
                        fMemoryType     := TpvVulkanDeviceMemoryAllocationType.ImageOptimal;

                        fImageViewType      := VK_IMAGE_VIEW_TYPE_2D;
                        fComponentRed       := VK_COMPONENT_SWIZZLE_R;
                        fComponentGreen     := VK_COMPONENT_SWIZZLE_G;
                        fComponentBlue      := VK_COMPONENT_SWIZZLE_B;
                        fComponentAlpha     := VK_COMPONENT_SWIZZLE_A;
                        fImageAspectFlags   := TVkImageAspectFlags(VK_IMAGE_ASPECT_COLOR_BIT);
                        fBaseMipLevel       := 0;
                        fCountMipMapLevels  := 1;
                        fBaseArrayLayer     := 0;
                        fCountArrayLayers   := 1;
                     end;
     imFrame : Begin

                       If not ImagePropsOK then
                       Begin
                           aImageProps.Format     := fLinker.SwapChain.ImageFormat;
                           aImageProps.ImageType  := VK_IMAGE_TYPE_2D;
                           aImageProps.Tiling     := VK_IMAGE_TILING_OPTIMAL;
                           aImageProps.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) +
                                                     TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSFER_SRC_BIT);

                           aImageProps.Samples    := VK_SAMPLE_COUNT_1_BIT;     //important for Frame
                           ImagePropsOK := IsImageFormatSupported( fLinker.ScreenDevice.PhysicalDevice,aImageProps)  ;
                       end;

                        If ImagePropsOK then
                        Begin
                            fFormat         := aImageProps.Format;
                            fImageType      := aImageProps.ImageType;
                            fImageTiling    := aImageProps.Tiling;
                            fUsage          := aImageProps.Usage;
                            fSamples        := aImageProps.Samples;
                       end else
                       Begin
                         fImageMode := imNone;
                         CustomAssert((fImageMode<>imNone), 'Storage Image : Requested Image Mode is NOT supported on this hardware',self);
                       End;


                        fDepth          := 1;
                        fMipLevels      := 1;
                        fArrayLayers    := 1;

                        fSharingMode    := VK_SHARING_MODE_EXCLUSIVE;
                        fInitialLayout  := VK_IMAGE_LAYOUT_UNDEFINED;
                        fFinalLayout    := VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;

                        fMemoryProperty := TvkFlags(VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) ;
                        fMemoryType     := TpvVulkanDeviceMemoryAllocationType.ImageOptimal;

                        fImageViewType      := VK_IMAGE_VIEW_TYPE_2D;
                        fComponentRed       := VK_COMPONENT_SWIZZLE_R;
                        fComponentGreen     := VK_COMPONENT_SWIZZLE_G;
                        fComponentBlue      := VK_COMPONENT_SWIZZLE_B;
                        fComponentAlpha     := VK_COMPONENT_SWIZZLE_A;
                        fImageAspectFlags   := TVkImageAspectFlags(VK_IMAGE_ASPECT_COLOR_BIT);
                        fBaseMipLevel       := 0;
                        fCountMipMapLevels  := 1;
                        fBaseArrayLayer     := 0;
                        fCountArrayLayers   := 1;
     End;
     imDepth :Begin
                       If not ImagePropsOK then
                       Begin
                           aImageProps.Format     := fLinker.Renderer.RenderPass.fDepthStencilFormat;
                           aImageProps.ImageType  := VK_IMAGE_TYPE_2D;
                           aImageProps.Tiling     := VK_IMAGE_TILING_OPTIMAL;
                           aImageProps.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT);
                           aImageProps.Samples    := GetVKSampleCountFlagBit(fLinker.Renderer.RenderPass.MSAASample);
                           ImagePropsOK := IsImageFormatSupported( fLinker.ScreenDevice.PhysicalDevice,aImageProps)  ;
                       end;

                        If ImagePropsOK then
                        Begin
                            fFormat         := aImageProps.Format;
                            fImageType      := aImageProps.ImageType;
                            fImageTiling    := aImageProps.Tiling;
                            fUsage          := aImageProps.Usage;
                            fSamples        := aImageProps.Samples;
                       end else
                       Begin
                         fImageMode := imNone;
                         CustomAssert((fImageMode<>imNone), 'Storage Image : Requested Image Mode is NOT supported on this hardware',self);
                       End;


                        fDepth          := 1;
                        fMipLevels      := 1;
                        fArrayLayers    := 1;

                        fSharingMode    := VK_SHARING_MODE_EXCLUSIVE;
                        fInitialLayout  := VK_IMAGE_LAYOUT_UNDEFINED;
                        fFinalLayout    := VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;

                        fMemoryProperty := TvkFlags(VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) ;
                        fMemoryType     := TpvVulkanDeviceMemoryAllocationType.ImageOptimal;

                        fImageViewType      := VK_IMAGE_VIEW_TYPE_2D;
                        fComponentRed       := VK_COMPONENT_SWIZZLE_R;
                        fComponentGreen     := VK_COMPONENT_SWIZZLE_G;
                        fComponentBlue      := VK_COMPONENT_SWIZZLE_B;
                        fComponentAlpha     := VK_COMPONENT_SWIZZLE_A;

                        fImageAspectFlags   := TVkImageAspectFlags(VK_IMAGE_ASPECT_DEPTH_BIT) ;

                        fBaseMipLevel       := 0;
                        fCountMipMapLevels  := 1;
                        fBaseArrayLayer     := 0;
                        fCountArrayLayers   := 1;
                     end;

     imDepthStencil :Begin
                       If not ImagePropsOK then
                       Begin
                           aImageProps.Format     := fLinker.Renderer.RenderPass.fDepthStencilFormat;
                           aImageProps.ImageType  := VK_IMAGE_TYPE_2D;
                           aImageProps.Tiling     := VK_IMAGE_TILING_OPTIMAL;
                           aImageProps.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT);
                           aImageProps.Samples    := GetVKSampleCountFlagBit(fLinker.Renderer.RenderPass.MSAASample);
                           ImagePropsOK := IsImageFormatSupported( fLinker.ScreenDevice.PhysicalDevice,aImageProps)  ;
                       end;

                        If ImagePropsOK then
                        Begin
                            fFormat         := aImageProps.Format;
                            fImageType      := aImageProps.ImageType;
                            fImageTiling    := aImageProps.Tiling;
                            fUsage          := aImageProps.Usage;
                            fSamples        := aImageProps.Samples;
                       end else
                       Begin
                         fImageMode := imNone;
                         CustomAssert((fImageMode<>imNone), 'Storage Image : Requested Image Mode is NOT supported on this hardware',self);
                       End;


                        fDepth          := 1;
                        fMipLevels      := 1;
                        fArrayLayers    := 1;

                        fSharingMode    := VK_SHARING_MODE_EXCLUSIVE;
                        fInitialLayout  := VK_IMAGE_LAYOUT_UNDEFINED;
                        fFinalLayout    := VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;

                        fMemoryProperty := TvkFlags(VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) ;
                        fMemoryType     := TpvVulkanDeviceMemoryAllocationType.ImageOptimal;

                        fImageViewType      := VK_IMAGE_VIEW_TYPE_2D;
                        fComponentRed       := VK_COMPONENT_SWIZZLE_R;
                        fComponentGreen     := VK_COMPONENT_SWIZZLE_G;
                        fComponentBlue      := VK_COMPONENT_SWIZZLE_B;
                        fComponentAlpha     := VK_COMPONENT_SWIZZLE_A;

                        fImageAspectFlags   := TVkImageAspectFlags(VK_IMAGE_ASPECT_DEPTH_BIT) +
                                               TVkImageAspectFlags(VK_IMAGE_ASPECT_STENCIL_BIT);
                        fBaseMipLevel       := 0;
                        fCountMipMapLevels  := 1;
                        fBaseArrayLayer     := 0;
                        fCountArrayLayers   := 1;
                     end;
     imMSAA         :Begin
     //don't mess with these values
                       If not ImagePropsOK then
                       Begin
                         aImageProps.Format     := fLinker.SwapChain.ImageFormat;
                         aImageProps.ImageType  := VK_IMAGE_TYPE_2D;
                         aImageProps.Tiling     := VK_IMAGE_TILING_OPTIMAL;
                         aImageProps.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT );  //DON't add VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT
                         aImageProps.Samples    :=  GetVKSampleCountFlagBit(fLinker.Renderer.RenderPass.MSAASample) ;  //important
                         ImagePropsOK := IsImageFormatSupported( fLinker.ScreenDevice.PhysicalDevice,aImageProps)  ;
                       end;

                        If ImagePropsOK then
                        Begin
                            fFormat         := aImageProps.Format;
                            fImageType      := aImageProps.ImageType;
                            fImageTiling    := aImageProps.Tiling;
                            fUsage          := aImageProps.Usage;
                            fSamples        := aImageProps.Samples;
                       end else
                       Begin
                         fImageMode := imNone;
                         CustomAssert((fImageMode<>imNone), 'Storage Image : Requested Image Mode is NOT supported on this hardware',self);
                       End;

                        fDepth          := 1;
                        fMipLevels      := 1;
                        fArrayLayers    := 1;

                        fSharingMode    := VK_SHARING_MODE_EXCLUSIVE;
                        fInitialLayout  := VK_IMAGE_LAYOUT_UNDEFINED;
                        fFinalLayout    := VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;

                        fMemoryProperty := TvkFlags(VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);

                    // Only add LAZILY_ALLOCATED when TRANSIENT is actually in use
                        If (aImageProps.Usage and TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT)) <> 0 then
                          If assigned(fLinker) and assigned(fLinker.Device) and fLinker.Device.fAvailableMemory.LAZILY_ALLOCATED_BIT then
                            fMemoryProperty := fMemoryProperty + TvkFlags(VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT);


                        fMemoryType     := TpvVulkanDeviceMemoryAllocationType.ImageOptimal;

                        fImageViewType      := VK_IMAGE_VIEW_TYPE_2D;
                        fComponentRed       := VK_COMPONENT_SWIZZLE_R;
                        fComponentGreen     := VK_COMPONENT_SWIZZLE_G;
                        fComponentBlue      := VK_COMPONENT_SWIZZLE_B;
                        fComponentAlpha     := VK_COMPONENT_SWIZZLE_A;
                        fImageAspectFlags   := TVkImageAspectFlags(VK_IMAGE_ASPECT_COLOR_BIT);
                        fBaseMipLevel       := 0;
                        fCountMipMapLevels  := 1;
                        fBaseArrayLayer     := 0;
                        fCountArrayLayers   := 1;

                     end;
     imStorageImage  :Begin

                       If not ImagePropsOK then
                       Begin
                           aImageProps.Format     := fLinker.SwapChain.ImageFormat;

                           aImageProps.ImageType  := VK_IMAGE_TYPE_2D;
                           aImageProps.Tiling     := VK_IMAGE_TILING_OPTIMAL;
                           aImageProps.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_STORAGE_BIT) +
                                                     TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSFER_SRC_BIT) +
                                                     TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSFER_Dst_BIT);
                           aImageProps.Samples    :=  VK_SAMPLE_COUNT_1_BIT;
                           ImagePropsOK := IsImageFormatSupported( fLinker.ScreenDevice.PhysicalDevice,aImageProps)  ;
                       end;

                        If  ImagePropsOK then
                        Begin
                            fFormat         := aImageProps.Format;
                            fImageType      := aImageProps.ImageType;
                            fImageTiling    := aImageProps.Tiling;
                            fUsage          := aImageProps.Usage;
                            fSamples        := aImageProps.Samples;
                       end else
                        Begin
                          fImageMode := imNone;
                          CustomAssert((fImageMode<>imNone), 'Storage Image : Requested Image Mode is NOT supported on this hardware',self);
                        End;

                        fDepth          := 1;
                        fMipLevels      := 1;
                        fArrayLayers    := 1;

                        fSharingMode    := VK_SHARING_MODE_EXCLUSIVE;
                        fInitialLayout  := VK_IMAGE_LAYOUT_UNDEFINED;
                        fFinalLayout    := VK_IMAGE_LAYOUT_GENERAL ;                         //OK

                        fMemoryProperty := TvkFlags(VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) ;
                        fMemoryType     := TpvVulkanDeviceMemoryAllocationType.Buffer;        //CHECK

                        fImageViewType      := VK_IMAGE_VIEW_TYPE_2D;
                        fComponentRed       := VK_COMPONENT_SWIZZLE_IDENTITY;
                        fComponentGreen     := VK_COMPONENT_SWIZZLE_IDENTITY;
                        fComponentBlue      := VK_COMPONENT_SWIZZLE_IDENTITY;
                        fComponentAlpha     := VK_COMPONENT_SWIZZLE_IDENTITY;

                        fImageAspectFlags   := TVkImageAspectFlags(VK_IMAGE_ASPECT_COLOR_BIT) ;
                        fBaseMipLevel       := 0;
                        fCountMipMapLevels  := 1;
                        fBaseArrayLayer     := 0;
                        fCountArrayLayers   := 1;

                        fPixelSamplerON     := True;   //important

                     end;
     imTexture      :Begin

                     end;


     imCustom       :;

  End;

end;

