procedure TvgBaseScene.ReConnectRenderEngines;
  Var I:Integer;
      NeedActive:Boolean;
begin
  If NOT assigned(fRendererList) or (fRendererList.count=0) then exit;

  NeedActive:=False;
  For I:= 0 to fRendererList.count-1 do
  Begin
    ConnectRenderEngine(fRendererList.items[I]);
    If  fRendererList.items[I].Active then
        NeedActive:=True;
  End;

  If NeedActive then
     self.SetActiveState(TRue) ;
end;

