procedure TvgLinker.BuildSwapChainColorSpaces;
  Var aInstance:TvgInstance;
      B1,B2:Boolean;
begin
  B1:=False;
  B2:=False;

  CustomAssert(assigned(fScreenDevice),'Screen Device NOT assigned',self);
  CustomAssert(assigned(fScreenDevice.PhysicalDevice),'Physical Device NOT assigned',self);
  CustomAssert(assigned(fScreenDevice.PhysicalDevice.Instance),'Instance NOT assigned',self);

  aInstance := fScreenDevice.PhysicalDevice.Instance;
 Try

  CustomAssert(Assigned(fSurface), 'Surface not attached.',Self);
  CustomAssert(assigned(aInstance), 'Instance not connected to Device',Self);

  CustomAssert(Assigned(fSwapChain), 'SwapChain not created.',Self);

  If not assigned(aInstance.VulkanInstance) then
  Begin
     aInstance.EnableDesigning;
     B1:=assigned(aInstance.VulkanInstance);
  End;
  CustomAssert(assigned(aInstance.VulkanInstance), 'Unable to create a valid Vulkan Instance.',Self);

  If not assigned(fSurface.VulkanSurface) then
  Begin
    fSurface.EnableDesigning;
    B2:=assigned(fSurface.VulkanSurface);
  End;
  CustomAssert(assigned(fSurface.VulkanSurface), 'Vulkan Surface not created',Self);

  fSwapChain.BuildALLImagesColorSpaces;

  If B2 then
     fSurface.SetActiveState(False);
  If B1 then
     aInstance.SetActiveState(False);

 Except
    On E:Exception do
    Begin
      If B2 then
         fSurface.SetActiveState(False);
      If B1 then
         aInstance.SetActiveState(False);
      Raise;
    End;
 End;
end;

procedure TvgLinker.BuildSwapChainPresentationModes;
  Var aInstance:TvgInstance;
      B1,B2:Boolean;
begin
  B1:=False;
  B2:=False;
  aInstance := Nil;
 Try
 // CustomAssert(assigned(fPhysicalDevice), 'Device not connected.',Self);
  CustomAssert(assigned(fScreenDevice), 'Screen Device not connected to Device',Self);
  CustomAssert(Assigned(fSurface), 'Internal Surface not attached.',Self);
  CustomAssert(Assigned(fSwapChain), 'Internal SwapChain not created.',Self);

  aInstance := fScreenDevice.Instance;
  CustomAssert(assigned(aInstance), 'Instance not connected to Device',Self);

  If not assigned(aInstance.VulkanInstance) then
  Begin
     aInstance.EnableDesigning;
     B1:=assigned(aInstance.VulkanInstance);
  End;
  CustomAssert(assigned(aInstance.VulkanInstance), 'Unable to create a valid Vulkan Instance.',Self);

  If not assigned(fSurface.VulkanSurface) then
  Begin
    fSurface.EnableDesigning;
    B2:=True;
  End;
  CustomAssert(assigned(fSurface.VulkanSurface), 'Vulkan Surface not created',Self);

  fSwapChain.BuildALLPresentationModes;

  If B2 then
     fSurface.SetActiveState(False);

  If B1 and assigned(aInstance) then
     aInstance.SetActiveState(False);

 Except
    On E:Exception do
    Begin
      If B2 then
         fSurface.SetActiveState(False);
      If B1 then
         aInstance.SetActiveState(False);
      Raise;
    End;
 End;
end;

procedure TvgLinker.UpdateConnections;

begin
    If (csLoading in ComponentState) then exit;

    CustomAssert(Assigned(fScreenDevice),'Screen Device not assigned.',Self);

    CustomAssert(Assigned(fSurface),'Internal Surface not created.',Self);
    If not fSurface.Active then
    Begin
      fSurface.PhysicalDevice := fScreenDevice.PhysicalDevice;
      fSurface.WindowIntf     := fWindowIntf;
    End;

    CustomAssert(Assigned(fSwapChain),'Internal Swap Chain not created.',Self);
    If not fSwapChain.Active then
    Begin
      fSwapChain.Device          := fScreenDevice;
      fSwapChain.fLinker         := Self;
    end;

    UpdateFormats;
end;

procedure TvgLinker.UpdateFormats;

begin
//fix this
    CustomAssert(assigned(fSwapChain),'',Self);
    if (fSwapChain.ImageFormat<>VK_FORMAT_UNDEFINED) then
       fImageFormat := fSwapChain.ImageFormat;

end;

procedure TvgLinker.UpdateWindowSize;
  Var  aWinWidth, aWinHeight : TvkUint32;
