constructor TvgBaseObjectStore.Create(AOwner: TComponent);
begin
  Inherited Create(aOwner);

  fUseStaging  := True;

  fGraphicPipes   := TObjectDictionary<TvgGraphicPipeRecord, TvgGraphicpipeline >.Create([doOwnsValues]);

   fObjectStoreRes      := TvgDescriptorSet.Create(nil);
   fObjectStoreRes.SetSubComponent(True);
   fObjectStoreRes.Name := 'GPR';

   fObjectMaterialRes := TvgDescriptorSet.Create(nil);
   fObjectMaterialRes.SetSubComponent(True);
   fObjectMaterialRes.Name := 'MAR';

   fObjectModelRes    := TvgDescriptorSet.Create(nil);
   fObjectModelRes.SetSubComponent(True);
   fObjectModelRes.Name := 'MOR';


end;

destructor TvgBaseObjectStore.Destroy;

begin
  SetActiveState(False); //must stay here

  FreeAndNil(fGraphicPipes);

  If assigned(fObjectStoreRes) then
     FreeAndNil(fObjectStoreRes);

  If assigned(fObjectMaterialRes) then
     FreeAndNil(fObjectMaterialRes);

  If assigned(fObjectModelRes) then
     FreeAndNil(fObjectModelRes);

  inherited;
end;


