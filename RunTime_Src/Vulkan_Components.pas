Function TvgFeatures.EnableDesigning: Boolean;
  Var
     // Ver : TvkUint32;
      B1,B2, B3:Boolean;
begin
  Result := Inherited;
  CustomAssert(Result,Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);

  if fReadFeatures then Exit(True);

  CustomAssert(Assigned(fLogicalDevice), 'Logical Device not assigned', Self);


    CustomAssert(assigned(fLogicalDevice),'Logical Device not assigned',Self);
    CustomAssert(assigned(fLogicalDevice.Instance),'Instance not assigned to Logical Device',Self);
    CustomAssert(assigned(fLogicalDevice.PhysicalDevice),'Physical Device not assigned',Self);

    If not assigned(fLogicalDevice.Instance.fVulkanInstance) then
    Begin
      fLogicalDevice.Instance.SetDesignState(True);
      B1:=True;
    End else
      B1:=False;

    CustomAssert(assigned(fLogicalDevice.Instance.fVulkanInstance),'Instance not active',Self);

    If not assigned(fLogicalDevice.PhysicalDevice.fVulkanPhysicalDevice) then
    Begin
      fLogicalDevice.PhysicalDevice.SetDesignState(True);
      B2:=True;
    End else
      B2:=False;

    CustomAssert(assigned(fLogicalDevice.PhysicalDevice.fVulkanPhysicalDevice),'Physical Device not available',Self);

    If not assigned(fLogicalDevice.fVulkanDevice) then
    Begin
      fLogicalDevice.SetDesignState(True);
      B3:=True;
    End else
      B3:=False;

    CustomAssert(assigned(fLogicalDevice.fVulkanDevice),'Logical Device not active',Self);

    CustomAssert(assigned(fLogicalDevice.Instance.fVulkanInstance.Commands),'Instance commands not available',Self);
  try
    QuerySupportedFeatures;   // reads from TpvVulkanPhysicalDevice
    UpdateRecordConnections;

    // Do NOT call CopyDataToRecords here — the user hasn't set
    // their feature selections yet; that happens in SetEnabled


  finally
    if B3 then fLogicalDevice.SetDesignState(False);
    if B2 then fLogicalDevice.PhysicalDevice.SetDesignState(False);
    if B1 then fLogicalDevice.Instance.SetDesignState(False);
  end;

  Result := True;
end;


