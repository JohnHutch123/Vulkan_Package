procedure TvgFrame.FinishFramePrepare;
begin
  CustomAssert(assigned(fLinker) ,'Window Link not defined' ,Self);

  if NOT fFrameRenderLock then exit;


  Try

     If fUseImageBuffer then

         fFramePrepareCommandBuffer.ExecuteCommand(  fGraphicQueue,
                                                           TVkPipelineStageFlags(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT),
                                                           nil,     //wait for
                                                           nil,    //signal when finished
                                                           true,
                                                           true) ;


  Finally
    fFrameRenderLock := False;
  End;

  {$IFDEF TIMINGON}
     fStopwatch.Stop;
     fPrepareFrameTime := fStopWatch.ElapsedMilliseconds;
  {$ENDIF}

  fLinker.LinkerFinishPrepare;   //call back up the line to finish
end;

procedure TvgFrame.StartFramePrepare;
begin
  CustomAssert((fState=vgcsActive) ,'Frame not active' ,Self);

  CustomAssert(assigned(fLinker) ,'Window Link not defined',Self );
  CustomAssert(Assigned(fLinker.SwapChain.VulkanSwapChain),'Vulkan Swap Chain not created.',Self);
  CustomAssert(Assigned(fLinker.fRenderer),'Vulkan Renderer not assigned.',Self);

  CustomAssert((fLinker.fRenderer.Active=True),'Vulkan Renderer not ACTIVE.',Self);

  if fFrameRenderLock then exit;
  fFrameRenderLock := True;

  {$IFDEF TIMINGON}
  fStopWatch.Reset;
  fStopWatch.Start;
  {$ENDIF}

  if (fFrameIndex>=0) and (fFrameIndex<Length(fLinker.ScreenDevice.VulkanDevice.GraphicsQueues)) then
     fGraphicQueue := fLinker.ScreenDevice.VulkanDevice.GraphicsQueues[fFrameIndex]
  else
     fGraphicQueue := fLinker.ScreenDevice.VulkanDevice.GraphicsQueue;

  fPresentQueue  := fLinker.ScreenDevice.VulkanDevice.PresentQueue;
  fTransferQueue := fLinker.ScreenDevice.VulkanDevice.TransferQueue;

  If fUseImageBuffer then
  Begin
          fImageIndex   := -1;

          if fRenderNeeded then   //need to signal if a redraw is needed
          Begin
                fRenderNeeded := False;

                if not assigned(fFramePrepareCommandBuffer) then
                Begin
                   fFramePrepareCommandBuffer  := fFrameGraphicCommandPool.AcquireFrameCommand(0);//  RequestCommand(0 , CB_PRIMARY,  [BU_SIMULTANEOUS_USE_BIT]);
                   CustomAssert(Assigned(fFramePrepareCommandBuffer),'Command not assigned',Self);

                   fFramePrepareCommandBuffer.Active   := True;
                End else
                   ResetPrepareCommandBuffer;

                If assigned(fLinker.fRenderer) then
                            fLinker.fRenderer.StartRenderEnginePrepare(fImageIndex, self ) ;   //may be threaded

          end else
          Begin

            FinishFramePrepare;    //just need to finish and prepare
          End;

  end else
  Begin

      If fLinker.SwapChain.AcquireNextImage(fImageAvailableSemaphore, nil) then
      Begin

          if not assigned(fFramePrepareCommandBuffer) then
          Begin
             fFramePrepareCommandBuffer  := fFrameGraphicCommandPool.AcquireFrameCommand(0) ;  //RequestCommand(0, CB_PRIMARY,  [BU_SIMULTANEOUS_USE_BIT]);
             CustomAssert(Assigned(fFramePrepareCommandBuffer),'Command not assigned',Self);
             fFramePrepareCommandBuffer.Active   := True;
          End else
             ResetPrepareCommandBuffer;

          fImageIndex := fLinker.SwapChain.CurrentImageIndex;


          If assigned(fLinker.fRenderer) then
                      fLinker.fRenderer.StartRenderEnginePrepare(fImageIndex, self) ;  //may be threaded
                      //needs to be inside the Aquire/Present loop

      end;

  End;

end;


procedure TvgFrame.PrepareFrameToScreenCommand(
  const aCommandBuffer: TvgCommandBuffer;
  const aBackBufferImage: TpvVulkanImage;   // off-screen render image
  const aSwapChainImage: TpvVulkanImage;    // currently acquired swap-chain image
  const aSwapChainImageIndex: TvkUint32);
var
  Barrier    : TVkImageMemoryBarrier;
  BlitRegion : TVkImageBlit;
  VK_ImageSub: TVkImageSubresourceRange;
  SrcWidth   : TvkInt32;
  SrcHeight  : TvkInt32;
  DstWidth   : TvkInt32;
  DstHeight  : TvkInt32;
begin
  // currently unused, but keep parameter for API symmetry / future logging
  if aSwapChainImageIndex = High(TvkUint32) then
  begin
  end;

  CustomAssert(Assigned(aCommandBuffer),  'PrepareFrameToScreenCommand: command buffer not assigned', Self);
  CustomAssert(Assigned(aBackBufferImage), 'PrepareFrameToScreenCommand: back buffer image not assigned', Self);
  CustomAssert(Assigned(aSwapChainImage),  'PrepareFrameToScreenCommand: swapchain image not assigned', Self);
  CustomAssert(Assigned(fLinker),          'PrepareFrameToScreenCommand: linker not assigned', Self);
  CustomAssert(Assigned(fLinker.SwapChain), 'PrepareFrameToScreenCommand: swapchain not assigned', Self);

  SrcWidth  := fLinker.SwapChain.ImageWidth  * fLinker.FrameResolution;
  SrcHeight := fLinker.SwapChain.ImageHeight * fLinker.FrameResolution;
  DstWidth  := fLinker.SwapChain.ImageWidth;
  DstHeight := fLinker.SwapChain.ImageHeight;

  aCommandBuffer.Reset;
  aCommandBuffer.PrepareForRecording;
  aCommandBuffer.BeginRecording;

  FillChar(VK_ImageSub, SizeOf(VK_ImageSub), 0);
  VK_ImageSub.aspectMask     := TVkImageAspectFlags(VK_IMAGE_ASPECT_COLOR_BIT);
  VK_ImageSub.baseMipLevel   := 0;
  VK_ImageSub.levelCount     := 1;
  VK_ImageSub.baseArrayLayer := 0;
  VK_ImageSub.layerCount     := 1;

  FillChar(Barrier, SizeOf(Barrier), 0);
  Barrier.sType               := VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
  Barrier.srcQueueFamilyIndex := VK_QUEUE_FAMILY_IGNORED;
  Barrier.dstQueueFamilyIndex := VK_QUEUE_FAMILY_IGNORED;
  Barrier.subresourceRange    := VK_ImageSub;

  // 1) Source image: render target -> transfer source
  // IMPORTANT:
  // This assumes the image is in COLOR_ATTACHMENT_OPTIMAL at this point.
  // If your render pass leaves the offscreen frame image in TRANSFER_SRC_OPTIMAL,
  // then change oldLayout/srcStage/srcAccess below to match that actual state.
  Barrier.image         := aBackBufferImage.Handle;
  Barrier.oldLayout     := VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
  Barrier.newLayout     := VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
  Barrier.srcAccessMask := TVkAccessFlags(VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT);
  Barrier.dstAccessMask := TVkAccessFlags(VK_ACCESS_TRANSFER_READ_BIT);

  aCommandBuffer.CmdPipelineBarrier(
    TVkPipelineStageFlags(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT),
    TVkPipelineStageFlags(VK_PIPELINE_STAGE_TRANSFER_BIT),
    0,
    0, nil,
    0, nil,
    1, @Barrier);

  // 2) Swapchain image: acquired image -> transfer destination
  // We do not preserve previous contents, so UNDEFINED is acceptable here.
  Barrier.image         := aSwapChainImage.Handle;
  Barrier.oldLayout     := VK_IMAGE_LAYOUT_UNDEFINED;
  Barrier.newLayout     := VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
  Barrier.srcAccessMask := 0;
  Barrier.dstAccessMask := TVkAccessFlags(VK_ACCESS_TRANSFER_WRITE_BIT);

  aCommandBuffer.CmdPipelineBarrier(
    TVkPipelineStageFlags(VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT),
    TVkPipelineStageFlags(VK_PIPELINE_STAGE_TRANSFER_BIT),
    0,
    0, nil,
    0, nil,
    1, @Barrier);

  // 3) Blit offscreen image -> swapchain image
  FillChar(BlitRegion, SizeOf(BlitRegion), 0);

  BlitRegion.srcSubresource.aspectMask     := TVkImageAspectFlags(VK_IMAGE_ASPECT_COLOR_BIT);
  BlitRegion.srcSubresource.mipLevel       := 0;
  BlitRegion.srcSubresource.baseArrayLayer := 0;
  BlitRegion.srcSubresource.layerCount     := 1;
  BlitRegion.srcOffsets[0]                 := TVkOffset3D.Create(0, 0, 0);
  BlitRegion.srcOffsets[1]                 := TVkOffset3D.Create(SrcWidth, SrcHeight, 1);

  BlitRegion.dstSubresource.aspectMask     := TVkImageAspectFlags(VK_IMAGE_ASPECT_COLOR_BIT);
  BlitRegion.dstSubresource.mipLevel       := 0;
  BlitRegion.dstSubresource.baseArrayLayer := 0;
  BlitRegion.dstSubresource.layerCount     := 1;
  BlitRegion.dstOffsets[0]                 := TVkOffset3D.Create(0, 0, 0);
  BlitRegion.dstOffsets[1]                 := TVkOffset3D.Create(DstWidth, DstHeight, 1);

  aCommandBuffer.CmdBlitImage(
    aBackBufferImage.Handle, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
    aSwapChainImage.Handle,  VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
    1, @BlitRegion,
    VK_FILTER_LINEAR);

  // 4) Restore source image for next frame render
  Barrier.image         := aBackBufferImage.Handle;
  Barrier.oldLayout     := VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
  Barrier.newLayout     := VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
  Barrier.srcAccessMask := TVkAccessFlags(VK_ACCESS_TRANSFER_READ_BIT);
  Barrier.dstAccessMask := TVkAccessFlags(VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT);

  aCommandBuffer.CmdPipelineBarrier(
    TVkPipelineStageFlags(VK_PIPELINE_STAGE_TRANSFER_BIT),
    TVkPipelineStageFlags(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT),
    0,
    0, nil,
    0, nil,
    1, @Barrier);

  // 5) Present transition for swapchain image
  Barrier.image         := aSwapChainImage.Handle;
  Barrier.oldLayout     := VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
  Barrier.newLayout     := VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
  Barrier.srcAccessMask := TVkAccessFlags(VK_ACCESS_TRANSFER_WRITE_BIT);
  Barrier.dstAccessMask := 0;

  aCommandBuffer.CmdPipelineBarrier(
    TVkPipelineStageFlags(VK_PIPELINE_STAGE_TRANSFER_BIT),
    TVkPipelineStageFlags(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT),
    0,
    0, nil,
    0, nil,
    1, @Barrier);

  aCommandBuffer.EndRecording;
end;

procedure TvgFrame.PresentFrame;
  {$IFDEF TIMINGON}
  Var StopWatch  : TStopwatch;
  {$ENDIF}
begin
  If (csDestroying in ComponentState) then exit;
  CustomAssert((fState=vgcsActive) ,'Frame not active' ,Self);

  CustomAssert(assigned(fLinker) ,'Window Link not defined' ,Self);
  CustomAssert(Assigned(fLinker.SwapChain.VulkanSwapChain),'Vulkan Swap Chain not created.',Self);
  CustomAssert(Assigned(fLinker.fRenderer),'Vulkan Renderer not assigned.',Self);

  CustomAssert((fLinker.fRenderer.Active=True),'Vulkan Renderer not ACTIVE.',Self);

  {$IFDEF TIMINGON}
  StopWatch   := TStopwatch.Create;
  StopWatch.Start;
  {$ENDIF}

  Try

        if (fFrameIndex>=0) and (fFrameIndex<Length(fLinker.ScreenDevice.VulkanDevice.GraphicsQueues)) then
           fGraphicQueue := fLinker.ScreenDevice.VulkanDevice.GraphicsQueues[fFrameIndex]
        else
           fGraphicQueue := fLinker.ScreenDevice.VulkanDevice.GraphicsQueue;

        fPresentQueue := fLinker.ScreenDevice.VulkanDevice.PresentQueue;
        fTransferQueue:= fLinker.ScreenDevice.VulkanDevice.TransferQueue;
        //main render

        If fUseImageBuffer then
        Begin

              If fLinker.SwapChain.AcquireNextImage(fImageAvailableSemaphore, nil) then
              Begin

                   fImageIndex  := fLinker.SwapChain.VulkanSwapChain.CurrentImageIndex;

              //use the ImageIndex Transfer Buffer to copy Render Frame to SCREEN
                (*
                   PrepareFrameToScreenCommand( fFrameImageCommandBufferPool.CommandBuffer[fImageIndex],//   const aCommandBuffer    : TvgCommandBuffer;
                                                fFrameImageBuffer.fImage,//   const aBackBufferImage: TpvVulkanImage; // your off-screen image when fUseImageBuffer=True
                                                fLinker.SwapChain.VulkanSwapChain.Images[fImageIndex],// const aSwapChainImage : TpvVulkanImage;   // CURRENT acquired swap-chain image
                                                fImageIndex);// const aSwapChainImageIndex: TvkUint32);
                *)



                   fFrameImageCommandBufferPool.CommandBuffer[fImageIndex].ExecuteCommand( fGraphicQueue,  //must be Graphic
                                                                                         TVkPipelineStageFlags(VK_PIPELINE_STAGE_TRANSFER_BIT),//TVkPipelineStageFlags(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT),
                                                                                         fImageAvailableSemaphore,     //wait for
                                                                                         fRenderFinishedSemaphores[fImageIndex],    //signal when finished
                                                                                         true,          //MUST be TRUE
                                                                                         true) ;        //MUST be TRUE

                   fLinker.SwapChain.QueuePresent(fPresentQueue, fRenderFinishedSemaphores[fImageIndex]);

              end;



        end else
        Begin


             fFramePrepareCommandBuffer.ExecuteCommand( fGraphicQueue,
                                                               TVkPipelineStageFlags(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT),
                                                               fImageAvailableSemaphore,  //wait for image
                                                               fRenderFinishedSemaphores[fImageIndex],  //signal when finished
                                                               True,        //MUST be TRUE
                                                               True) ;      //MUST be TRUE

             fLinker.SwapChain.QueuePresent(fPresentQueue, fRenderFinishedSemaphores[fImageIndex]);



        End;

                 //acquire already completed in PrepareFrame call




  Finally
    {$IFDEF TIMINGON}
       Stopwatch.Stop;
       fPresentFrameTime := StopWatch.ElapsedMilliseconds;
    {$ENDIF}
  End;

end;

Function TvgFrame.SetDisabled:Boolean;
  Var  I:Integer;
begin
  Result := False;


  fUseImageBuffer  := False;

  If assigned(fUIImageBuffer) then
  Begin
    fUIImageBuffer.Active := False;
    FreeAndNil(fUIImageBuffer);
  End;

  if assigned(fFrameImageBuffer) then
  Begin
    fFrameImageBuffer.Active := False;
    FreeAndNil(fFrameImageBuffer);
  End;

  if assigned(fFrameImageCommandBufferPool) then
  Begin
     fFrameImageCommandBufferPool.ReleaseAllCommands(True) ;
     fFrameImageCommandBufferPool.Active := False;
     FreeAndNil(fFrameImageCommandBufferPool);
  End;

  if assigned(fImageAvailableSemaphore) then
    FreeAndNil(fImageAvailableSemaphore);

  for I := 0 to Length(fRenderFinishedSemaphores)-1 do
    if assigned(fRenderFinishedSemaphores[I]) then
      FreeAndNil(fRenderFinishedSemaphores[I]);

  SetLength(fRenderFinishedSemaphores, 0);

  If assigned(fFrameGraphicCommandPool) then
  Begin
     fFrameGraphicCommandPool.ReleaseAllCommands(True) ;
     fFrameGraphicCommandPool.Active := False;
     FreeAndNil(fFrameGraphicCommandPool);
  end;

  fFramePrepareCommandBuffer := Nil;

  Result := Inherited;
  CustomAssert(Result,Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);
end;

Function TvgFrame.SetEnabled : Boolean;
  Var I :Integer;
      CI:Integer;

    Procedure BuildSemaphores;
      Var J : Integer;
    Begin
      // One image-available semaphore per frame — safe as-is because AcquireNextImage
      // signals it and ExecuteCommand consumes it within the same frame cycle.
      fImageAvailableSemaphore := TpvVulkanSemaphore.Create(
                                    fLinker.ScreenDevice.VulkanDevice, 0);

      // One render-finished semaphore per SWAPCHAIN IMAGE — required by the Vulkan spec:
      // a semaphore waited on by vkQueuePresentKHR cannot be re-signalled until
      // the image it was presented with is re-acquired.
      SetLength(fRenderFinishedSemaphores, CI);   // CI already computed above
      for J := 0 to CI - 1 do
        fRenderFinishedSemaphores[J] := TpvVulkanSemaphore.Create(
                                          fLinker.ScreenDevice.VulkanDevice, 0);
    End;

begin
  Result := Inherited;
  CustomAssert(Result,Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);


  CustomAssert(assigned(fLinker),'Vulkan Link not assigned',Self);
  CustomAssert(assigned(fLinker.ScreenDevice),'Vulkan Link not assigned a  ScreenDevice',Self);
  CustomAssert(assigned(fLinker.SwapChain),'Vulkan Link not assigned a  SwapChain',Self);
  CustomAssert(assigned(fLinker.ScreenDevice.VulkanDevice),'Screen Device not active',Self);
//  CustomAssert(assigned(fLinker.Renderer),'Renderer not assigned',Self);

  fFrameGraphicCommandPool        := TvgCommandBufferPool.Create(self);
  fFrameGraphicCommandPool.Device := fLinker.ScreenDevice;

  fFrameGraphicCommandPool.QueueFamilyType  := VGT_GRAPHIC;                   //IMPORTANT
  fFrameGraphicCommandPool.QueueCreateFlags := [CP_TRANSIENT,
                                                CP_RESET_COMMAND_BUFFER]; //important for RESET

  fFrameGraphicCommandPool.SetUpBufferArrays(1);
  fFrameGraphicCommandPool.Active := True;

  fFrameGraphicCommandPool.Active := True;

  CI :=  fLinker.SwapChain.VulkanSwapChain.CountImages ;  //swap chain image count

  BuildSemaphores;

  if (fLinker.RenderTarget = RT_FRAME) then
  Begin

    fUseImageBuffer               := True;
    fRenderNeeded                 := True;

    fFrameImageBuffer             := TvgResourceImageBuffer.Create(self);
    fFrameImageBuffer.Name        := Format('Frame_Buffer_%d',[fFrameIndex]);
    fFrameImageBuffer.Linker      := fLinker;
    fFrameImageBuffer.ImageMode   := imFrame;

    fFrameImageBuffer.ImageWidth    := fLinker.SwapChain.ImageWidth  * fLinker.FrameResolution;
    fFrameImageBuffer.ImageHeight   := fLinker.SwapChain.ImageHeight * fLinker.FrameResolution;
    fFrameImageBuffer.Format        := GetVGFormat(fLinker.ImageFormat); //OK
    fFrameImageBuffer.Samples       := COUNT_01_BIT;
    fFrameImageBuffer.ImageTiling   := TL_OPTIMAL;
    fFrameImageBuffer.Usage         := [IU_COLOR_ATTACHMENT_BIT,  IU_TRANSFER_SRC_BIT];
    fFrameImageBuffer.SharingMode   := SM_EXCLUSIVE;
    fFrameImageBuffer.InitialLayout := IMAGE_UNDEFINED;                              //IMPORTANT
    fFrameImageBuffer.FinalLayout   := COLOR_ATTACHMENT_OPTIMAL;                     //IMPORTANT

    fFrameImageBuffer.Active        := True;

    fFrameImageCommandBufferPool := TvgCommandBufferPool.Create(self);
    fFrameImageCommandBufferPool.Device   := fLinker.ScreenDevice;

    fFrameImageCommandBufferPool.SetSubComponent(True)  ;
    fFrameImageCommandBufferPool.QueueCreateFlags := [CP_TRANSIENT, CP_RESET_COMMAND_BUFFER]; //important for RESET
    fFrameImageCommandBufferPool.QueueFamilyType  :=  VGT_GRAPHIC;
    fFrameImageCommandBufferPool.SetUpBufferArrays(CI);       //correct - one command per swap chain image

    fFrameImageCommandBufferPool.Active          := True;

    for I := 0 to fFrameImageCommandBufferPool.CommandCount-1 do
    Begin
      fFrameImageCommandBufferPool.AcquireFrameCommand(I);

      //  RequestCommand(I, CB_PRIMARY,  [BU_SIMULTANEOUS_USE_BIT]);
    //  fFrameImageCommandBufferPool.CommandBuffer[I].Active := True;
    end;

    FrameToScreenCopy_Record;  //record transfer commands one per swap chain image

  End;


  {$IFDEF TIMINGON}
     fStopWatch := TStopWatch.Create;
  {$ENDIF}

  fRenderNeeded := True;

  Result := True;
end;

