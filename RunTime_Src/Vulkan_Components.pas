procedure TvgAttachment.SetUpForType;
  Var RP     : TvgRenderPass;
     MSAAOn:Boolean;
begin

  RP := GetRenderPass;
  If not assigned(RP) then exit;
  If not assigned(RP.Linker) then exit;

  MSAAOn := RP.IsMSAAOn;

  fInvalid := False;

  Case fType of
     atCustom:Begin
                 fName           := 'Custom';

     end;

     atScreen :Begin
                    //Checked OK
                 fName              := 'Screen_Attachment';

                 if (RP.fColourFormat<> VK_FORMAT_UNDEFINED) then
                    fImageFormatProp.Format  := RP.fColourFormat;

                 fImageFormatProp.ImageType  := VK_IMAGE_TYPE_2D;
                 fImageFormatProp.Tiling     := VK_IMAGE_TILING_OPTIMAL;
                 fImageFormatProp.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) +
                                                TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSFER_DST_BIT)+
                                                TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSFER_SRC_BIT);

                 fImageFormatProp.Samples    := VK_SAMPLE_COUNT_1_BIT;   //MUST
                  //should stay as 1 bit if resolve

                 fInitialLayout     := VK_IMAGE_LAYOUT_UNDEFINED;
                 ffinalLayout       := VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;

                if MSAAOn then
                  floadOp           := VK_ATTACHMENT_LOAD_OP_DONT_CARE  // resolve target — no need to clear
                else
                  floadOp           := VK_ATTACHMENT_LOAD_OP_CLEAR;     // direct render target — must clear
                 fStoreOp           := VK_ATTACHMENT_STORE_OP_STORE;
                 fstencilLoadOp     := VK_ATTACHMENT_LOAD_OP_DONT_CARE;
                 fstencilStoreOp    := VK_ATTACHMENT_STORE_OP_DONT_CARE;
                 fflags             := 0;

                 //no image buffer needed for Screen
               End;
     atFrame: Begin
     //used as off screen buffer for rendering
                 fName           := 'OffColour_Attachment';
                 if (RP.fColourFormat<> VK_FORMAT_UNDEFINED) then
                    fImageFormatProp.Format  := RP.fColourFormat;

                 fImageFormatProp.ImageType  := VK_IMAGE_TYPE_2D;
                 fImageFormatProp.Tiling     := VK_IMAGE_TILING_OPTIMAL;
                 fImageFormatProp.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) +
                                                TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSFER_DST_BIT)+
                                                TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSFER_SRC_BIT);

                 fImageFormatProp.Samples    := VK_SAMPLE_COUNT_1_BIT;    //MUST

                 finitialLayout  := VK_IMAGE_LAYOUT_UNDEFINED;
                 ffinalLayout    := VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;//VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
                if MSAAOn then
                  floadOp        := VK_ATTACHMENT_LOAD_OP_DONT_CARE  // resolve target — no need to clear
                else
                  floadOp        := VK_ATTACHMENT_LOAD_OP_CLEAR;     // direct render target — must clear
                 fStoreOp        := VK_ATTACHMENT_STORE_OP_STORE;
                 fstencilLoadOp  := VK_ATTACHMENT_LOAD_OP_DONT_CARE;
                 fstencilStoreOp := VK_ATTACHMENT_STORE_OP_DONT_CARE;
                 fflags          := 0;

               End;

     atColour :Begin

                 fName           := 'Colour_Attachment';

                 fImageFormatProp.Format  := VK_FORMAT_R32G32B32A32_SFLOAT;

                 fImageFormatProp.ImageType  := VK_IMAGE_TYPE_2D;
                 fImageFormatProp.Tiling     := VK_IMAGE_TILING_OPTIMAL;
                 fImageFormatProp.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) ;

                 fImageFormatProp.Samples    := GetVKSampleCountFlagBit(RP.MSAASample);

                 finitialLayout  := VK_IMAGE_LAYOUT_UNDEFINED;
                 ffinalLayout    := VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
                 floadOp         := VK_ATTACHMENT_LOAD_OP_CLEAR;
                 fStoreOp        := VK_ATTACHMENT_STORE_OP_STORE;
                 fstencilLoadOp  := VK_ATTACHMENT_LOAD_OP_DONT_CARE;
                 fstencilStoreOp := VK_ATTACHMENT_STORE_OP_DONT_CARE;
                 fflags          := 0;

               End;

     atDepthStencil  :Begin
                 fName           := 'DepthStencil_Attachment';

                 fImageFormatProp.Format     := RP.fDepthStencilFormat;

                 fImageFormatProp.ImageType  := VK_IMAGE_TYPE_2D;
                 fImageFormatProp.Tiling     := VK_IMAGE_TILING_OPTIMAL;
                 fImageFormatProp.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT) ;

                 fImageFormatProp.Samples    := GetVKSampleCountFlagBit(RP.MSAASample);

                 finitialLayout  := VK_IMAGE_LAYOUT_UNDEFINED;
                 ffinalLayout    := VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
                 floadOp         := VK_ATTACHMENT_LOAD_OP_CLEAR;
                 fStoreOp        := VK_ATTACHMENT_STORE_OP_DONT_CARE;
                 fstencilLoadOp  := VK_ATTACHMENT_LOAD_OP_CLEAR;
                 fstencilStoreOp := VK_ATTACHMENT_STORE_OP_DONT_CARE;
                 fflags          := 0;
            End;

     atMSAA :Begin //
                   //Checked OK
                 fName           := 'MSAA';
                 if (RP.fColourFormat<> VK_FORMAT_UNDEFINED) then
                    fImageFormatProp.Format     := RP.fColourFormat;

                 fImageFormatProp.ImageType  := VK_IMAGE_TYPE_2D;
                 fImageFormatProp.Tiling     := VK_IMAGE_TILING_OPTIMAL;


                {$if defined(Android)}
                 fImageFormatProp.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) +
                                                TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT);
                                                //can be dangerous if using RenderDoc Setting Image Mode will check and remove if NOT supported
                {$ifend}
                {$if defined(Wayland) and defined(Unix)}
                 fImageFormatProp.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) ;
                {$ifend}
                {$if defined(Win32) or defined(Win64)}
                 fImageFormatProp.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) ;
                {$ifend}
                {$if defined(XCB) and defined(Unix)}
                 fImageFormatProp.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) +
                                                TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT);
                                                //can be dangerous if using RenderDoc Setting Image Mode will check and remove if NOT supported
                {$ifend}
                {$if defined(XLIB) and defined(Unix)}
                 fImageFormatProp.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) ;
                {$ifend}
                {$if defined(MoltenVK_IOS) and defined(Darwin)}
                 fImageFormatProp.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) +
                                                TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT);
                                                //can be dangerous if using RenderDoc Setting Image Mode will check and remove if NOT supported
                {$ifend}
                {$if defined(MoltenVK_MacOS) and defined(Darwin)}
                 fImageFormatProp.Usage      := TVkImageUsageFlags(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) +
                                                TVkImageUsageFlags(VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT);
                                                //can be dangerous if using RenderDoc Setting Image Mode will check and remove if NOT supported
                {$ifend}


                 fImageFormatProp.Samples    := GetVKSampleCountFlagBit(RP.MSAASample);   //MUST

                 finitialLayout  := VK_IMAGE_LAYOUT_UNDEFINED;
                 ffinalLayout    := VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
                 //important
                 floadOp         := VK_ATTACHMENT_LOAD_OP_CLEAR;
                 fStoreOp        := VK_ATTACHMENT_STORE_OP_DONT_CARE;
                 fstencilLoadOp  := VK_ATTACHMENT_LOAD_OP_DONT_CARE;
                 fstencilStoreOp := VK_ATTACHMENT_STORE_OP_DONT_CARE;
                 fflags          := 0;
             End;

  End;

end;

