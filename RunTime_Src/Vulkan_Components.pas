procedure TvgLinker.SetRenderer(const Value: TvgBaseRenderEngine);
  Var OldRenderer:TvgBaseRenderEngine;
begin
  If fRenderer = Value then exit;
  SetActiveState(False);

  OldRenderer := fRenderer;
  If assigned(OldRenderer) then
  Begin
    OldRenderer.RemoveFreeNotification(self);
    fRenderer := Nil;
    If OldRenderer.fLinker = Self then
      OldRenderer.SetLinker(Nil);
  End;

  fRenderer := Value;

  If assigned(fRenderer) then
  Begin
    fRenderer.FreeNotification(self);
    If fRenderer.fLinker <> Self then
      fRenderer.SetLinker(Self);
  End;

end;

