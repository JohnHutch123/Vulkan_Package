  Inherited;

  If Length(fImageBufferArray)>0 then
  Begin
    for I:=0 to Length(fImageBufferArray)-1 do
    Begin
     fImageBufferArray[I].Active:=False;
     fImageBufferArray[I].SetSubComponent(False);
