  LowPart  := Cardinal(Value and $FFFFFFFF);
  HighPart := Cardinal(Value shr 32);
end;

function Combine32BitTo64Bit(LowPart, HighPart: LongWord): UInt64;
begin
  Result := Int64(HighPart) shl 32 or LowPart;   //low is R high is G
end;


Procedure IsMemoryAvailable(const PhysicalDevice: TVkPhysicalDevice; Var aMemRecord : TvgMemAvailable);
var
	MemProps: TVkPhysicalDeviceMemoryProperties;
	i: UInt32;
begin
// Using Vulkan.pas and PasVulkan.pas headers from https://github.com/BeRo1985/pasvulkan to interface with the Vulkan API in Delphi Pascal
  aMemRecord := Default(TvgMemAvailable);

	vkGetPhysicalDeviceMemoryProperties(PhysicalDevice, @MemProps);

	for i := 0 to MemProps.memoryTypeCount - 1 do
	begin
		// Check for VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT, which enables efficient use of VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT in Vulkan
(*
       VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT=$00000001,                            //< If otherwise stated, then allocate memory on device
       VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT=$00000002,                            //< Memory is mappable by host
       VK_MEMORY_PROPERTY_HOST_COHERENT_BIT=$00000004,                           //< Memory will have i/o coherency. If not set, application may need to use vkFlushMappedMemoryRanges and vkInvalidateMappedMemoryRanges to flush/invalidate host cache
       VK_MEMORY_PROPERTY_HOST_CACHED_BIT=$00000008,                             //< Memory will be cached by the host
       VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT=$00000010,                        //< Memory may be allocated by the driver when it is required
       VK_MEMORY_PROPERTY_PROTECTED_BIT=$00000020,
       VK_MEMORY_PROPERTY_DEVICE_COHERENT_BIT_AMD=$00000040,
       VK_MEMORY_PROPERTY_DEVICE_UNCACHED_BIT_AMD=$00000080,
       VK_MEMORY_PROPERTY_RDMA_CAPABLE_BIT_NV=$00000100
    *)

		if (MemProps.memoryTypes[i].propertyFlags and TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) <> 0 then
		   	aMemRecord.DEVICE_LOCAL_BIT := True;
		if (MemProps.memoryTypes[i].propertyFlags and TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) <> 0 then
		   	aMemRecord.HOST_VISIBLE_BIT := True;
		if (MemProps.memoryTypes[i].propertyFlags and TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) <> 0 then
		   	aMemRecord.HOST_COHERENT_BIT := True;
		if (MemProps.memoryTypes[i].propertyFlags and TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_HOST_CACHED_BIT)) <> 0 then
		   	aMemRecord.HOST_CACHED_BIT := True;
		if (MemProps.memoryTypes[i].propertyFlags and TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT)) <> 0 then
		   	aMemRecord.LAZILY_ALLOCATED_BIT := True;
		if (MemProps.memoryTypes[i].propertyFlags and TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_PROTECTED_BIT)) <> 0 then
		   	aMemRecord.PROTECTED_BIT := True;
		if (MemProps.memoryTypes[i].propertyFlags and TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_DEVICE_COHERENT_BIT_AMD)) <> 0 then
		   	aMemRecord.DEVICE_COHERENT_BIT_AMD := True;
		if (MemProps.memoryTypes[i].propertyFlags and TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_DEVICE_UNCACHED_BIT_AMD)) <> 0 then
		   	aMemRecord.DEVICE_UNCACHED_BIT_AMD := True;
		if (MemProps.memoryTypes[i].propertyFlags and TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_RDMA_CAPABLE_BIT_NV)) <> 0 then
		   	aMemRecord.RDMA_CAPABLE_BIT_NV := True;
	end;
end;

Procedure RegisterDescriptorType(aDescriptorType:TvgDescriptorArrayType);
Begin
  If not assigned(aDescriptorType) then exit;
  if not assigned(DescriptorTypeList)  then
     DescriptorTypeList      := TvgDescriptorTypeList.Create;


  If DescriptorTypeList.IndexOf(aDescriptorType)=-1 then
     DescriptorTypeList.Add(aDescriptorType);
end;


Procedure FillDescriptorNameList(aList:TStringList);
  Var I:Integer;
Begin
  If not assigned(aList) then exit;
  if not assigned(DescriptorTypeList)  then
     DescriptorTypeList      := TvgDescriptorTypeList.Create;

  aList.Clear;

  If DescriptorTypeList.Count=0 then
  Begin
    aList.Add('<NONE>');
    exit;
  End;
  For  I:=0 to DescriptorTypeList.Count-1 do
    aList.Add(DescriptorTypeList.Items[I].GetPropertyName);
End;

