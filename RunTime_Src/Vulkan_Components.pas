Function TvgLinker.SetDisabled:Boolean;
  Var I:Integer;
begin
  Result := False;

  If (fState <> vgcsInactive) then
     VulkanWaitIdle;

  //order is IMPORTANT

  If assigned(fRenderer) and fRenderer.Active then
       fRenderer.Active := False;

  If Length(fFrames)>0 then
  For I:=0 to High(fFrames) do
    fFrames[I].Active:=False;

  If assigned(fSwapChain) and (fSwapChain.Active) then
     fSwapChain.Active:=False;

  If assigned(fSurface) and (fSurface.Active) then
     fSurface.Active:=False;

  If length(fFrames)>0 then
  Begin
    For I:=0 to High(fFrames) do
    Begin
      fFrames[I].SetSubComponent(False);
      RemoveFreeNotification(fFrames[I]);
      FreeAndNil(fFrames[I]);
    end;
    SetLength(fFrames,0);
  End;

  fLinkRenderLock := False;

  Result := Inherited;
  CustomAssert(Result,Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);

//  TriggerWindowRepaint;

end;

Function TvgLinker.SetEnabled:Boolean;
   Var I:Integer;
begin
  Result := Inherited;
  CustomAssert(Result,System.SysUtils.Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);


   Try
    CustomAssert(assigned(fScreenDevice) , 'Vulkan Graphics Device not connected.' ,Self);
    CustomAssert(assigned(fScreenDevice.fVulkanDevice) , 'Vulkan Device not connected.' ,Self);

    CustomAssert(assigned(fScreenDevice.Instance.VulkanInstance), 'Vulkan Instance not Active.',Self);

    CustomAssert(assigned(fSurface) , 'Internal Surface not attached.',Self);

    If not assigned(fSurface.VulkanSurface) then
      fSurface.Active := True;

    CustomAssert(assigned(fSurface.VulkanSurface), 'Vulkan Surface not Active.',Self);

    CustomAssert(assigned(fSwapChain) , 'Internal Swap Chain not created.',Self);

    UpdateWindowSize;
    UpdateConnections;

//order is important

    SetUpCapabilities ;   //must stay here

    fSwapChain.BuildALLImagesColorSpaces;
    fSwapChain.BuildALLPresentationModes;

    fSwapChain.Active:=True;
    CustomAssert(assigned(fSwapChain.VulkanSwapChain) , 'Vulkan Swap Chain not created.',Self);

    UpdateFormats;

    fFrameCount        := MaxFramesInFlight;

    if fFrameCount=0 then
       fFrameCount:=1;

    SetLength(fFrames, fFrameCount);
    For I:=0 to fFrameCount-1 do
    Begin
      fFrames[I]             := TvgFrame.Create(self);
      fFrames[I].Name        := Format('Frame_%d',[I]);
      fFrames[I].SetSubComponent(True);
      FreeNotification(fFrames[I]);
      fFrames[I].Linker      := self;
      fFrames[I].FrameIndex  := I;
      fFrames[I].Active      :=True;
    end;


    if fFrameCount=1 then
    Begin
      fPrepareFrameIndex  :=0;
      fPresentFrameIndex  :=0;
    End else
    Begin
      fPrepareFrameIndex  :=1;      //keep
      fPresentFrameIndex  :=0;      //keep
    End;

    Result := True;  //must stay here

    If assigned(fRenderer) then
    Begin
       fRenderer.Active := True;
       fRenderRequested := True;
    End;

  {$IFDEF TIMINGON}
      fStopWatch  := TStopwatch.Create;
  {$ENDIF}

    If assigned(fOnEnabled) then
         fOnEnabled(self);

    fLinkRenderLock := False;

    TriggerWindowRepaint;

   Except
       On E:Exception do
       Begin
        // Result:=False;
         Raise;
       End;
   End;

end;

