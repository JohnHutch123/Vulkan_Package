Function TvgLogicalDevice.EnableDesigning : Boolean;
  Var B:Boolean;
begin
  Inherited;
  Result := False;

  CustomAssert(assigned(fPhysicalDevice),'Physical Device not connected',Self);

  If not assigned(fPhysicalDevice.VulkanPhysicalDevice) then
  Begin
    fPhysicalDevice.SetDesignState(True)  ;
    B:=False;
  End else
    B:=False;

  CustomAssert(assigned(fPhysicalDevice.VulkanPhysicalDevice),'Physical Device not Active',Self);
  CustomAssert(assigned(fInstance),'Instance not connected',Self);
  CustomAssert(assigned(fInstance.VulkanInstance),'Instance not Active',Self);

  fVulkanDevice       := TpvVulkanDevice.create(fPhysicalDevice.Instance.VulkanInstance,
                                                fPhysicalDevice.VulkanPhysicalDevice,
                                                nil,
                                                fPhysicalDevice.Instance.AllocationManager,
                                                True)  ;

  If Assigned(fVulkanDevice) then
  Begin

    fVulkanDevice.OnBeforeDeviceCreate := OnDeviceCreateEvent; // sets up features

    If assigned(fFeatures) then
      fFeatures.SetDesignState(True) ;   //check

    Result := True;
  end;

  If B then
     fPhysicalDevice.SetDesignState(False)  ;
end;

procedure TvgLogicalDevice.SetDescriptorIndexingON(const Value: Boolean);
begin
  If fDescriptorIndexingON=Value then exit;
  SetActiveState(False) ;

  fDescriptorIndexingON := Value;

  If assigned(fInstance) and not(fInstance.DescriptorIndexing) and fDescriptorIndexingON then
     fInstance.DescriptorIndexing := fDescriptorIndexingON ;

  CustomAssert(fInstance.GetAPIVersion >= VK_API_VERSION_1_2,
               'DescriptorIndexing requires Instance.APIVersion to be at least VG_API_VERSION_1_2', self);
  CustomAssert(assigned(fFeatures),'Features object not assigned',self);


  If assigned(fFeatures) then
  Begin
    fFeatures.fDescriptorIndexing := fDescriptorIndexingON;

    fFeatures.fDescriptorBindingUniformBufferUpdateAfterBind := fDescriptorIndexingON;
    fFeatures.fDescriptorBindingSampledImageUpdateAfterBind := fDescriptorIndexingON;
    fFeatures.fDescriptorBindingStorageImageUpdateAfterBind := fDescriptorIndexingON;
    fFeatures.fDescriptorBindingStorageBufferUpdateAfterBind := fDescriptorIndexingON;
    fFeatures.fDescriptorBindingUniformTexelBufferUpdateAfterBind := fDescriptorIndexingON;
    fFeatures.fDescriptorBindingStorageTexelBufferUpdateAfterBind := fDescriptorIndexingON;
    fFeatures.fDescriptorBindingUpdateUnusedWhilePending := fDescriptorIndexingON;
    fFeatures.fDescriptorBindingPartiallyBound := fDescriptorIndexingON;
    fFeatures.fDescriptorBindingVariableDescriptorCount := fDescriptorIndexingON;
    fFeatures.fDescriptorBindingInlineUniformBlockUpdateAfterBind := fDescriptorIndexingON;

    fFeatures.DescriptorBindingUniformBufferUpdateAfterBind:=fDescriptorIndexingON;
    fFeatures.DescriptorBindingSampledImageUpdateAfterBind:=fDescriptorIndexingON;
    fFeatures.DescriptorBindingStorageImageUpdateAfterBind:=fDescriptorIndexingON;
    fFeatures.DescriptorBindingStorageBufferUpdateAfterBind:=fDescriptorIndexingON;
    fFeatures.DescriptorBindingUniformTexelBufferUpdateAfterBind:=fDescriptorIndexingON;
    fFeatures.DescriptorBindingStorageTexelBufferUpdateAfterBind:=fDescriptorIndexingON;
    fFeatures.DescriptorBindingUpdateUnusedWhilePending:=fDescriptorIndexingON;
    fFeatures.DescriptorBindingPartiallyBound:=fDescriptorIndexingON;
    fFeatures.DescriptorBindingVariableDescriptorCount:=fDescriptorIndexingON;

    fFeatures.RuntimeDescriptorArray := fDescriptorIndexingON;

  End;
end;

