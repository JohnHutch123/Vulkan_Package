  If fFrameCount=0 then
     fFrameCount := 1;

  SetLength(fVulkanSampler,fFrameCount);
  For I:=0 to fFrameCount-1 do
  Begin
    fVulkanSampler[I] :=  TpvVulkanSampler.Create(fDevice.VulkanDevice,
