{ TvgShaderModule }

procedure TvgShaderModule.BuildVulkanSpecializationBlock( out SpecInfo: TVkSpecializationInfo);
var
  MS: TMemoryStream;

  BoolVal: Boolean;
  IntVal: Integer;
  SingleVal: Single;

  Offset: Integer;
  I:Integer;

  SC : TvgShaderSpecialisationItem;
  VulkanBool: Integer;
//  MapEntries : TvgSpecializationConstMap;

  DataSize,BufferSize : Integer;

begin
  If self.fSpecConstCol.count = 0 then exit;

// Initialize memory stream
  MS := TMemoryStream.Create;
  try

    SetLength(fSpecMapEntries , fSpecConstCol.count);
    Offset := 0;

    For I:=0 to fSpecConstCol.count-1 do
    Begin
      fSpecMapEntries[I] := default(TVkSpecializationMapEntry);

      fSpecMapEntries[I].offset     := Offset;

      SC := fSpecConstCol.items[I];
      If assigned(SC) then
      Begin
        fSpecMapEntries[I].constantID := SC.ConstantID;

        Case SC.fSpecialisationType of
          TS_BOOLEAN :Begin
                        DataSize := SizeOf(Integer);

                        fSpecMapEntries[I].size       := DataSize; //Vulkan expects 4 byte bool
                        Inc(Offset,DataSize);

                        BoolVal := SC.fDataBoolean;
                        // Write data with Vulkan alignment (std140-like)
                        // Boolean in Vulkan is 4 bytes
                        VulkanBool := Ord(BoolVal); // Convert Boolean to 4-byte integer
                        MS.WriteBuffer(VulkanBool, DataSize); // 4 bytes
                      end ;
          TS_INTEGER :Begin
                        DataSize := SizeOf(Integer);

                        fSpecMapEntries[I].size       := DataSize;  //Vulkan expects 4 byte bool
                        Inc(Offset,DataSize);

                        IntVal := SC.fDataInteger;
                        // Integer (4 bytes, naturally aligned)
                        MS.WriteBuffer(IntVal,DataSize); // 4 bytes
                      end;
          TS_SINGLE  :Begin
                        DataSize := SizeOf(Single);

                        fSpecMapEntries[I].size       := DataSize;  //Vulkan expects 4 byte bool
                        Inc(Offset,DataSize);

                        SingleVal := SC.fDataSingle;
                        // Single (4 bytes, naturally aligned)
                        MS.WriteBuffer(SingleVal, DataSize); // 4 bytes
                      end;   //may use others later
        End;

      End;


    End;

    // Copy to TBytes for Vulkan
    BufferSize := MS.Size;
    SetLength(fSpecMapBuffer, MS.Size);       //buffer not owned so no need to free
    Move(MS.Memory^, fSpecMapBuffer[0], MS.Size);

  finally
    MS.Free;
  end;

// Set up VkSpecializationInfo
  SpecInfo.mapEntryCount := fSpecConstCol.count;
  SpecInfo.pMapEntries   := @fSpecMapEntries[0];
  SpecInfo.dataSize      := BufferSize;
  SpecInfo.pData         := @fSpecMapBuffer[0];

end;

