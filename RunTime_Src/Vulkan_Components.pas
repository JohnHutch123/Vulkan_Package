procedure TvgLogicalDevice.BuildALLExtensions;
  Var I:Integer;
      B1,B2:Boolean;
begin
  B1:=False;
  B2:=False;

 Try
   CustomAssert(assigned(fInstance) ,'Instance not assigned to Device.',Self);

  If Not assigned(fInstance.VulkanInstance) then //important
  Begin
       fInstance.SetDesignState(True);
       B1:=True;
  End;

  CustomAssert(assigned(fInstance.VulkanInstance) , 'Vulkan Instance creation failed.',Self);

  CustomAssert(assigned(fPhysicalDevice) , 'Physical Device not assigned.',Self);

  If not assigned(fPhysicalDevice.VulkanPhysicalDevice) then
  Begin
      fPhysicalDevice.SetDesignState(True);
      B2:=True;
  End;

  CustomAssert(assigned(fPhysicalDevice.VulkanPhysicalDevice) , 'Physical Device not ACTIVE.',Self);
  CustomAssert(assigned(fPhysicalDevice.VulkanPhysicalDevice.AvailableExtensionNames) , 'Physical Device not ACTIVE.',Self);


  If fPhysicalDevice.VulkanPhysicalDevice.AvailableExtensionNames.Count>0 then
  Begin
    For I:=0 to fPhysicalDevice.VulkanPhysicalDevice.AvailableExtensionNames.Count-1 do
        BuildExtension(@fPhysicalDevice.VulkanPhysicalDevice.AvailableExtensions[I]);
  End;

   If B2 then  fPhysicalDevice.SetDesignState(False);
   If B1 then  fInstance.SetDesignState(False);

 Except
   On E:Exception do
   Begin
     fPhysicalDevice.InvalidateStates;

     fInstance.InvalidateStates;

      Raise;
   End;

 End;
end;

