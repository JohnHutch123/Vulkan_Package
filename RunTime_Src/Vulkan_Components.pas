procedure TvgPixelSampler.SetSampleRadius(const Value: TvgPixelSampleRadius);
begin
  if fSampleRadius = Value then Exit;

  // Disable and re-enable to recreate staging buffer with new size
  if fActive then
  begin
    SetActiveState(False);
    fSampleRadius := Value;

    // Update calculated size
    case fSampleRadius of
      psr_1x1: fSampleSize := 1;
      psr_3x3: fSampleSize := 3;
      psr_5x5: fSampleSize := 5;
      psr_7x7: fSampleSize := 7;
      psr_9x9: fSampleSize := 9;
    end;

    SetActiveState(True);
  end
  else
  begin
    fSampleRadius := Value;
    case fSampleRadius of
      psr_1x1: fSampleSize := 1;
      psr_3x3: fSampleSize := 3;
      psr_5x5: fSampleSize := 5;
      psr_7x7: fSampleSize := 7;
      psr_9x9: fSampleSize := 9;
    end;
  end;

  // Resize the 2D array
  SetLength(fPixelDataArray, fSampleSize, fSampleSize);
end;

