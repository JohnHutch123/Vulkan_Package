procedure TvgInstance.SetUpPortabilityExtensions;
  Var S1    : String;
         E  : TvgExtension;
         I  : Integer;

begin
     if not PortabilityOn then exit;

     If not assigned(fExtensions) or (fExtensions.count=0) then exit;

