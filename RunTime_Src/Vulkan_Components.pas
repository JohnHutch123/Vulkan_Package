procedure TvgPixelSampler.CreateStagingBuffer;
var
  TotalPixels: Integer;
  BufferSize: TvkDeviceSize;
begin
  If not assigned(fSourceBuffer) then exit;

  fPixelInfo := GetVkFormatPixelInfo(fSourceBuffer.fFormat);

  If (fPixelInfo.Kind = pkUnknown) then exit;
  If (fPixelInfo.IsCompressed) then exit;

  CustomAssert(assigned(fSourceBuffer.Linker), 'Linker not connected');
  CustomAssert(assigned(fSourceBuffer.Linker.ScreenDevice), 'Screen Device NOT connected');
  CustomAssert(assigned(fSourceBuffer.Linker.ScreenDevice.VulkanDevice), 'Screen Device NOT ACTIVE');

  // Calculate total buffer size based on sample radius
  TotalPixels := fSampleSize * fSampleSize;
  BufferSize := TvkDeviceSize(fPixelInfo.BytesPerPixel * TotalPixels);

  // Create staging buffer large enough for all pixels
  FStagingBuffer := TpvVulkanBuffer.Create(fSourceBuffer.Linker.ScreenDevice.VulkanDevice,                  //TpvVulkanDevice;
                                          BufferSize,                   //TVkDeviceSize;
                                          TVkBufferUsageFlags(VK_BUFFER_USAGE_TRANSFER_DST_BIT),
                                          TVkSharingMode(VK_SHARING_MODE_EXCLUSIVE),
                                          [],  // queue family indices (empty for exclusive mode)
                                          TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) or
                                          TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_HOST_COHERENT_BIT),
                                          0,                                                  // MemoryPreferredPropertyFlags:TVkMemoryPropertyFlags;
                                          0,                                                  // MemoryAvoidPropertyFlags:TVkMemoryPropertyFlags;
                                          0,//TVkMemoryPropertyFlags(VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT),   // MemoryPreferredNotPropertyFlags:TVkMemoryPropertyFlags;
                                          0,                                                  // MemoryRequiredHeapFlags:TVkMemoryHeapFlags;
                                          0,                                                  // MemoryAvoidHeapFlags:TVkMemoryHeapFlags;
                                          0,                                                  // MemoryPreferredNotHeapFlags:TVkMemoryHeapFlags;
                                          0,                                                  // MemoryPreferredNotHeapFlags:TVkMemoryHeapFlags;
                                          [TpvVulkanBufferFlag.PersistentMapped]) ;          // TpvVulkanBufferFlags


end;

procedure TvgPixelSampler.CopyPixelsToBuffer(X, Y: Integer);
var
  HalfSize: Integer;
  StartX, StartY: Integer;
begin
  CustomAssert(assigned(fCommandBuffer), 'Command Buffer NOT assigned');

  fCommandBuffer.Reset;

  fimageBarrier.image := fSourceBuffer.FrameBufferAttachment.Image.Handle;

  // Calculate starting position (top-left corner of sample area)
  HalfSize := fSampleSize div 2;
  StartX   := X - HalfSize;
  StartY   := Y - HalfSize;

  // Clamp to image boundaries
  if StartX < 0 then StartX := 0;
  if StartY < 0 then StartY := 0;
  if StartX + fSampleSize > Integer(fSourceBuffer.ImageWidth) then
    StartX := Integer(fSourceBuffer.ImageWidth) - fSampleSize;
  if StartY + fSampleSize > Integer(fSourceBuffer.ImageHeight) then
    StartY := Integer(fSourceBuffer.ImageHeight) - fSampleSize;

  // Store actual sampled coordinates
  fLastSampleX := X;
  fLastSampleY := Y;

  // Set up copy region for entire sample area
  fcopyRegion.imageOffset.x := StartX;
  fcopyRegion.imageOffset.y := StartY;
  fcopyRegion.imageExtent.width := fSampleSize;
  fcopyRegion.imageExtent.height := fSampleSize;

  fCommandBuffer.PrepareForRecording;
  fCommandBuffer.BeginRecording;


  // --- Transition TO transfer src ---
  fimageBarrier.image   := fSourceBuffer.FrameBufferAttachment.Image.Handle;
  fCommandBuffer.CmdPipelineBarrier(TVkPipelineStageFlags(VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT),
                                    TVkPipelineStageFlags(VK_PIPELINE_STAGE_TRANSFER_BIT),
                                    0, 0, nil, 0, nil, 1, @fimageBarrier);

  // --- Copy to staging buffer ---
  fCommandBuffer.CmdCopyImageToBuffer( fSourceBuffer.FrameBufferAttachment.Image.Handle,
                                      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
                                      FStagingBuffer.Handle,
                                      1, @fcopyRegion);

  // --- RESTORE: transition back to GENERAL so descriptor stays valid ---
  fRestoreBarrier.image := fSourceBuffer.FrameBufferAttachment.Image.Handle;

  fCommandBuffer.CmdPipelineBarrier( TVkPipelineStageFlags(VK_PIPELINE_STAGE_TRANSFER_BIT),
                                    TVkPipelineStageFlags(VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT),
                                    0, 0, nil, 0, nil, 1, @fRestoreBarrier);

  fCommandBuffer.EndRecording;

  // Execute and wait
  fCommandBuffer.ExecuteCommand(  fSourceBuffer.Linker.ScreenDevice.VulkanDevice.TransferQueue,
                                  TVkPipelineStageFlags(VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT),
                                  nil, nil, true, true);
end;

function TvgPixelSampler.ReadPixelsFromBuffer: Boolean;
var
  Row, Col: Integer;
  PixelOffset: TvkDeviceSize;
  TempPixelData: TvgPixelData;
begin
  Result := False;
  If not fActive then exit;
  If fPixelInfo.IsCompressed then exit;

  // Read all pixels from staging buffer into 2D array
  for Row := 0 to fSampleSize - 1 do
  begin
    for Col := 0 to fSampleSize - 1 do
    begin
      // Calculate offset in staging buffer
      PixelOffset := TvkDeviceSize((Row * fSampleSize + Col) * fPixelInfo.BytesPerPixel);

      // Clear temp pixel data
      FillChar(TempPixelData, SizeOf(TempPixelData), 0);

      // Fetch this pixel's data
      FStagingBuffer.FetchData(
          TempPixelData.Raw[0],
          PixelOffset,
          fPixelInfo.BytesPerPixel);

      // Store in 2D array
      fPixelDataArray[Col, Row] := TempPixelData;
    end;
  end;

  // Also store center pixel in fPixelData for backward compatibility
  if fSampleSize > 0 then
  begin
    fPixelData := fPixelDataArray[fSampleSize div 2, fSampleSize div 2];
  end;

  Result := True;
end;

function TvgPixelSampler.SamplePixel(x, y: Integer): Boolean;
begin
  // Backward compatible single-pixel sampling
  // Just sample center pixel from 1x1 area
  Result := False;
  If not fActive then exit;

  CopyPixelsToBuffer(X, Y);
  Result := ReadPixelsFromBuffer;
end;

function TvgPixelSampler.SamplePixelArea(x, y: Integer): Boolean;
begin
  // New multi-pixel sampling method
  Result := False;
  If not fActive then exit;

  CopyPixelsToBuffer(X, Y);
  Result := ReadPixelsFromBuffer;
end;

function TvgPixelSampler.GetPixelAt(RelX, RelY: Integer): TvgPixelData;
var
  CenterIdx: Integer;
  ArrayX, ArrayY: Integer;
begin
  // RelX, RelY are relative to center pixel
  // e.g., (0, 0) = center, (-1, -1) = top-left, (1, 1) = bottom-right

  FillChar(Result, SizeOf(Result), 0);

  CenterIdx := fSampleSize div 2;
  ArrayX := CenterIdx + RelX;
  ArrayY := CenterIdx + RelY;

  if (ArrayX >= 0) and (ArrayX < fSampleSize) and
     (ArrayY >= 0) and (ArrayY < fSampleSize) then
  begin
    Result := fPixelDataArray[ArrayX, ArrayY];
  end;
end;

function TvgPixelSampler.GetPixelAtAbsolute(X, Y: Integer): TvgPixelData;
var
  RelX, RelY: Integer;
begin
  // Convert absolute coordinates to relative
  RelX := X - fLastSampleX;
  RelY := Y - fLastSampleY;
  Result := GetPixelAt(RelX, RelY);
end;

function TvgPixelSampler.IsValidSampleCoord(RelX, RelY: Integer): Boolean;
var
  CenterIdx: Integer;
  ArrayX, ArrayY: Integer;
begin
  CenterIdx := fSampleSize div 2;
  ArrayX := CenterIdx + RelX;
  ArrayY := CenterIdx + RelY;

  Result := (ArrayX >= 0) and (ArrayX < fSampleSize) and
            (ArrayY >= 0) and (ArrayY < fSampleSize);
end;

procedure TvgPixelSampler.SetDisabled;
begin
  Inherited;

  If assigned(FStagingBuffer) then
    FreeAndNil(FStagingBuffer);

  fCommandBuffer := nil;

  If assigned(fCommandPool) then
  Begin
    fCommandPool.ReleaseAllCommands(True);
    fCommandPool.Active := False;
    FreeAndNil(fCommandPool);
  end;

  fActive := False;
end;

procedure TvgPixelSampler.SetEnabled;
begin
  Inherited;
  fActive := False;

  CustomAssert(assigned(fSourceBuffer), 'Source Buffer NOT assigned');
 // CustomAssert(assigned(fSourceBuffer.Linker), 'Linker NOT assigned to Source Buffer');
//  CustomAssert((fSourceBuffer.Linker.Vulkan), 'Linker NOT Active');

  // Ensure sample size is calculated
  case fSampleRadius of
    psr_1x1: fSampleSize := 1;
    psr_3x3: fSampleSize := 3;
    psr_5x5: fSampleSize := 5;
    psr_7x7: fSampleSize := 7;
    psr_9x9: fSampleSize := 9;
  end;

  // Allocate 2D array
  SetLength(fPixelDataArray, fSampleSize, fSampleSize);

  CreateStagingBuffer;

  fCommandPool                  := TvgCommandBufferPool.Create(nil);
  fCommandPool.Device           := fSourceBuffer.Linker.ScreenDevice;
  fCommandPool.QueueFamilyType  := VGT_TRANSFER;
  fCommandPool.QueueCreateFlags := [CP_RESET_COMMAND_BUFFER];
  fCommandPool.SetUpBufferArrays(1);//ok
  fCommandPool.Active           := True;

  If fCommandPool.Active then
  Begin
    fCommandBuffer := fCommandPool.AcquireUploadCommand(0);//  RequestCommand(0, CB_PRIMARY,  []);
    If assigned(fCommandBuffer) then
      fCommandBuffer.Active := True;
  End;

  // Configure oldLayout based on source buffer
  if Assigned(fSourceBuffer) then
  begin
    fimageBarrier.oldLayout   := fSourceBuffer.fFinalLayout;

    if (fimageBarrier.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED) or
       (fimageBarrier.oldLayout = VK_IMAGE_LAYOUT_PREINITIALIZED) then
      fimageBarrier.oldLayout := VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
  end;

// Mirror the restore layout from the source buffer's expected resting layout
  fRestoreBarrier.newLayout := fimageBarrier.oldLayout;  // = fSourceBuffer.fFinalLayout = GENERAL

  fActive := True;
end;

