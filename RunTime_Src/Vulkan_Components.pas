Function TvgBaseRenderEngine.SetEnabled : Boolean;
var
  Established : TvgPhysicalDevice;
 // EC : TvkUint32;
begin
  Result := Inherited;
  CustomAssert(Result,Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);

  // ... existing asserts ...
  CustomAssert(Assigned(fLinker), 'Window Link not assigned', Self);
  CustomAssert(Assigned(fLinker.SwapChain), 'Swap Chain not assigned', Self);
  CustomAssert(Assigned(fRenderPass), 'RenderPass NOT created', Self);

  // Device consistency: verify this renderer matches the scene's device.
  if Assigned(fBaseScene) then
  begin
    Established := TvgBaseScene(fBaseScene).GetEstablishedPhysicalDevice;
    if Assigned(Established) then
      CustomAssert(GetPhysicalDevice = Established, 'TvgRenderEngine: device mismatch against scene''s established device.',  Self);
  end;

 // BuildAndSetUpGlobalResources;  this needs to be fixed.   should happen at Create NOT enabled;

  If assigned(fRenderPass) then
     fRenderPass.Active := True;

  If fRenderWorkerCount=0 then
      fRenderWorkerCount := 1;

  If assigned(fGlobalRes) then
  Begin
      fGlobalRes.Linker := fLinker;
      fGlobalRes.active := True;

   //   fGlobalRes.active := False;
   //   fGlobalRes.active := True;
  End;

  Result := True;    //stay here

  BuildAndSetUpWorkers;
  //override to create set of workers

  If assigned(fBaseScene) then
  Begin
     fBaseScene.BuildGraphicPipelinesForRenderer(self);        //important as builds and connects graphic pipelines
     ActivateGraphicPipeLines;

     If Not fBaseScene.active then
        fBaseScene.Active := True;
  end;

end;


procedure TvgBaseRenderEngine.SetLinker(const Value: TvgLinker);
  Var OldLinker:TvgLinker;
begin
  If fLinker =Value then exit;
  SetActiveState(False);

  OldLinker := fLinker;
  If assigned(OldLinker) then
  Begin
     OldLinker.RemoveFreeNotification(self);
     fLinker := Nil;
     If OldLinker.fRenderer = Self then
       OldLinker.fRenderer := Nil;
  End;

  If assigned(fRenderPass) then
    fRenderPass.SetLinker( Nil);

  If assigned(fGlobalRes) then
    fGlobalRes.SetLinker(Nil);

  fLinker := Value;

  If assigned(fLinker) then
  Begin
    fLinker.FreeNotification(self);

    If fLinker.fRenderer <> Self then
      fLinker.fRenderer := self;
    fLinker.UseThread := False;

    If assigned(fRenderPass) then
      fRenderPass.SetLinker(fLinker);

    If assigned(fLinker.ScreenDevice) and assigned(fGlobalRes)  then
      fGlobalRes.SetLinker(fLinker);

  End;

end;

