procedure TvgBaseObjectStore.SetDisabled;
var
  Pair     : TPair<TvgGraphicPipeRecord, TvgGraphicPipeline>;
  ToRemove : TList<TvgGraphicPipeRecord>;
begin
  fActive := False;

  CustomAssert(Assigned(fGraphicPipes), 'Graphic Pipes Dictionary NOT assigned');
  if fGraphicPipes.Count = 0 then exit;

  ToRemove := TList<TvgGraphicPipeRecord>.Create;
  try
    for Pair in fGraphicPipes do
    begin
      if Assigned(Pair.Key.SubPass) and Assigned(Pair.Value) then
        Pair.Key.SubPass.RemoveGraphicPipe(Pair.Value);   // SubPass first

      if Assigned(Pair.Value) and Pair.Value.Active then
        Pair.Value.Active := False;                        // deactivate VkHandles

      ToRemove.Add(Pair.Key);
    end;
    for var R in ToRemove do
      fGraphicPipes.Remove(R);   // doOwnsValues frees GP safely now
  finally
    ToRemove.Free;
  end;

end;

