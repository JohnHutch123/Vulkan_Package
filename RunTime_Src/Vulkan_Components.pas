procedure TvgInstance.SetValidation(const Value: Boolean);
begin
  If fValidation=Value then exit;

  InvalidateStates;

  fValidation:=Value;

end;

procedure TvgInstance.SetVulkanAPIVersion(const Value: TvgAPI_Version);
begin
  If Value=fAPIVersion then exit;
  InvalidateStates;
  ClearAllExtensionsAndlayers;

  fAPIVersion := Value;

end;

procedure TvgInstance.SetDescriptorIndexing(const Value: Boolean);
begin
  If Value = fDescriptorIndexing then exit;

  InvalidateStates;
  ClearAllExtensionsAndlayers;
  SetActiveState(False) ;

  fDescriptorIndexing := Value;

  If fAPIVersion<VG_API_VERSION_1_2 then
     fAPIVersion := VG_API_VERSION_1_2;

end;

procedure TvgInstance.SetDynamicRendering(const Value: Boolean);
begin
  If Value = fDynamicRendering then exit;

  InvalidateStates;
  ClearAllExtensionsAndlayers;
  SetActiveState(False) ;

  fDynamicRendering := Value;
end;

Function TvgInstance.SetDisabled:Boolean;
  Var I:Integer;
begin
  Result := False;

  //keep this order
  DisableDevices;     //disable lower devices

  For I:=0 to fLayers.count-1 do
     TvgLayer(fLayers.Items[I]).fEnabled:=False;

  For I:=0 to fExtensions.count-1 do
     TvgExtension(fExtensions.Items[I]).fEnabled:=False;


  fPhysicalDeviceList.Clear;

  If assigned(fVulkanInstance) then
  Begin
     fVulkanInstance.destroy;
     fVulkanInstance:=nil;
  End;

  If assigned(fAllocationManager ) then
     FreeAndNil(fAllocationManager) ;

  Result := Inherited;
  CustomAssert(Result,Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);

end;

Function TvgInstance.EnableDesigning:Boolean;

begin
  Inherited;

  fPhysicalDeviceList.Clear;

  If assigned(fVulkanInstance) then
  Begin
     fVulkanInstance.Free ;
     fVulkanInstance:=nil;
  End;

 Try
  SetUpMemoryAllocation;

  fVulkanInstance:= TpvVulkanInstance.create(fApplicationName,
                                             fpplicationVersion,
                                             fEngineName,
                                             fengineVersion,
                                             GetAPIVersion,
                                             False,
                                             fAllocationManager);
  VulkanDllsLoaded := True;

    If assigned(fVulkanInstance) then
    Begin

      fVulkanInstance.Initialize;
      SetAPIVersion(fVulkanInstance.APIVersion);

      SetUpPhysicalDevices; //needed by Logical Devices Must stay here
    End;

    CustomAssert( assigned(fVulkanInstance) , 'Vulkan Instance creation failed.' ,Self);

    Result := True;
  Except

     On E: EpvVulkanException do
     Begin
        If assigned(fVulkanInstance) then
           FreeAndNil(fVulkanInstance);
      //  Result:=False;
        Raise;
     End;
  End;


end;

Function TvgInstance.SetEnabled:Boolean;
  //Var I:Integer;
begin
  Result := Inherited;
  CustomAssert(Result,System.SysUtils.Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);

  //need to start from scratch
    SetUpMemoryAllocation;

    fVulkanInstance:= TpvVulkanInstance.create(fApplicationName,
                                                   fpplicationVersion,
                                                   fEngineName,
                                                   fengineVersion,
                                                   GetAPIVersion,
                                                   false,  //must be false
                                                   fAllocationManager);
    VulkanDllsLoaded := True;

    CustomAssert( assigned(fVulkanInstance) , 'Vulkan Instance creation failed.',Self);

    SetAPIVersion(fVulkanInstance.APIVersion);

    CompleteSetUp;




    fVulkanInstance.Initialize;  //may fail if using local allocation manager NOT SURE WHY.  The recall fixes the issue NOT GOOD

    SetUpPhysicalDevices;  //must stay here

    EnableDevices;

    Result := True ;

end;

