Function FileExistsInVariousLocations(aFileName:String; const ShaderPath:String = ''; SearchSubFolders:Boolean = False): String;
var
  Paths: TArray<string>;
  Path, S, FName: string;


  Function  FindFileInDirectoryAndSubfolders(const RootDir, FileName : String):String;
    Var  Files : TArray<String>;
  Begin
      if not TDirectory.Exists(RootDir) then
        Exit('');

      // Search recursively
      Files := TDirectory.GetFiles(RootDir, FileName, TSearchOption.soAllDirectories);

      if Length(Files) > 0 then
        Result := Files[0] // Return first match
      else
        Result := '';
end;

begin
    Result := '';
    S := Trim(aFileName);

    If (S='') then exit;

    If ShaderPath<>'' then
      Paths := [ Trim(ShaderPath),
                 ExtractFilePath(ParamStr(0)),
                 TPath.GetTempPath,
                 GetEnvironmentVariable('PROGRAMDATA')  + ShaderFolderProgramData,
                 GetEnvironmentVariable('PROGRAMFILES') + ShaderFolderProgramFiles,
                 TPath.GetDocumentsPath + ShaderFolderDocuments ]

  else
      Paths := [
                 ExtractFilePath(ParamStr(0)),
                 TPath.GetTempPath,
                 GetEnvironmentVariable('PROGRAMDATA')  + ShaderFolderProgramData,
                 GetEnvironmentVariable('PROGRAMFILES') + ShaderFolderProgramFiles,
                 TPath.GetDocumentsPath + ShaderFolderDocuments ];

  for Path in Paths do
  begin
    If SearchSubFolders then
    Begin
      FName := FindFileInDirectoryAndSubfolders(Path, S);
      if (FName<>'') and TFile.Exists(FName) then
        Exit(FName);
    End else
    Begin
      FName := TPath.Combine(Path, S);
      if TFile.Exists(FName) then
        Exit(FName);
    End;
  end;

end;

Function TvgShaderModule.SetEnabled : Boolean;
  Var FileStream : TFileStream;
      SHInfo     : TVkShaderModuleCreateInfo ;
      FileS      : String;

begin
  Result := Inherited;
  CustomAssert(Result,System.SysUtils.Format('%S : Fail to set State %d',[self.ClassName, ord(Result)]),self);

  fShaderModuleHandle := VK_NULL_HANDLE;


  If (fFileName='') then exit;
  FileS := fFileName;                       //use file name

  FileS := FileExistsInVariousLocations(fFileName, ShaderFolderPath, True);  //search all likely places for the file

  If (FileS='' ) or not FileExists(FileS) then exit;


  FileStream:=TFileStream.Create(FileS,fmOpenRead or fmShareDenyWrite);
    try

     fData        := nil;
     fDataAligned := nil;

     fDataSize := FileStream.Size;
     if (fDataSize and 3)<>0 then
        inc(fDataSize,4-(fDataSize and 3));

      GetMem(fData,fDataSize+4);
      fDataAligned:=fData;
      if (TvkPtrUInt(fDataAligned) and 3)<>0 then
          inc(TvkPtrUint(fDataAligned),4-(TvkPtrUint(fDataAligned) and 3));

       if FileStream.Seek(0,soBeginning)<>0 then
        raise EInOutError.Create('Stream seek error');

       if FileStream.Read(fData^,FileStream.Size)<>FileStream.Size then
        raise EInOutError.Create('Stream read error');

       FillChar(SHInfo,SizeOf(SHInfo),#0);
       SHInfo.sType  := VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
       SHInfo.codeSize := fDataSize;
       SHInfo.pCode    := fData;

       VulkanCheckResult(fDevice.VulkanDevice.Commands.CreateShaderModule(fDevice.VulkanDevice.Handle,
                                                                          @SHInfo,
                                                                          Nil,
                                                                          @fShaderModuleHandle));
       Result := (fShaderModuleHandle<>VK_NULL_HANDLE);

     finally
       FileStream.Free;
     end;

end;

procedure TvgShaderModule.SetFileName(const Value: String);
  Var TempS:String;
begin
  If CompareText(Value, fFileName)<>0 then
     SetActiveState(False);

  TempS := '';
  TempS := FileExistsInVariousLocations(Value, ShaderFolderPath, True);  //search all likely places for the file

  If TempS<>'' then
  Begin
     fFileName := Value;
     exit;
  End;

  If (TempS<>'') and (csDesigning in ComponentState) then
     CustomAssert( (TempS<>''),'Filename NOT found',self);


end;

