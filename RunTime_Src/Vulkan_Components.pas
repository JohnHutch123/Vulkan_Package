function TvgDescriptorData.GetGLSLArraySuffix: String;
begin
// A single TvgDescriptorData slot represents one scalar/struct element,
  // not an embedded array - no suffix by default. Override in a subclass
  // if a single descriptor slot represents an array-of-T member itself.
  Result := '';

end;

function TvgDescriptorData.GetGLSLDeclarationString( const aDescriptorIndex: TvkUint32): String;
begin
// Generic "<type> <name>_<index><suffix>;" struct-member-style line.
  // GetGLSLBaseTypeName is abstract, so this will only resolve for
  // concrete classes that override it (see Part B).
  Result := GetGLSLBaseTypeName + ' ' +
            GetGLSLVariableName + '_' + IntToStr(aDescriptorIndex) +
            GetGLSLArraySuffix + ';';

end;

function TvgDescriptorData.GetGLSLVariableName: String;
begin
// Default: use the shader-facing name from the owning DescriptorItem
  // (the name the .Name published property / collection item carries),
  // falling back to the class name if no item is connected yet.
  If assigned(fDescriptor) and assigned(fDescriptor.DescriptorItem) then
    Result := fDescriptor.DescriptorItem.Name
  else
    Result := ClassName;
end;

