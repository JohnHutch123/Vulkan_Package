procedure TvgLinker.SwapChainRebuild;
  Var I:Integer;

begin
  fSwapChainRebuildNeeded := False;

  fLinkRenderLock := False;

  Try
 //Shut Down
    If (fState <>vgcsInactive) then
       VulkanWaitIdle;

    //order is IMPORTANT

    If assigned(fRenderer) and (fRenderer.State <>vgcsInactive) then
         fRenderer.ApplyState(vgcsInactive);

    If Length(fFrames)>0 then
    For I:=0 to High(fFrames) do
      fFrames[I].Active := False;

    If assigned(fSwapChain) and (fSwapChain.State <>vgcsInactive) then
       fSwapChain.ApplyState(vgcsInactive);

    If self.fNeedSurfaceRebuild and  assigned(fSurface) and (fSurface.State <>vgcsInactive) then
       fSurface.ApplyState(vgcsInactive);

    If length(fFrames)>0 then
    Begin
      For I:=0 to High(fFrames) do
      Begin
        fFrames[I].SetSubComponent(False);
        RemoveFreeNotification(fFrames[I]);
        FreeAndNil(fFrames[I]);
      end;
      SetLength(fFrames,0);
    End;

  //rebuild swap chain
    fSwapChain.RecreateSwapChain;

 //REBUILD
    If fSurface.state=vgcsInactive then
       fSurface.ApplyState(vgcsActive);

    UpdateWindowSize;
    UpdateConnections;

//order is important

    SetUpCapabilities ;   //must stay here

    fSwapChain.BuildALLImagesColorSpaces;
    fSwapChain.BuildALLPresentationModes;

    fSwapChain.ApplyState(vgcsActive);
    CustomAssert(assigned(fSwapChain.VulkanSwapChain) , 'Vulkan Swap Chain not created.',Self);

    UpdateFormats;

    if fFrameCount=0 then
       fFrameCount:=1;

    SetLength(fFrames, fFrameCount);
    For I:=0 to fFrameCount-1 do
    Begin
      fFrames[I]             := TvgFrame.Create(self);
      fFrames[I].Name        := Format('Frame_%d',[I]);
      fFrames[I].SetSubComponent(True);
      FreeNotification(fFrames[I]);
      fFrames[I].Linker      := self;
      fFrames[I].FrameIndex  := I;
      fFrames[I].ApplyState(vgcsActive);
    end;

    if fFrameCount=1 then
    Begin
      fPrepareFrameIndex  :=0;
      fPresentFrameIndex  :=0;
    End else
    Begin
      fPrepareFrameIndex  :=1;      //keep
      fPresentFrameIndex  :=0;      //keep
    End;


    If assigned(fRenderer) then
    Begin
       fRenderer.ApplyState(vgcsActive);
       fRenderRequested := True;
    End;

  Finally
    fLinkRenderLock := False;
  End;

  FlagALLFrameRebuild;
  TriggerWindowRepaint;
end;

procedure TvgLinker.TriggerWindowRepaint;
begin
  if (csDestroying in ComponentState) then exit;
 // if (csFreeNotification in ComponentState) then exit;

  if fStateChanging then
  Begin
    fRenderRequested := True;
    exit;
  End;

  if (Length(fFrames)=0) then exit;
  if Not assigned(fFrames[fPresentFrameIndex]) then exit;

  If Not fRenderer.Active   then exit;

 if fLinkRenderLock then
 Begin
    fRenderRequested := True;
    exit;
 end else

    Case fRenderTarget of
      RT_NONE   :;
      RT_SCREEN :Begin
                   LinkerStartPrepare ;
                 End;
      RT_FRAME  :Begin
                    if     (fRenderRequested = False) or
                           (fFrames[fPresentFrameIndex].fRenderNeeded = False) then
                    Begin
                       if fMsgON and assigned(fMsgList) then
                          fMsgList.Clear;

                       VulkanPaint_Present;

                       if fMsgON and assigned(fMsgEvent) then
                                   fMsgEvent(fMsgList);
                    end else
                       LinkerStartPrepare ;
                 End;

    End;
end;

function TvgLinker.VulkanPaint_Cancel: Boolean;
begin
  Result          := True;
  fLinkRenderLock := False;

  AdvanceToNextFrames;

end;

procedure TvgLinker.VulkanPaint_Present;
begin

  If fSwapChainRebuildNeeded then
  Begin
    SwapChainRebuild;
    exit;
  End;


  fFrames[fPresentFrameIndex].PresentFrame;      //Present the current Frame

  {$IFDEF TIMINGON}
    if fMsgON then
      AddMsgToList(Format('Present Frame Time : %d milliseconds',[fFrames[fPresentFrameIndex].fPresentFrameTime])) ;
  {$ENDIF}

end;

Procedure TvgLinker.LinkerFinishPrepare;
begin

  if not fLinkRenderLock  then exit;
  fLinkRenderLock := False;

  AdvanceToNextFrames;      //switch to the Next Frame

  {$IFDEF TIMINGON}
     fStopWatch.Stop;
     fprepareFrameTime := fStopWatch.ElapsedMilliseconds;

    if fMsgON then
        AddMsgToList(Format('Prepare Frame Time : %d milliseconds',[fprepareFrameTime])) ;

  {$ENDIF}

  VulkanPaint_Present;

  if fMsgON and assigned(fMsgEvent) then
              fMsgEvent(fMsgList);

  If fRenderThreaded and fRenderRequested then  //start loop again if requested
  Begin
    LinkerStartPrepare;
    //exit;
  End;

  fRenderRequested := False;

end;

Procedure TvgLinker.LinkerStartPrepare;
begin
  if (csDestroying in ComponentState) then exit;

  if fLinkRenderLock then
  Begin
    fRenderRequested := True;
    exit;
  End;

  If fSwapChainRebuildNeeded then
  Begin
    SwapChainRebuild;
    exit;
  End;

  If fState = vgcsInactive then exit;

  If Length(fFrames)=0 then exit;

  fLinkRenderLock      := True;  //stay here
  fMsgList.Clear;

  {$IFDEF TIMINGON}
    fStopWatch.Reset;
    fStopWatch.Start;
  {$ENDIF}

  fFrames[fPrepareFrameIndex].StartFramePrepare;     //prepare the Next Frame

end;

procedure TvgLinker.VulkanWaitIdle;
begin
  If fState = vgcsInactive then exit;

  CustomAssert( assigned(fScreenDevice) , 'Screen Device not created',Self);

  fScreenDevice.WaitIdle;
end;

procedure TvgLinker.FlagALLFrameRebuild;
  Var I:Integer;
begin
  fRenderRequested := True;

  if fFrameCount=0 then exit;

  For I:=0 to Length(fFrames)-1 do
     fFrames[I].fRenderNeeded := True;
end;

procedure TvgLinker.FlagSwapChainRebuild;
begin
  fSwapChainRebuildNeeded := True;

  FlagALLFrameRebuild;
end;

