procedure TvgRenderPass.CheckDepthFormatSupport(Tiling:TVkImageTiling);
  Var Props :  TVkFormatProperties ;
      PhyDev : TvgPhysicalDevice;

  Procedure UpdateFormat;
  Begin
    fDepthStencilFormat := PhyDev.VulkanPhysicalDevice.GetBestSupportedDepthFormat(fStencilBufOn);
  End;

begin
  CustomAssert(Assigned(fLinker),'TvgLinker not assigned',Self);
  CustomAssert(Assigned(fLinker.ScreenDevice),'Screen Device not assigned',Self);
  CustomAssert(Assigned(fLinker.ScreenDevice.PhysicalDevice),'Physical Device not assigned',Self);
  CustomAssert(Assigned(fLinker.ScreenDevice.PhysicalDevice.VulkanPhysicalDevice),'Vulkan Physical Device not assigned',Self);

  PhyDev :=  fLinker.ScreenDevice.PhysicalDevice;

  PhyDev.Instance.VulkanInstance.Commands.GetPhysicalDeviceFormatProperties(PhyDev.VulkanPhysicalDevice.Handle,
                                                       fDepthStencilFormat,
                                                       @Props);

  If (Tiling = VK_IMAGE_TILING_LINEAR) then
  Begin
    If ((Props.linearTilingFeatures and TVkFormatFeatureFlags(VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT))<>0)  then
       exit
    else
      UpdateFormat;
  end else
  If (Tiling = VK_IMAGE_TILING_OPTIMAL) then
  Begin
    If ((Props.optimalTilingFeatures and ORD(VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT)) = ORD(VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT))  then
       exit
    else
      UpdateFormat;
  End;

end;

