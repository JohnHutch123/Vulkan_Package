package VulkanPkgR280;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl;

contains
  Vulkan_Components in '..\RunTime_Src\Vulkan_Components.pas',
  Vulkan_Components_Lookups in '..\RunTime_Src\Vulkan_Components_Lookups.pas',
  Vulkan in '..\Vulkan\src\Vulkan.pas',
  PasVulkan.Types in '..\Vulkan\src\PasVulkan.Types.pas',
  PasVulkan.Math in '..\Vulkan\src\PasVulkan.Math.pas',
  PasVulkan.Image.TGA in '..\Vulkan\src\PasVulkan.Image.TGA.pas',
  PasVulkan.Image.BMP in '..\Vulkan\src\PasVulkan.Image.BMP.pas',
  PasVulkan.SignedDistanceField2D in '..\Vulkan\src\PasVulkan.SignedDistanceField2D.pas',
  PasVulkan.Image.PNG in '..\Vulkan\src\PasVulkan.Image.PNG.pas',
  PasVulkan.ConvexHullGenerator2D in '..\Vulkan\src\PasVulkan.ConvexHullGenerator2D.pas',
  PasVulkan.XML in '..\Vulkan\src\PasVulkan.XML.pas',
  PasVulkan.Compression.Deflate in '..\Vulkan\src\PasVulkan.Compression.Deflate.pas',
  PasVulkan.CPU.Info in '..\Vulkan\src\PasVulkan.CPU.Info.pas',
  PasVulkan.Image.JPEG in '..\Vulkan\src\PasVulkan.Image.JPEG.pas',
  PasVulkan.Archive.ZIP in '..\Vulkan\src\PasVulkan.Archive.ZIP.pas',
  PasVulkan.Collections in '..\Vulkan\src\PasVulkan.Collections.pas',
  PasVulkan.Sprites in '..\Vulkan\src\PasVulkan.Sprites.pas',
  PasVulkan.Streams in '..\Vulkan\src\PasVulkan.Streams.pas',
  PasVulkan.TrueTypeFont in '..\Vulkan\src\PasVulkan.TrueTypeFont.pas',
  PasVulkan.Utils in '..\Vulkan\src\PasVulkan.Utils.pas',
  PasVulkan.VectorPath in '..\Vulkan\src\PasVulkan.VectorPath.pas',
  PasVulkan.Framework in '..\Vulkan\src\PasVulkan.Framework.pas',
  PasDblStrUtils in '..\..\Vulkan\externals\pasdblstrutils\src\PasDblStrUtils.pas',
  PasVulkan.Image.QOI in '..\..\Vulkan\src\PasVulkan.Image.QOI.pas',
  PasVulkan.Image.Utils in '..\..\Vulkan\src\PasVulkan.Image.Utils.pas',
  PasVulkan.NVIDIA.AfterMath in '..\..\Vulkan\src\PasVulkan.NVIDIA.AfterMath.pas',
  Vulkan_Components_Nodes in '..\RunTime_Src\Vulkan_Components_Nodes.pas',
  Vulkan_Components_Resources in '..\RunTime_Src\Vulkan_Components_Resources.pas',
  Vulkan_Assert in '..\RunTime_Src\Vulkan_Assert.pas',
  Vulkan_Components_Scene in '..\RunTime_Src\Vulkan_Components_Scene.pas';

end.



